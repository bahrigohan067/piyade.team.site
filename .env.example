# ==============================================================================
# PIYADE TEAM | WEB SİTESİ ÇEVRE DEĞİŞKENLERİ (.ENV)
# ==============================================================================

# Sunucu Portu (Railway otomatik olarak PORT değişkenini atar, yerelde 3001 kullanılır)
PORT=3001

# Çalışma Ortamı (development | production)
NODE_ENV=development

# Sitenin Yayın Adresi (Sonunda eğik çizgi "/" olmadan giriniz)
# Yerelde: http://localhost:3001
# Railway'de: https://piyade-site.up.railway.app
BASE_URL=http://localhost:3001

# Bot REST API Adresi (Sonunda eğik çizgi "/" olmadan giriniz)
# Yerelde: http://localhost:3000
# Railway'de: https://piyade-bot.up.railway.app
BOT_API_URL=http://localhost:3000

# Bot REST API Güvenlik Anahtarı (Botun .env dosyasındaki API_SECRET ile BİREBİR AYNI olmalıdır)
API_SECRET=super_secret_piyade_bot_api_key_2026

# Discord Developer Portal Uygulama Bilgileri
# https://discord.com/developers/applications adresinden temin ediniz
DISCORD_CLIENT_ID=123456789012345678
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Express Oturum (Session) Şifreleme Anahtarı (En az 16 karakterli rastgele karmaşık bir metin giriniz)
SESSION_SECRET=piyade_session_secret_change_me_in_production_key_123456

# [Opsiyonel] Railway Volume Bağlantı Yolu (Railway Volume eklendiğinde otomatik atanır; yoksa yerel .sessions kullanılır)
# RAILWAY_VOLUME_MOUNT_PATH=/data

# [Opsiyonel] Google Search Console Site Doğrulama Kodu (Tanımlanırsa <meta name="google-site-verification" content="..."> basılır)
# GOOGLE_SITE_VERIFICATION=

# [Opsiyonel] Resmi Topluluk & Sosyal Medya Bağlantıları (JSON-LD "sameAs" ve alt bilgi linkleri için)
# DISCORD_INVITE_URL=https://discord.gg/sizin_davet_kodunuz
# ROBLOX_GROUP_URL=https://www.roblox.com/communities/sizin_grup_idniz
