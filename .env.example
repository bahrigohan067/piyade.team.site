# ==============================================================================
# PIYADE | WEB SİTESİ ÇEVRE DEĞİŞKENLERİ (.ENV)
# ==============================================================================

# Sunucu Portu (Railway otomatik olarak PORT değişkenini atar, yerelde 3001 kullanılır)
PORT=3001

# Çalışma Ortamı (development | production)
NODE_ENV=development

# Sitenin Yayın Adresi (Sonunda eğik çizgi "/" olmadan giriniz)
# Yerelde: http://localhost:3001
# Railway'de: https://piyade-site.up.railway.app
BASE_URL=http://localhost:3001

# [Opsiyonel] Marka Adı (Tanımlanmazsa varsayılan olarak "Piyade" kullanılır)
# SITE_NAME=Piyade

# Bot REST API Adresi (Sonunda eğik çizgi "/" olmadan giriniz)
# Yerelde: http://localhost:3000
# Railway'de: https://piyade-bot.up.railway.app
BOT_API_URL=http://localhost:3000

# Bot REST API Güvenlik Anahtarı (Botun .env dosyasındaki API_SECRET ile BİREBİR AYNI olmalıdır)
API_SECRET=super_secret_piyade_bot_api_key_2026

# Discord Developer Portal Uygulama Bilgileri
# https://discord.com/developers/applications adresinden temin ediniz
DISCORD_CLIENT_ID=123456789012345678
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Express Oturum (Session) Şifreleme Anahtarı (En az 16 karakterli rastgele karmaşık bir metin giriniz)
SESSION_SECRET=piyade_session_secret_change_me_in_production_key_123456

# [Opsiyonel] Railway Volume Bağlantı Yolu (Railway Volume eklendiğinde otomatik atanır; yoksa yerel .sessions kullanılır)
# RAILWAY_VOLUME_MOUNT_PATH=/data

# [Opsiyonel] Google Search Console Site Doğrulama Kodu (Tanımlanırsa <meta name="google-site-verification" content="..."> basılır)
# GOOGLE_SITE_VERIFICATION=

# [Opsiyonel] Resmi Topluluk & Sosyal Medya Bağlantıları (Anasayfa Discord butonu, JSON-LD "sameAs" ve alt bilgi linkleri için)
# DISCORD_INVITE_URL=https://discord.gg/sizin_davet_kodunuz
# ROBLOX_GROUP_URL=https://www.roblox.com/communities/sizin_grup_idniz

# [Opsiyonel - İleriye Hazırlık] Oyun Bazlı Discord Rol ID'leri (config/games.config.js iskeleti için)
# GAME_ROLE_ROBLOX=
# GAME_ROLE_ZULA=
# GAME_ROLE_MINECRAFT=
# GAME_ROLE_CS2=

# [Yasal Sayfalar, KVKK ve Künye Bilgileri — Boş bırakılan alanlar "[Doldurulacak: ...]" görünür]
# LEGAL_CONTROLLER_NAME=
# LEGAL_ADDRESS=
# LEGAL_EMAIL=
# LEGAL_PHONE=
# LEGAL_KEP=
# LEGAL_REGISTRY_NO=
# LEGAL_TAX_NO=
# LEGAL_VERBIS_STATUS=
# Hukuki inceleme tamamlandığında true yapın (varsayılan false: üstte taslak uyarısı gösterir)
# LEGAL_REVIEWED=false
# LEGAL_KVKK_RETENTION_DAYS=1095
# LEGAL_REPORT_RETENTION_DAYS=365

# [Opsiyonel] Google ile Devam Et (OAuth2 / OIDC — Tanımlı değilse Google düğmesi gizlenir)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Yeni Google üye sohbet dosya/bağlantı kısıtlama süresi (saat, varsayılan 24)
# NEW_MEMBER_RESTRICTION_HOURS=24

# [Opsiyonel] Sohbet Özellik Bayrakları ve Grup Yöneticileri
# CHAT_ENABLED=false
# Google site üyelerinin sohbete erişimi (varsayılan true)
# CHAT_GOOGLE_MEMBERS_ENABLED=true
# Genel Sohbet grubu yöneticilerinin Discord ID listesi (virgül, noktalı virgül, boşluk veya yeni satırla ayrılabilir; tırnak/görünmez boşluklar otomatik temizlenir)
# Not: Railway Variables'ta değişken adı büyük-küçük harf duyarlıdır. Değişiklikten sonra redeploy + çıkış/tekrar giriş yapın.
# CHAT_GROUP_ADMIN_DISCORD_IDS=

# [Opsiyonel] Site (Google) Üyeleri Uyarı & Yaptırım Saklama Süreleri (Gün)
# WARNING_AMNESTY_DAYS=30
# WARNING_RECORD_RETENTION_DAYS=365
# WARNING_EVIDENCE_RETENTION_DAYS=180
# WARNING_AUDIT_RETENTION_DAYS=365

# [Opsiyonel] Sunucularımız (/sunucular) Discord Davet Önbellek Tazeleme Aralığı (Dakika, varsayılan 10)
# SERVERS_REFRESH_MIN=10
