<%- include('../layouts/header') %>

<div style="max-width: 600px; margin: 4rem auto; text-align: center;">
  <div class="card" style="padding: 3rem 2rem; border-top: 4px solid var(--color-danger);">
    <div style="font-size: 3.5rem; margin-bottom: 1rem;">🚫</div>
    <span class="badge badge-danger" style="margin-bottom: 0.75rem;">Yetkisiz Erişim (403)</span>
    <h1 style="font-size: 1.85rem; margin-bottom: 0.75rem;">Erişim İzniniz Yok</h1>
    <p style="color: var(--text-secondary); margin-bottom: 1.75rem;">
      <%= typeof message !== 'undefined' ? message : 'Bu alana erişmek için gerekli yetki veya role sahip değilsiniz.' %>
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center;">
      <a href="/" class="btn btn-primary">
        <span>🏠 Anasayfa</span>
      </a>
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <a href="/profil" class="btn btn-secondary">
          <span>👤 Profilim</span>
        </a>
      <% } else { %>
        <a href="/auth/discord" class="btn btn-discord">
          <span>🎮 Giriş Yap</span>
        </a>
      <% } %>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
