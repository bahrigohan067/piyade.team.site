<%- include('../layouts/header') %>

<div style="max-width: 680px; margin: 4rem auto; text-align: center;">
  <div class="glass-card" style="padding: 3rem 2rem; border-top: 4px solid var(--color-danger);">
    <div style="width: 72px; height: 72px; border-radius: 20px; background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.3); display: flex; align-items: center; justify-content: center; font-size: 2.2rem; margin: 0 auto 1.25rem;">
      💥
    </div>
    <span class="badge badge-danger" style="margin-bottom: 0.75rem;"><%= t('errors.500Badge') %></span>
    <h1 style="font-size: 1.85rem; margin-bottom: 0.75rem; color: #ffffff;"><%= t('errors.500Title') %></h1>
    <p style="color: var(--text-secondary); margin-bottom: 1.25rem; font-size: 0.95rem;">
      <%= typeof message !== 'undefined' ? message : t('errors.500DefaultMsg') %>
    </p>

    <% if (typeof errorCode !== 'undefined' && errorCode) { %>
      <div style="background: rgba(8, 9, 13, 0.85); padding: 0.9rem 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color); margin-bottom: 1.5rem; display: inline-block; max-width: 100%;">
        <div style="font-size: 0.9rem; color: var(--text-primary); font-weight: 700; margin-bottom: 0.25rem;">
          <%= t('errors.errorCodeLabel') %> <code style="font-family: var(--font-mono); font-size: 1rem; color: var(--color-danger); letter-spacing: 0.08em;"><%= errorCode %></code>
        </div>
        <div style="font-size: 0.78rem; color: var(--text-muted);">
          <%= t('errors.errorCodeHint') %>
        </div>
      </div>
    <% } %>

    <% if (typeof stack !== 'undefined' && stack) { %>
      <div style="text-align: left; background: rgba(8, 9, 13, 0.85); padding: 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color); max-height: 200px; overflow-y: auto; font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-danger); margin-bottom: 1.5rem;">
        <pre style="margin: 0; white-space: pre-wrap;"><%= stack %></pre>
      </div>
    <% } %>

    <div style="display: flex; gap: 1rem; justify-content: center;">
      <button onclick="window.location.reload();" class="btn btn-primary">
        <span><%= t('errors.btnRetry') %></span>
      </button>
      <a href="/" class="btn btn-secondary">
        <span><%= t('errors.btnBackHome') %></span>
      </a>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
