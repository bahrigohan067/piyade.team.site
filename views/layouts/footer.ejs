      </div><!-- /.container -->
    </main><!-- /.main-content -->

    <%
      const footerBrand = (typeof brandConfig !== 'undefined' && brandConfig && typeof brandConfig.getSiteName === 'function')
        ? brandConfig.getSiteName()
        : ((typeof t === 'function' && t('brand.name') !== 'brand.name') ? t('brand.name') : 'Piyade');
      const footerLogoSrc = (typeof brandConfig !== 'undefined' && brandConfig && brandConfig.ASSETS && brandConfig.ASSETS.logo256)
        ? brandConfig.ASSETS.logo256
        : '/img/brand/logo-256.webp?v=1';
      const assetVer = (typeof seo !== 'undefined' && seo.assetVersion) ? seo.assetVersion : '2.2.0';
      const footerLang = (typeof lang !== 'undefined' && lang === 'en') ? 'en' : 'tr';
      const footerLangPrefix = footerLang === 'en' ? '/en' : '';
      const footerLegalLinks = (typeof legalFooterLinks !== 'undefined' && Array.isArray(legalFooterLinks) && legalFooterLinks.length > 0)
        ? legalFooterLinks
        : [
            { path: '/yasal/kvkk-aydinlatma', labelTr: 'KVKK Aydınlatma Metni', labelEn: 'KVKK Privacy Notice' },
            { path: '/yasal/acik-riza', labelTr: 'Açık Rıza Metni', labelEn: 'Explicit Consent' },
            { path: '/yasal/gizlilik-politikasi', labelTr: 'Gizlilik Politikası', labelEn: 'Privacy Policy' },
            { path: '/yasal/cerez-politikasi', labelTr: 'Çerez Politikası', labelEn: 'Cookie Policy' },
            { path: '/yasal/kvkk-basvuru', labelTr: 'KVKK Başvuru Formu', labelEn: 'KVKK Request Form' },
            { path: '/yasal/kunye', labelTr: 'Künye', labelEn: 'Imprint' },
            { path: '/yasal/telif-dmca', labelTr: 'Telif Hakkı / DMCA', labelEn: 'Copyright / DMCA' },
            { path: '/bildir', labelTr: 'İhlal Bildir', labelEn: 'Report Abuse' },
          ];
      const discordUrl = (typeof brandConfig !== 'undefined' && brandConfig && typeof brandConfig.getDiscordInviteUrl === 'function' && brandConfig.getDiscordInviteUrl())
        ? brandConfig.getDiscordInviteUrl()
        : ((typeof seo !== 'undefined' && Array.isArray(seo.sameAs) && seo.sameAs.length > 0) ? seo.sameAs[0] : '');
      const showFeedbackPill = Boolean(
        (typeof feedbackConfig === 'undefined' || feedbackConfig.enabled !== false) &&
        (typeof disableFeedbackPill === 'undefined' || !disableFeedbackPill) &&
        typeof currentUser !== 'undefined' &&
        currentUser &&
        currentUser.id &&
        currentUser.inGuild === true
      );
    %>

    <!-- Alt Bilgi / Footer -->
    <footer class="site-footer">
      <div class="container footer-content">
        <div>
          <div class="footer-brand-row">
            <img
              src="<%= footerLogoSrc %>"
              alt="<%= t('brand.footerLogoAlt') %>"
              width="56"
              height="56"
              loading="lazy"
              decoding="async"
              class="footer-brand-logo"
            />
            <strong class="footer-brand-title"><%= footerBrand %></strong>
          </div>
          <p class="footer-desc">
            <%= t('footer.description') %>
          </p>
        </div>

        <ul class="footer-links">
          <li><a href="/"><%= t('nav.home') %></a></li>
          <li><a href="/kurallar"><%= t('nav.rules') %></a></li>
          <li><a href="/etkilesim"><%= t('nav.interactive') %></a></li>
          <li><a href="/kayit"><%= t('nav.register') %></a></li>
          <% if (discordUrl) { %>
            <li><a href="<%= discordUrl %>" target="_blank" rel="noopener"><%= t('footer.discordServer') %></a></li>
          <% } %>
        </ul>

        <div class="footer-copyright">
          &copy; <%= new Date().getFullYear() %> <%= footerBrand %> — <%= t('footer.copyright') %>
        </div>
      </div>

      <% if (typeof isChatPage === 'undefined' || !isChatPage) { %>
        <div class="container footer-legal-bar" aria-label="<%= t('footer.legalLinksAria') %>">
          <nav class="footer-legal-nav">
            <% footerLegalLinks.forEach(function (item, idx) { %>
              <% if (idx > 0) { %><span class="footer-legal-sep" aria-hidden="true">•</span><% } %>
              <a href="<%= footerLangPrefix %><%= item.path %>" class="footer-legal-link"><%= footerLang === 'en' ? item.labelEn : item.labelTr %></a>
            <% }); %>
          </nav>
        </div>
      <% } %>
    </footer>
  </div><!-- /.app-layout-shell -->

  <!-- Engellemeyen Zorunlu Çerez Bilgi Çubuğu -->
  <div id="cookieNoticeBar" class="cookie-notice-bar no-print" role="region" aria-label="<%= t('cookieNotice.ariaLabel') %>" hidden aria-hidden="true">
    <div class="cookie-notice-inner">
      <p class="cookie-notice-text">
        🍪 <%= t('cookieNotice.text') %>
        <a href="<%= footerLangPrefix %>/yasal/cerez-politikasi" class="cookie-notice-link"><%= t('cookieNotice.policyLink') %></a>
      </p>
      <button type="button" id="cookieNoticeAckBtn" class="btn btn-primary btn-xs cookie-notice-btn">
        <%= t('cookieNotice.ackBtn') %>
      </button>
    </div>
  </div>

  <% if (showFeedbackPill) { %>
    <!-- Sağ Alt Köşe: Nexus UI Feedback Pill Bileşeni (Yalnızca girişli ve sunucudaki üyelere) -->
    <%- include('../partials/feedback-pill') %>
  <% } %>

  <!-- Aero Shards WebGL Yardımcı Katmanı (Yerel Vendor) ve Parametrik Arka Plan Motoru -->
  <script src="/vendor/aero-webgl.js?v=<%= assetVer %>" defer></script>
  <script src="/js/background/aero-shards.js?v=<%= assetVer %>" defer></script>

  <!-- Nexus UI İnteraktif Bileşenleri (Meteors, Dart Rating, Scroll Reveal Text, NexusSpring) -->
  <script src="/js/nexus-components.js?v=<%= assetVer %>" defer></script>

  <% if (showFeedbackPill || (typeof isChatPage !== 'undefined' && isChatPage)) { %>
    <!-- Ortak Web Audio Sentezleyici -->
    <script src="/js/nexus-sound.js?v=<%= assetVer %>" defer></script>
  <% } %>

  <% if (showFeedbackPill) { %>
    <!-- Feedback Pill Mantığı -->
    <script src="/js/feedback-pill.js?v=<%= assetVer %>" defer></script>
  <% } %>

  <!-- Temel İstemci Scriptleri (Sol Menü, Form Kilidi, Canlı Arama, Zorunlu Çerez Bildirimi) -->
  <script src="/js/app.js?v=<%= assetVer %>" defer></script>
  <script src="/js/cookie-notice.js?v=<%= assetVer %>" defer></script>

  <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.id) { %>
    <!-- Merkezi Gerçek Zamanlı Bağlantı Yöneticisi (Sekmeler Arası Tek SSE + BroadcastChannel) -->
    <script src="/js/realtime.js?v=<%= assetVer %>" defer></script>
  <% } %>

  <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.id && (typeof isGoogleMember === 'undefined' || !isGoogleMember)) { %>
    <!-- Kişisel "Etkinliğim" Paneli İstemci Mantığı (Yalnızca Discord Üyeleri) -->
    <script src="/js/activity-panel.js?v=<%= assetVer %>" defer></script>
  <% } %>

  <% if (typeof chatEnabled !== 'undefined' && chatEnabled && typeof currentUser !== 'undefined' && currentUser && currentUser.id && typeof isRegistered !== 'undefined' && isRegistered && (typeof isGoogleMember === 'undefined' || !isGoogleMember || typeof chatGoogleMembersEnabled === 'undefined' || chatGoogleMembersEnabled)) { %>
    <!-- Sol Menü Sohbet Okunmamış Rozeti (Merkezi SSE + Sessiz Yedek Yoklama) -->
    <script src="/js/chat-badge.js?v=<%= assetVer %>" defer></script>
  <% } %>

  <% if (typeof isHomePage !== 'undefined' && isHomePage) { %>
    <!-- Anasayfa "Sunucuda En Çok Oynanan Oyunlar" Sıralama ve Animasyon Mantığı -->
    <script src="/js/top-games.js?v=<%= assetVer %>" defer></script>
  <% } %>

  <% if (typeof isRegisterPage !== 'undefined' && isRegisterPage) { %>
    <script src="/js/register.js?v=<%= assetVer %>" defer></script>
  <% } %>

  <% if (typeof isGoogleSignupPage !== 'undefined' && isGoogleSignupPage) { %>
    <script src="/js/google-signup.js?v=<%= assetVer %>" defer></script>
  <% } %>

  <% if (typeof isGoogleProfilePage !== 'undefined' && isGoogleProfilePage) { %>
    <script src="/js/profile-google.js?v=<%= assetVer %>" defer></script>
  <% } %>

  <% if (typeof isChatPage !== 'undefined' && isChatPage) { %>
    <script src="/js/offline-indicator.js?v=<%= assetVer %>" defer></script>
    <script src="/js/chat.js?v=<%= assetVer %>" defer></script>
    <script src="/js/chat-attachments.js?v=<%= assetVer %>" defer></script>
    <script src="/js/chat-profile-card.js?v=<%= assetVer %>" defer></script>
  <% } %>

  <% if (typeof isChatModPage !== 'undefined' && isChatModPage) { %>
    <script src="/js/chat-mod.js?v=<%= assetVer %>" defer></script>
  <% } %>

  <% if (typeof isReportPage !== 'undefined' && isReportPage) { %>
    <script src="/js/report-form.js?v=<%= assetVer %>" defer></script>
  <% } %>

  <% if (typeof isGoogleMember !== 'undefined' && isGoogleMember) { %>
    <!-- Site (Google) Üyesi Kapatılabilir Uyarı Bildirim Kartları (SSR + Canlı SSE) -->
    <script src="/js/warning-notices.js?v=<%= assetVer %>" defer></script>
  <% } %>

  <% if (typeof isAdminWarnPage !== 'undefined' && isAdminWarnPage) { %>
    <!-- Yönetim Paneli: Site (Google) Üyelerine Uyarı Verme ve Sicil Önizleme -->
    <script src="/js/admin-site-warn.js?v=<%= assetVer %>" defer></script>
  <% } %>

  <% if (typeof isAdminLegalPage !== 'undefined' && isAdminLegalPage) { %>
    <script src="/js/admin-legal.js?v=<%= assetVer %>" defer></script>
  <% } %>
</body>
</html>
