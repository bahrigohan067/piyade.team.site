      </div><!-- /.container -->
    </main><!-- /.main-content -->

    <%
      const footerBrand = (typeof t === 'function' && t('brand.name') !== 'brand.name')
        ? t('brand.name')
        : ((typeof siteConfig !== 'undefined' && siteConfig.BRAND_NAME) ? siteConfig.BRAND_NAME : 'Piyade Clan | TSB');
      const footerLogoSrc = (typeof brandConfig !== 'undefined' && brandConfig && brandConfig.ASSETS && brandConfig.ASSETS.logo256)
        ? brandConfig.ASSETS.logo256
        : '/img/brand/logo-256.webp?v=1';
      const assetVer = (typeof seo !== 'undefined' && seo.assetVersion) ? seo.assetVersion : '1.4.0';
      const discordUrl = (typeof seo !== 'undefined' && Array.isArray(seo.sameAs) && seo.sameAs.length > 0) ? seo.sameAs[0] : '';
      const showFeedbackPill = Boolean(
        (typeof feedbackConfig === 'undefined' || feedbackConfig.enabled !== false) &&
        (typeof disableFeedbackPill === 'undefined' || !disableFeedbackPill) &&
        typeof currentUser !== 'undefined' &&
        currentUser &&
        currentUser.id &&
        currentUser.inGuild === true
      );
    %>

    <!-- Alt Bilgi / Footer -->
    <footer class="site-footer">
      <div class="container footer-content">
        <div>
          <div class="footer-brand-row">
            <img
              src="<%= footerLogoSrc %>"
              alt="<%= t('brand.footerLogoAlt') %>"
              width="56"
              height="56"
              loading="lazy"
              decoding="async"
              class="footer-brand-logo"
            />
            <strong class="footer-brand-title"><%= footerBrand %></strong>
          </div>
          <p class="footer-desc">
            <%= t('footer.description') %>
          </p>
        </div>

        <ul class="footer-links">
          <li><a href="/"><%= t('nav.home') %></a></li>
          <li><a href="/kurallar"><%= t('nav.rules') %></a></li>
          <li><a href="/etkilesim"><%= t('nav.interactive') %></a></li>
          <li><a href="/kayit"><%= t('nav.register') %></a></li>
          <% if (discordUrl) { %>
            <li><a href="<%= discordUrl %>" target="_blank" rel="noopener"><%= t('footer.discordServer') %></a></li>
          <% } %>
        </ul>

        <div class="footer-copyright">
          &copy; <%= new Date().getFullYear() %> <%= footerBrand %> — <%= t('footer.copyright') %>
        </div>
      </div>
    </footer>
  </div><!-- /.app-layout-shell -->

  <% if (showFeedbackPill) { %>
    <!-- Sağ Alt Köşe: Nexus UI Feedback Pill Bileşeni (Yalnızca girişli ve sunucudaki üyelere) -->
    <%- include('../partials/feedback-pill') %>
  <% } %>

  <!-- Aero Shards WebGL Yardımcı Katmanı (Yerel Vendor) ve Parametrik Arka Plan Motoru -->
  <script src="/vendor/aero-webgl.js?v=<%= assetVer %>" defer></script>
  <script src="/js/background/aero-shards.js?v=<%= assetVer %>" defer></script>

  <%
    const hasWarriorsCarousel = Boolean(typeof topWarriors !== 'undefined' && Array.isArray(topWarriors) && topWarriors.length > 0);
  %>
  <!-- Nexus UI İnteraktif Bileşenleri (Meteors, Dart Rating, Scroll Reveal Text, NexusSpring) -->
  <script src="/js/nexus-components.js?v=<%= assetVer %>" defer></script>

  <% if (showFeedbackPill || hasWarriorsCarousel) { %>
    <!-- Ortak Web Audio Sentezleyici -->
    <script src="/js/nexus-sound.js?v=<%= assetVer %>" defer></script>
  <% } %>

  <% if (hasWarriorsCarousel) { %>
    <!-- Klanın Zirvesi: Nexus UI 3D Card Carousel -->
    <script src="/js/warriors-carousel.js?v=<%= assetVer %>" defer></script>
  <% } %>

  <% if (showFeedbackPill) { %>
    <!-- Feedback Pill Mantığı -->
    <script src="/js/feedback-pill.js?v=<%= assetVer %>" defer></script>
  <% } %>

  <% if (typeof isWarriorsAdminPage !== 'undefined' && isWarriorsAdminPage) { %>
    <!-- Klanın Zirvesi: Developer Paneli Scripti -->
    <script src="/js/admin-warriors.js?v=<%= assetVer %>" defer></script>
  <% } %>

  <!-- Temel İstemci Scriptleri (Sol Menü, Form Kilidi, Canlı Arama) -->
  <script src="/js/app.js?v=<%= assetVer %>" defer></script>
</body>
</html>
