<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'tr' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : t('meta.defaultTitle') %></title>
  
  <!-- Favicon & Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  
  <!-- CSS Dosyaları (theme.css tek noktadan yönetilen obsidian paletidir) -->
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body data-lang="<%= typeof lang !== 'undefined' ? lang : 'tr' %>">

  <!-- Ambient Obsidian Arka Plan Efektleri (Taktiksel Izgara ve Parıltı Orbları) -->
  <div class="ambient-bg-grid"></div>
  <div class="ambient-orb ambient-orb-1"></div>
  <div class="ambient-orb ambient-orb-2"></div>
  <div class="ambient-orb ambient-orb-3"></div>

  <!-- Üst Menü / Navbar (Glass-Nav) -->
  <header class="site-header">
    <div class="container navbar">
      
      <!-- Logo ve Klan İsmi -->
      <a href="/" class="brand">
        <div class="brand-icon">
          <div class="brand-icon-inner">⚔️</div>
        </div>
        <div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <span style="font-weight: 900; letter-spacing: -0.01em;">PİYADE <span class="gradient-text">TEAM</span></span>
            <span class="badge badge-primary" style="font-size: 0.65rem; padding: 2px 7px;">TSB</span>
          </div>
          <div style="font-size: 0.68rem; color: var(--text-muted); font-weight: 500; letter-spacing: 0.02em;"><%= t('meta.brandSubtitle') %></div>
        </div>
      </a>

      <!-- Dinamik Menü Linkleri (menu.config.js üzerinden gelir) -->
      <nav>
        <ul class="nav-links" id="navLinks">
          <% if (typeof visibleMenus !== 'undefined' && visibleMenus.length > 0) { %>
            <% visibleMenus.forEach(function(item) { %>
              <li>
                <a href="<%= item.path %>" class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === item.path ? 'active' : '' %>">
                  <span><%= item.title %></span>
                  <% if (item.badge) { %>
                    <span class="badge <%= item.badgeClass || 'badge-primary' %>" style="font-size: 0.65rem; padding: 1px 6px;"><%= item.badge %></span>
                  <% } %>
                </a>
              </li>
            <% }); %>
          <% } else { %>
            <li><a href="/" class="nav-link"><%= t('nav.home') %></a></li>
            <li><a href="/kurallar" class="nav-link"><%= t('nav.rules') %></a></li>
            <li><a href="/etkilesim" class="nav-link"><%= t('nav.interactive') %></a></li>
            <li><a href="/kayit" class="nav-link"><%= t('nav.register') %></a></li>
          <% } %>
        </ul>
      </nav>

      <!-- Sağ Aksiyon Alanı: Dil Seçici, Canlı Durum ve Kullanıcı Butonu -->
      <div class="nav-actions">

        <!-- Çok Dilli Dil Seçici (TR | EN — 1 Yıl Çerez Kayıtlı) -->
        <div style="display: inline-flex; align-items: center; background: rgba(255, 255, 255, 0.04); border: 1px solid var(--border-color); border-radius: 9999px; padding: 2px;" aria-label="<%= t('nav.langSwitchLabel') %>">
          <a
            href="/lang/tr"
            style="padding: 3px 8px; border-radius: 9999px; font-size: 0.72rem; font-weight: 700; text-decoration: none; transition: all 0.2s; <%= (typeof lang === 'undefined' || lang === 'tr') ? 'background: rgba(59, 130, 246, 0.25); color: #ffffff; border: 1px solid rgba(59, 130, 246, 0.45);' : 'color: var(--text-muted);' %>"
          >TR</a>
          <a
            href="/lang/en"
            style="padding: 3px 8px; border-radius: 9999px; font-size: 0.72rem; font-weight: 700; text-decoration: none; transition: all 0.2s; <%= (typeof lang !== 'undefined' && lang === 'en') ? 'background: rgba(59, 130, 246, 0.25); color: #ffffff; border: 1px solid rgba(59, 130, 246, 0.45);' : 'color: var(--text-muted);' %>"
          >EN</a>
        </div>
        
        <!-- Canlı Aktif Üye Göstergesi -->
        <div class="nav-status-pill hidden-sm">
          <span class="status-dot-success"></span>
          <span>👥 <%= (typeof activeStats !== 'undefined' && activeStats.activeRegisteredCount) ? activeStats.activeRegisteredCount : 0 %> <%= t('nav.activeCount') %></span>
        </div>

        <!-- Kullanıcı Alanı / Giriş Butonu -->
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <div class="user-menu">
            <img src="<%= currentUser.avatarUrl %>" alt="<%= currentUser.displayName %>" class="user-avatar" />
            <span class="user-name"><%= currentUser.displayName %></span>
            <% if (typeof isDeveloper !== 'undefined' && isDeveloper) { %>
              <span class="badge badge-danger" style="font-size: 0.65rem; padding: 2px 6px;"><%= t('nav.roleDev') %></span>
            <% } else if (typeof isManagement !== 'undefined' && isManagement) { %>
              <span class="badge badge-warning" style="font-size: 0.65rem; padding: 2px 6px;"><%= t('nav.roleStaff') %></span>
            <% } else if (typeof isRegistered !== 'undefined' && isRegistered) { %>
              <span class="badge badge-success" style="font-size: 0.65rem; padding: 2px 6px;"><%= t('nav.roleMember') %></span>
            <% } %>
            <a href="/auth/logout" class="btn btn-secondary btn-sm" title="<%= t('nav.logoutTitle') %>" style="padding: 3px 8px; font-size: 0.75rem; border-radius: 9999px;"><%= t('nav.logout') %></a>
          </div>
        <% } else { %>
          <a href="/auth/discord" class="btn btn-discord btn-sm">
            <span><%= t('nav.loginDiscord') %></span>
          </a>
        <% } %>

        <!-- Mobil Menü Butonu -->
        <button class="mobile-menu-btn" id="mobileMenuToggle" aria-label="<%= t('nav.openMenu') %>">☰</button>
      </div>

    </div>
  </header>

  <!-- Ana İçerik Taşıyıcısı -->
  <main class="main-content">
    <div class="container">
