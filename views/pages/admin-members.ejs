<%- include('../layouts/header') %>

<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 2.5rem; padding-top: 1rem;">
  <div>
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 0.5rem;">
      <span class="badge badge-warning"><%= t('adminMembers.badgeTop') %></span>
      <span class="badge badge-neutral"><%= t('adminMembers.badgeSub') %></span>
    </div>
    <h1 style="font-size: 2.2rem; margin-bottom: 0.5rem;"><%= t('adminMembers.heading') %></h1>
    <p style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">
      <%= t('adminMembers.subheading') %>
    </p>
  </div>
  <% if (selectedMember || (typeof botInternalError !== 'undefined' && botInternalError && botInternalError.mode === 'detail')) { %>
    <div>
      <a href="/yonetim/uyeler" class="btn btn-secondary">
        <span><%= t('adminMembers.btnBackToList') %></span>
      </a>
    </div>
  <% } %>
</div>

<!-- MOD 1: TEKİL ÜYE DETAY KARTLARI (selectedMember VARSA) -->
<% if (selectedMember) { %>
  <%
    const detailDiscord = selectedMember.discord || {};
    const detailReg = selectedMember.registration || null;
    const detailRegGames = detailReg && Array.isArray(detailReg.games) ? detailReg.games : [];
    const isDetailRegActive = Boolean(
      detailReg &&
      detailReg.registered &&
      (detailRegGames.length > 0 || detailReg.name || detailReg.realName || detailReg.robloxUsername || detailReg.robloxId)
    );
    const detailWarnStats = (selectedMember.warnings && selectedMember.warnings.stats) ? selectedMember.warnings.stats : { points: 0, tier: 0 };
    const detailWarnHistory = (selectedMember.warnings && Array.isArray(selectedMember.warnings.history)) ? selectedMember.warnings.history : [];
  %>
  <!-- Üst Profil Özeti (Obsidian Glass Banner) -->
  <div class="glass-card" style="margin-bottom: 2rem; padding: 2rem; border-color: var(--border-color);">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem;">
      <div style="display: flex; align-items: center; gap: 1.25rem;">
        <div style="position: relative;">
          <img
            src="<%= detailDiscord.avatarUrl || 'https://cdn.discordapp.com/embed/avatars/0.png' %>"
            alt="<%= detailDiscord.displayName || detailDiscord.username || '-' %>"
            width="82"
            height="82"
            loading="lazy"
            decoding="async"
            style="width: 82px; height: 82px; border-radius: 50%; border: 3px solid var(--color-primary); box-shadow: var(--shadow-primary); object-fit: cover;"
          />
          <span class="status-dot-success" style="position: absolute; bottom: 4px; right: 4px; width: 14px; height: 14px; border: 2px solid var(--bg-body);"></span>
        </div>
        <div>
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 4px; flex-wrap: wrap;">
            <h2 style="font-size: 1.75rem; margin: 0; color: var(--text-primary);"><%= detailDiscord.displayName || detailDiscord.username || '-' %></h2>
            <% if (detailDiscord.level === 'developer') { %>
              <span class="badge badge-danger"><%= t('profile.roleDeveloper') %></span>
            <% } else if (detailDiscord.level === 'yonetmenlik') { %>
              <span class="badge badge-warning"><%= t('profile.roleManagement') %></span>
            <% } else { %>
              <span class="badge badge-success"><%= t('nav.roleMember') %></span>
            <% } %>
          </div>
          <p style="margin: 0; font-size: 0.875rem; color: var(--text-muted);">
            @<%= detailDiscord.username || '-' %> • Discord ID: <code><%= detailDiscord.id || '-' %></code>
          </p>
        </div>
      </div>

      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <a href="/yonetim/uyari?targetUserId=<%= detailDiscord.id %>" class="btn btn-danger">
          <span><%= t('adminMembers.btnWarnMember') %></span>
        </a>
        <% if (detailReg && detailReg.robloxProfileUrl) { %>
          <a href="<%= detailReg.robloxProfileUrl %>" target="_blank" rel="noopener" class="btn btn-secondary">
            <span><%= t('adminMembers.btnRobloxProfile') %></span>
          </a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Hızlı Disiplin İstatistik Sayaçları -->
  <div class="grid grid-2" style="margin-bottom: 2rem;">
    <div class="stat-card">
      <div class="stat-header">
        <span class="stat-label"><%= t('adminMembers.statPenalty') %></span>
        <span style="font-size: 1.2rem;">⚖️</span>
      </div>
      <div class="stat-value" style="color: <%= (detailWarnStats.points || 0) > 0 ? 'var(--color-danger)' : 'var(--color-success)' %>; font-size: 1.4rem;">
        <%= detailWarnStats.points || 0 %> <%= t('profile.pointsWord') %>
      </div>
      <div class="stat-desc">
        <%= detailWarnStats.tier ? t('profile.warningTierPrefix') + detailWarnStats.tier : t('adminMembers.clean') %>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-header">
        <span class="stat-label"><%= t('adminMembers.statProfanity') %></span>
        <span style="font-size: 1.2rem;">🛑</span>
      </div>
      <div class="stat-value" style="color: <%= (selectedMember.moderation?.profanityViolationCount || 0) > 0 ? 'var(--color-warning)' : 'var(--text-primary)' %>; font-size: 1.4rem;">
        <%= selectedMember.moderation?.profanityViolationCount || 0 %>
      </div>
      <div class="stat-desc">
        <%= t('adminMembers.statProfanityDesc') %>
      </div>
    </div>
  </div>

  <!-- Detay Kartları -->
  <div class="grid grid-2" style="margin-bottom: 2rem;">
    
    <!-- 1. Discord & Roller Kartı -->
    <div class="glass-card">
      <div class="card-header">
        <h3 class="card-title"><span>🎮</span> <%= t('adminMembers.cardDiscordTitle') %></h3>
      </div>
      <div>
        <div style="margin-bottom: 1.25rem;">
          <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;"><%= t('adminMembers.labelJoinedAt') %></span>
          <div style="font-weight: 600; color: var(--text-primary); font-size: 0.95rem; margin-top: 2px;">
            <%= detailDiscord.joinedAt ? new Date(detailDiscord.joinedAt).toLocaleDateString(lang === 'en' ? 'en-US' : 'tr-TR') : '-' %>
          </div>
        </div>

        <div>
          <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; display: block; margin-bottom: 8px; font-weight: 700;"><%= t('adminMembers.labelRoles') %></span>
          <div style="display: flex; flex-wrap: wrap; gap: 6px;">
            <% if (detailDiscord.roles && detailDiscord.roles.length > 0) { %>
              <% detailDiscord.roles.forEach(function(r) { %>
                <span class="badge" style="background: var(--bg-subtle-hover); border: 1px solid var(--border-color); color: var(--text-secondary); font-size: 0.8rem; padding: 4px 10px;">
                  <span style="width: 7px; height: 7px; border-radius: 50%; background: var(--color-primary); display: inline-block; margin-right: 4px;"></span>
                  <%= r.name || r.id || r %>
                </span>
              <% }); %>
            <% } else { %>
              <span style="color: var(--text-muted); font-size: 0.85rem;"><%= t('adminMembers.noRoles') %></span>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Kayıt Bilgisi Kartı -->
    <div class="glass-card">
      <div class="card-header">
        <h3 class="card-title"><span>📋</span> <%= t('adminMembers.cardRegistrationTitle') %></h3>
        <% if (isDetailRegActive) { %>
          <span class="badge badge-success"><%= t('register.registeredStatus') %></span>
        <% } else { %>
          <span class="badge badge-neutral"><%= t('profile.badgeUnregistered') %></span>
        <% } %>
      </div>
      <div>
        <% if (isDetailRegActive) { %>
          <div style="display: flex; flex-direction: column; gap: 1rem;">
            <div>
              <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;"><%= t('profile.labelRealName') %></span>
              <div style="font-weight: 700; color: var(--text-primary); font-size: 1.05rem;"><%= detailReg.name || detailReg.realName || '-' %></div>
            </div>
            <div>
              <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;"><%= t('profile.labelGender') %></span>
              <div style="font-weight: 600; color: var(--text-primary);"><%= detailReg.gender || '-' %></div>
            </div>
            <div>
              <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;"><%= t('adminMembers.labelGames') %></span>
              <% if (detailRegGames.length > 0) { %>
                <ul class="admin-games-list">
                  <% detailRegGames.forEach((g) => {
                       const gTitle = g.name && typeof g.name === 'object' ? (lang === 'en' ? (g.name.en || g.name.tr || g.id) : (g.name.tr || g.name.en || g.id)) : (g.name || g.id);
                  %>
                    <li class="admin-games-item">
                      <span class="admin-games-name"><span aria-hidden="true"><%= g.emoji || '🎮' %></span> <%= gTitle %></span>
                      <code class="admin-games-user"><%= g.username %></code>
                      <% if (g.profileUrl) { %>
                        <a href="<%= g.profileUrl %>" target="_blank" rel="noopener noreferrer" class="admin-games-link">↗</a>
                      <% } %>
                    </li>
                  <% }); %>
                </ul>
              <% } else { %>
                <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;"><%= t('adminMembers.noGamesListed') %></div>
              <% } %>
            </div>
            <% if (detailReg.robloxUsername) { %>
              <div>
                <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;"><%= t('profile.labelRobloxUser') %></span>
                <div style="font-weight: 700; color: var(--color-info); font-size: 1.05rem;">@<%= detailReg.robloxUsername %></div>
              </div>
            <% } %>
            <% if (detailReg.robloxId) { %>
              <div>
                <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;"><%= t('profile.labelRobloxId') %></span>
                <div><code><%= detailReg.robloxId %></code></div>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <p style="color: var(--text-muted); font-size: 0.925rem;"><%= t('adminMembers.unregisteredMemberMsg') %></p>
        <% } %>
      </div>
    </div>

  </div>

  <!-- 3. Disiplin ve Uyarı Sicil Geçmişi -->
  <div class="glass-card" style="margin-bottom: 2rem; padding: 0; overflow: hidden;">
    <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between;">
      <h3 class="card-title" style="margin: 0;"><span>⚖️</span> <%= t('adminMembers.cardHistoryTitle') %></h3>
      <span class="badge badge-primary">
        <%= t('adminMembers.totalRecordsPrefix') %> <%= detailWarnHistory.length %> <%= t('adminMembers.totalRecordsSuffix') %>
      </span>
    </div>
    <div>
      <% if (detailWarnHistory.length === 0) { %>
        <p style="color: var(--text-muted); margin: 0; padding: 2rem 1.5rem;"><%= t('adminMembers.emptyHistoryMsg') %></p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th><%= t('adminMembers.colId') %></th>
                <th><%= t('adminMembers.colDate') %></th>
                <th><%= t('adminMembers.colType') %></th>
                <th><%= t('adminMembers.colRule') %></th>
                <th><%= t('adminMembers.colReason') %></th>
                <th><%= t('adminMembers.colStaff') %></th>
                <th style="text-align: right;"><%= t('adminMembers.colProof') %></th>
              </tr>
            </thead>
            <tbody>
              <% detailWarnHistory.forEach(function(w) { %>
                <tr>
                  <td><code>#<%= w.id %></code></td>
                  <td style="font-size: 0.85rem; color: var(--text-muted); white-space: nowrap;">
                    <%= w.createdAt ? new Date(w.createdAt).toLocaleString(lang === 'en' ? 'en-US' : 'tr-TR') : '-' %>
                  </td>
                  <td>
                    <span class="badge <%= w.type === 'verbal' ? 'badge-warning' : 'badge-danger' %>">
                      <%= w.type === 'verbal' ? t('adminMembers.typeVerbal') : t('adminMembers.typeOfficial') %>
                    </span>
                  </td>
                  <td>
                    <% if (w.ruleCode) { %>
                      <strong style="color: var(--color-danger);"><%= w.ruleCode %></strong>
                    <% } else { %>
                      -
                    <% } %>
                  </td>
                  <td style="max-width: 250px;">
                    <div style="font-size: 0.875rem; color: var(--text-primary);"><%= w.reason || w.reasonDisplay || '-' %></div>
                    <% if (w.actionTakenText) { %>
                      <div style="font-size: 0.775rem; color: var(--text-muted);"><%= w.actionTakenText %></div>
                    <% } %>
                  </td>
                  <td>
                    <span style="font-size: 0.85rem; color: var(--text-secondary);"><%= w.staffTag || w.staffId %></span>
                  </td>
                  <td style="text-align: right;">
                    <% if (w.proofUrl || w.evidenceUrl) { %>
                      <a href="<%= w.proofUrl || w.evidenceUrl %>" target="_blank" rel="noopener" class="btn btn-secondary btn-sm" style="padding: 2px 8px;">
                        <%= t('adminMembers.btnViewProof') %>
                      </a>
                    <% } else { %>
                      <span style="color: var(--text-muted); font-size: 0.8rem;"><%= t('adminMembers.none') %></span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

<!-- MOD 2: ÜYE ARAMA VE LİSTELEME -->
<% } else { %>
  <!-- Arama Formu -->
  <div class="glass-card" style="margin-bottom: 2rem; padding: 1.25rem 1.5rem;">
    <form action="/yonetim/uyeler" method="GET" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
      <div style="flex: 1; min-width: 260px;">
        <input
          type="text"
          name="query"
          class="form-control"
          placeholder="<%= t('adminMembers.searchPlaceholder') %>"
          value="<%= query || '' %>"
        />
      </div>
      <button type="submit" class="btn btn-primary">
        <span><%= t('adminMembers.btnSearch') %></span>
      </button>
      <% if (query) { %>
        <a href="/yonetim/uyeler" class="btn btn-secondary">
          <span><%= t('adminMembers.btnClear') %></span>
        </a>
      <% } %>
    </form>
  </div>

  <!-- Arama Sonuçları Listesi veya Geçici Bot Hatası Uyarı Kartı -->
  <% if (typeof botInternalError !== 'undefined' && botInternalError) { %>
    <div class="glass-card admin-members-error-card" role="alert">
      <div class="admin-members-error-icon" aria-hidden="true">⚠️</div>
      <p class="admin-members-error-desc">
        <%= botInternalError.mode === 'detail' ? t('adminMembers.botErrorDetailMsg') : t('adminMembers.botErrorListMsg') %>
      </p>
      <div class="admin-members-error-meta">
        <span><%= t('adminMembers.errorCodeLabel') %> <code class="admin-members-error-code"><%= botInternalError.errorCode %></code></span>
      </div>
      <div class="admin-members-error-actions">
        <a href="<%= botInternalError.retryUrl %>" class="btn btn-primary">
          <span>🔄 <%= t('adminMembers.btnRetry') %></span>
        </a>
        <% if (botInternalError.mode === 'detail') { %>
          <a href="/yonetim/uyeler" class="btn btn-secondary">
            <span><%= t('adminMembers.btnBackToList') %></span>
          </a>
        <% } %>
      </div>
    </div>
  <% } else if (!members || members.length === 0) { %>
    <div class="glass-card" style="text-align: center; padding: 4rem 1.5rem;">
      <div style="width: 64px; height: 64px; border-radius: 20px; background: var(--color-primary-light); border: 1px solid var(--border-light); display: flex; align-items: center; justify-content: center; font-size: 2rem; margin: 0 auto 1.25rem;">
        🔍
      </div>
      <h3 style="color: var(--text-primary); font-size: 1.4rem; margin-bottom: 0.5rem;"><%= t('adminMembers.noMembersFoundTitle') %></h3>
      <p style="color: var(--text-muted); max-width: 480px; margin: 0 auto; font-size: 0.925rem;">
        <%= t('adminMembers.noMembersFoundDesc') %>
      </p>
    </div>
  <% } else { %>
    <div class="glass-card" style="padding: 0; overflow: hidden;">
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th><%= t('adminMembers.colMember') %></th>
              <th><%= t('adminMembers.colRegistration') %></th>
              <th><%= t('adminMembers.colAuthLevel') %></th>
              <th><%= t('adminMembers.statPenalty') %></th>
              <th style="text-align: right;"><%= t('adminMembers.colActions') %></th>
            </tr>
          </thead>
          <tbody>
            <% members.forEach(function(m) { %>
              <tr>
                <td>
                  <div style="display: flex; align-items: center; gap: 10px;">
                    <img
                      src="<%= m.avatarUrl || 'https://cdn.discordapp.com/embed/avatars/0.png' %>"
                      alt="<%= m.displayName %>"
                      width="38"
                      height="38"
                      loading="lazy"
                      decoding="async"
                      style="width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--border-color); object-fit: cover;"
                    />
                    <div>
                      <strong style="color: var(--text-primary); font-size: 0.95rem;"><%= m.displayName %></strong>
                      <div style="font-size: 0.8rem; color: var(--text-muted);">@<%= m.username %> • ID: <code><%= m.id %></code></div>
                    </div>
                  </div>
                </td>
                <td>
                  <% if (m.registration && m.registration.registered && (m.registration.robloxUsername || m.registration.realName || m.registration.name || (Array.isArray(m.registration.games) && m.registration.games.length > 0))) { %>
                    <% if (m.registration.robloxUsername) { %>
                      <strong style="color: var(--color-info); font-size: 0.9rem;">@<%= m.registration.robloxUsername %></strong>
                    <% } else if (Array.isArray(m.registration.games) && m.registration.games.length > 0) { %>
                      <strong style="color: var(--color-info); font-size: 0.9rem;"><%= m.registration.games.map((g) => (g.emoji || '🎮') + ' ' + g.username).join(' • ') %></strong>
                    <% } %>
                    <% if (m.registration.name || m.registration.realName) { %>
                      <div style="font-size: 0.775rem; color: var(--text-muted);"><%= m.registration.name || m.registration.realName %></div>
                    <% } %>
                  <% } else { %>
                    <span style="color: var(--text-muted); font-size: 0.85rem;"><%= t('profile.badgeUnregistered') %></span>
                  <% } %>
                </td>
                <td>
                  <% if (m.level === 'developer') { %>
                    <span class="badge badge-danger"><%= t('profile.roleDeveloper') %></span>
                  <% } else if (m.level === 'yonetmenlik') { %>
                    <span class="badge badge-warning"><%= t('profile.roleManagement') %></span>
                  <% } else { %>
                    <span class="badge badge-success"><%= t('nav.roleMember') %></span>
                  <% } %>
                </td>
                <td>
                  <% if (m.warnings && m.warnings.points > 0) { %>
                    <span class="badge badge-danger"><%= m.warnings.points %> <%= t('profile.pointsWord') %></span>
                  <% } else { %>
                    <span class="badge badge-success"><%= t('adminMembers.clean') %></span>
                  <% } %>
                </td>
                <td style="text-align: right; white-space: nowrap;">
                  <a href="/yonetim/uyeler/<%= m.id %>" class="btn btn-secondary btn-sm" style="margin-right: 6px;">
                    <span><%= t('adminMembers.btnDetail') %></span>
                  </a>
                  <a href="/yonetim/uyari?targetUserId=<%= m.id %>" class="btn btn-danger btn-sm">
                    <span><%= t('adminMembers.btnWarn') %></span>
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
<% } %>

<%- include('../layouts/footer') %>
