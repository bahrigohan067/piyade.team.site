<%- include('../layouts/header') %>

<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
  <div>
    <span class="badge badge-warning">Yönetim Paneli</span>
    <h1 style="margin-top: 0.5rem; margin-bottom: 0.5rem;">👥 Üye Bilgileri & Sicil Kayıtları</h1>
    <p style="color: var(--text-secondary); margin: 0;">
      Sunucu üyelerini arayın, tüm Discord, Roblox, Tryout, VS ve disiplin sicillerini inceleyin.
    </p>
  </div>
  <% if (selectedMember) { %>
    <div>
      <a href="/yonetim/uyeler" class="btn btn-secondary">
        <span>&larr; Üye Listesine Dön</span>
      </a>
    </div>
  <% } %>
</div>

<!-- MOD 1: TEKİL ÜYE DETAY KARTLARI (selectedMember VARSA) -->
<% if (selectedMember) { %>
  <!-- Üst Profil Özeti -->
  <div class="card" style="margin-bottom: 2rem; background: linear-gradient(135deg, rgba(21, 30, 50, 0.95), rgba(14, 21, 38, 0.95)); border: 1px solid var(--border-color);">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem;">
      <div style="display: flex; align-items: center; gap: 1.25rem;">
        <img
          src="<%= selectedMember.discord.avatarUrl %>"
          alt="<%= selectedMember.discord.displayName %>"
          style="width: 80px; height: 80px; border-radius: 50%; border: 3px solid var(--color-primary); box-shadow: var(--shadow-primary);"
        />
        <div>
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 4px;">
            <h2 style="font-size: 1.75rem; margin: 0;"><%= selectedMember.discord.displayName %></h2>
            <% if (selectedMember.discord.level === 'developer') { %>
              <span class="badge badge-danger">Developer</span>
            <% } else if (selectedMember.discord.level === 'yonetmenlik') { %>
              <span class="badge badge-warning">Yönetmenlik</span>
            <% } else { %>
              <span class="badge badge-success">Üye</span>
            <% } %>
          </div>
          <p style="margin: 0; font-size: 0.9rem; color: var(--text-muted);">
            @<%= selectedMember.discord.username %> • Discord ID: <code><%= selectedMember.discord.id %></code>
          </p>
        </div>
      </div>

      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <a href="/yonetim/uyari?targetUserId=<%= selectedMember.discord.id %>" class="btn btn-danger">
          <span>⚠️ Bu Üyeye Uyarı Ver</span>
        </a>
        <% if (selectedMember.registration && selectedMember.registration.robloxProfileUrl) { %>
          <a href="<%= selectedMember.registration.robloxProfileUrl %>" target="_blank" rel="noopener" class="btn btn-secondary">
            <span>🟥 Roblox Profili</span>
          </a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Hızlı İstatistik Sayaçları -->
  <div class="grid grid-4" style="margin-bottom: 2rem;">
    <div class="stat-card">
      <div class="stat-header">
        <span class="stat-label">Tryout Seviyesi</span>
        <span>🏆</span>
      </div>
      <div class="stat-value" style="color: var(--color-primary); font-size: 1.4rem;">
        <%= selectedMember.tryout.current.roleName || 'Yok' %>
      </div>
      <div class="stat-desc">
        Kademe <%= selectedMember.tryout.current.level || 0 %>/37 • <%= selectedMember.tryout.current.formCount || 0 %> Form
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-header">
        <span class="stat-label">VS Skoru</span>
        <span>⚔️</span>
      </div>
      <div class="stat-value" style="color: var(--color-accent);">
        <%= selectedMember.vs.points || 0 %> P
      </div>
      <div class="stat-desc">
        <%= selectedMember.vs.wins || 0 %>W / <%= selectedMember.vs.losses || 0 %>L • <%= selectedMember.vs.kills || 0 %> Kill
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-header">
        <span class="stat-label">Ceza Puanı</span>
        <span>⚖️</span>
      </div>
      <div class="stat-value" style="color: <%= selectedMember.warnings.stats.points > 0 ? 'var(--color-danger)' : 'var(--color-success)' %>;">
        <%= selectedMember.warnings.stats.points || 0 %> Puan
      </div>
      <div class="stat-desc">
        <%= selectedMember.warnings.stats.tier ? 'Uyarı ' + selectedMember.warnings.stats.tier : 'Sicil Temiz' %>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-header">
        <span class="stat-label">Küfür / Argo İhlali</span>
        <span>🛑</span>
      </div>
      <div class="stat-value" style="color: <%= (selectedMember.moderation?.profanityViolationCount || 0) > 0 ? 'var(--color-warning)' : 'var(--text-primary)' %>;">
        <%= selectedMember.moderation?.profanityViolationCount || 0 %>
      </div>
      <div class="stat-desc">
        Yapay zeka ve yerel filtre uyarısı
      </div>
    </div>
  </div>

  <!-- Detay Kartları -->
  <div class="grid grid-2" style="margin-bottom: 2rem;">
    <!-- 1. Discord & Roller Kartı -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><span>🎮</span> Discord Bilgileri ve Rolleri</h3>
      </div>
      <div class="card-body">
        <div style="margin-bottom: 1rem;">
          <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Sunucuya Katılma</span>
          <div style="font-weight: 600; color: var(--text-primary);">
            <%= selectedMember.discord.joinedAt ? new Date(selectedMember.discord.joinedAt).toLocaleDateString('tr-TR') : '-' %>
          </div>
        </div>

        <div>
          <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; display: block; margin-bottom: 6px;">Sahip Olduğu Roller</span>
          <div style="display: flex; flex-wrap: wrap; gap: 6px;">
            <% if (selectedMember.discord.roles && selectedMember.discord.roles.length > 0) { %>
              <% selectedMember.discord.roles.forEach(function(r) { %>
                <span style="display: inline-flex; align-items: center; gap: 4px; padding: 3px 8px; border-radius: var(--radius-sm); font-size: 0.8rem; background: var(--bg-surface); border: 1px solid var(--border-color); color: <%= r.color && r.color !== '#000000' ? r.color : 'var(--text-primary)' %>;">
                  <span style="width: 8px; height: 8px; border-radius: 50%; background: <%= r.color && r.color !== '#000000' ? r.color : 'var(--color-primary)' %>;"></span>
                  <%= r.name %>
                </span>
              <% }); %>
            <% } else { %>
              <span style="color: var(--text-muted); font-size: 0.85rem;">Rol bulunmuyor.</span>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Roblox ve Kayıt Kartı -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><span>🟥</span> Roblox ve Kayıt Bilgisi</h3>
        <% if (selectedMember.registration && selectedMember.registration.registered) { %>
          <span class="badge badge-success">Kayıtlı</span>
        <% } else { %>
          <span class="badge badge-warning">Kayıtsız</span>
        <% } %>
      </div>
      <div class="card-body">
        <% if (selectedMember.registration && selectedMember.registration.registered) { %>
          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <div>
              <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Gerçek Ad</span>
              <div style="font-weight: 700; color: var(--text-primary);"><%= selectedMember.registration.realName || '-' %></div>
            </div>
            <div>
              <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Cinsiyet</span>
              <div style="font-weight: 600; color: var(--text-primary);"><%= selectedMember.registration.gender || '-' %></div>
            </div>
            <div>
              <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Roblox Kullanıcı Adı</span>
              <div style="font-weight: 700; color: var(--color-primary);">@<%= selectedMember.registration.robloxUsername || '-' %></div>
            </div>
            <div>
              <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Roblox ID</span>
              <div><code><%= selectedMember.registration.robloxId || '-' %></code></div>
            </div>
          </div>
        <% } else { %>
          <p style="color: var(--text-muted);">Bu kullanıcı sunucuya henüz kayıt olmamış.</p>
        <% } %>
      </div>
    </div>
  </div>

  <!-- 3. Disiplin ve Uyarı Sicil Geçmişi -->
  <div class="card" style="margin-bottom: 2rem;">
    <div class="card-header">
      <h3 class="card-title"><span>⚖️</span> Disiplin & Uyarı Sicil Geçmişi</h3>
      <span class="badge badge-primary">
        Toplam <%= (selectedMember.warnings.history || []).length %> Sicil Kaydı
      </span>
    </div>
    <div class="card-body">
      <% if (!selectedMember.warnings.history || selectedMember.warnings.history.length === 0) { %>
        <p style="color: var(--text-muted); margin: 0;">Bu kullanıcının geçmişine ait herhangi bir disiplin cezası veya uyarısı bulunmamaktadır.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Tarih</th>
                <th>Ceza Türü</th>
                <th>Kural / Madde</th>
                <th>Gerekçe</th>
                <th>İşlemi Yapan</th>
                <th style="text-align: right;">Kanıt</th>
              </tr>
            </thead>
            <tbody>
              <% selectedMember.warnings.history.forEach(function(w) { %>
                <tr>
                  <td><code>#<%= w.id %></code></td>
                  <td style="font-size: 0.85rem; color: var(--text-muted); white-space: nowrap;">
                    <%= w.createdAt ? new Date(w.createdAt).toLocaleString('tr-TR') : '-' %>
                  </td>
                  <td>
                    <span class="badge <%= w.type === 'verbal' ? 'badge-warning' : 'badge-danger' %>">
                      <%= w.type === 'verbal' ? 'Sözlü' : 'Resmi' %>
                    </span>
                  </td>
                  <td>
                    <% if (w.ruleCode) { %>
                      <strong style="color: var(--color-danger);"><%= w.ruleCode %></strong>
                    <% } else { %>
                      -
                    <% } %>
                  </td>
                  <td style="max-width: 250px;">
                    <div style="font-size: 0.875rem; color: var(--text-primary);"><%= w.reason || w.reasonDisplay || '-' %></div>
                    <% if (w.actionTakenText) { %>
                      <div style="font-size: 0.775rem; color: var(--text-muted);"><%= w.actionTakenText %></div>
                    <% } %>
                  </td>
                  <td>
                    <span style="font-size: 0.85rem; color: var(--text-secondary);"><%= w.staffTag || w.staffId %></span>
                  </td>
                  <td style="text-align: right;">
                    <% if (w.proofUrl || w.evidenceUrl) { %>
                      <a href="<%= w.proofUrl || w.evidenceUrl %>" target="_blank" rel="noopener" class="btn btn-secondary btn-sm" style="padding: 2px 8px;">
                        Görsel
                      </a>
                    <% } else { %>
                      <span style="color: var(--text-muted); font-size: 0.8rem;">Yok</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- 4. Tryout Değerlendirme Form Geçmişi -->
  <div class="card">
    <div class="card-header">
      <h3 class="card-title"><span>📋</span> Tryout Değerlendirme Form Geçmişi</h3>
      <span class="badge badge-info">
        <%= (selectedMember.tryout.forms || []).length %> Form
      </span>
    </div>
    <div class="card-body">
      <% if (!selectedMember.tryout.forms || selectedMember.tryout.forms.length === 0) { %>
        <p style="color: var(--text-muted); margin: 0;">Bu kullanıcı için henüz tryout değerlendirme formu doldurulmamış.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Form Kodu</th>
                <th>Tarih</th>
                <th>Eski Seviye</th>
                <th>Yeni Seviye</th>
                <th>Değerlendiren</th>
                <th>Durum</th>
              </tr>
            </thead>
            <tbody>
              <% selectedMember.tryout.forms.forEach(function(f) { %>
                <tr>
                  <td><code><%= f.formCode %></code></td>
                  <td style="font-size: 0.85rem; color: var(--text-muted);">
                    <%= f.createdAt ? new Date(f.createdAt).toLocaleDateString('tr-TR') : '-' %>
                  </td>
                  <td><%= f.previousLevel %></td>
                  <td><strong style="color: var(--color-primary);"><%= f.newLevel %></strong></td>
                  <td style="font-size: 0.85rem;">Yetkili: <%= f.staffId %></td>
                  <td>
                    <% if (f.cancelled) { %>
                      <span class="badge badge-danger">İptal Edildi</span>
                    <% } else { %>
                      <span class="badge badge-success">Geçerli</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

<!-- MOD 2: ÜYE ARAMA VE LİSTELEME -->
<% } else { %>
  <!-- Arama Formu -->
  <div class="card" style="margin-bottom: 2rem;">
    <form action="/yonetim/uyeler" method="GET" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
      <div style="flex: 1; min-width: 250px;">
        <input
          type="text"
          name="query"
          class="form-control"
          placeholder="İsim, Discord kullanıcı adı, Roblox nicki veya ID ile ara..."
          value="<%= query || '' %>"
        />
      </div>
      <button type="submit" class="btn btn-primary">
        <span>🔍 Üye Ara</span>
      </button>
      <% if (query) { %>
        <a href="/yonetim/uyeler" class="btn btn-secondary">
          <span>Temizle</span>
        </a>
      <% } %>
    </form>
  </div>

  <!-- Arama Sonuçları Listesi -->
  <% if (!members || members.length === 0) { %>
    <div class="card" style="text-align: center; padding: 3rem 1.5rem;">
      <div style="font-size: 3rem; margin-bottom: 1rem;">🔍</div>
      <h3>Aradığınız kriterlere uygun üye bulunamadı</h3>
      <p style="color: var(--text-muted); max-width: 480px; margin: 0 auto;">
        Lütfen farklı bir Discord kullanıcı adı, ID veya Roblox nicki girerek tekrar deneyiniz.
      </p>
    </div>
  <% } else { %>
    <div class="card" style="padding: 0;">
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Üye</th>
              <th>Roblox Hesabı</th>
              <th>Yetki Seviyesi</th>
              <th>Ceza Puanı</th>
              <th style="text-align: right;">İşlemler</th>
            </tr>
          </thead>
          <tbody>
            <% members.forEach(function(m) { %>
              <tr>
                <td>
                  <div style="display: flex; align-items: center; gap: 10px;">
                    <img
                      src="<%= m.avatarUrl || 'https://cdn.discordapp.com/embed/avatars/0.png' %>"
                      alt="<%= m.displayName %>"
                      style="width: 36px; height: 36px; border-radius: 50%;"
                    />
                    <div>
                      <strong style="color: var(--text-primary); font-size: 0.95rem;"><%= m.displayName %></strong>
                      <div style="font-size: 0.8rem; color: var(--text-muted);">@<%= m.username %> • ID: <%= m.id %></div>
                    </div>
                  </div>
                </td>
                <td>
                  <% if (m.registration && m.registration.registered) { %>
                    <strong style="color: var(--color-primary); font-size: 0.9rem;">@<%= m.registration.robloxUsername %></strong>
                    <div style="font-size: 0.775rem; color: var(--text-muted);"><%= m.registration.realName %></div>
                  <% } else { %>
                    <span style="color: var(--text-muted); font-size: 0.85rem;">Kayıtsız</span>
                  <% } %>
                </td>
                <td>
                  <% if (m.level === 'developer') { %>
                    <span class="badge badge-danger">Developer</span>
                  <% } else if (m.level === 'yonetmenlik') { %>
                    <span class="badge badge-warning">Yönetmenlik</span>
                  <% } else { %>
                    <span class="badge badge-success">Üye</span>
                  <% } %>
                </td>
                <td>
                  <% if (m.warnings && m.warnings.points > 0) { %>
                    <span class="badge badge-danger"><%= m.warnings.points %> Puan</span>
                  <% } else { %>
                    <span class="badge badge-success">Temiz</span>
                  <% } %>
                </td>
                <td style="text-align: right; white-space: nowrap;">
                  <a href="/yonetim/uyeler/<%= m.id %>" class="btn btn-secondary btn-sm">
                    <span>Detay / Sicil</span>
                  </a>
                  <a href="/yonetim/uyari?targetUserId=<%= m.id %>" class="btn btn-danger btn-sm">
                    <span>Ceza Ver</span>
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
<% } %>

<%- include('../layouts/footer') %>
