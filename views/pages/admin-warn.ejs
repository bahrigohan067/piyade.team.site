<%- include('../layouts/header') %>

<div style="max-width: 880px; margin: 0 auto; padding-top: 1rem;">
  
  <div style="margin-bottom: 2.5rem;">
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 0.5rem;">
      <span class="badge badge-warning"><%= t('adminWarn.badgeTop') %></span>
      <span class="badge badge-neutral"><%= t('adminWarn.badgeSync') %></span>
    </div>
    <h1 style="font-size: 2.2rem; margin-bottom: 0.5rem;"><%= t('adminWarn.heading') %></h1>
    <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6;">
      <%= t('adminWarn.subheading') %>
    </p>
  </div>

  <!-- İşlem Sonucu Başarı Kartı -->
  <% if (typeof result !== 'undefined' && result && result.success) { %>
    <div class="glass-card" style="border-left: 4px solid var(--color-success); margin-bottom: 2rem; background: rgba(16, 185, 129, 0.08);">
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 1rem;">
        <span style="font-size: 2rem;">✅</span>
        <div>
          <span class="badge badge-success"><%= t('adminWarn.successBadge') %></span>
          <h2 style="font-size: 1.4rem; margin: 4px 0 0; color: #ffffff;"><%= t('adminWarn.successTitlePrefix') %><%= result.warnId %><%= t('adminWarn.successTitleSuffix') %></h2>
        </div>
      </div>

      <div class="glass-card" style="padding: 1.25rem; margin-bottom: 1rem; background: rgba(8, 9, 13, 0.75);">
        <div class="grid grid-2" style="gap: 1rem;">
          <div>
            <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;"><%= t('adminWarn.labelTargetId') %></span>
            <div style="font-weight: 700; color: #ffffff;"><code><%= result.targetUserId %></code></div>
          </div>
          <div>
            <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;"><%= t('adminWarn.labelPenaltyType') %></span>
            <div style="font-weight: 700; color: #60a5fa; text-transform: uppercase;"><%= result.type === 'verbal' ? t('adminWarn.typeVerbalLabel') : t('adminWarn.typeOfficialLabel') %></div>
          </div>
          <% if (result.ruleCode) { %>
            <div>
              <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;"><%= t('adminWarn.labelViolatedRule') %></span>
              <div style="font-weight: 700; color: var(--color-danger);"><%= result.ruleCode %> — <%= result.ruleDescription %></div>
            </div>
          <% } %>
          <div>
            <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;"><%= t('adminWarn.labelActionTaken') %></span>
            <div style="font-weight: 700; color: #ffffff;"><%= result.actionTaken || '-' %></div>
          </div>
          <% if (result.newStats) { %>
            <div>
              <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;"><%= t('adminWarn.labelNewTotalPoints') %></span>
              <div style="font-weight: 800; color: var(--color-danger); font-size: 1.2rem;"><%= result.newStats.points || 0 %> <%= t('profile.pointsWord') %></div>
            </div>
            <div>
              <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;"><%= t('adminWarn.labelWarnTier') %></span>
              <div style="font-weight: 700; color: var(--color-warning);"><%= t('profile.warningTierPrefix') %><%= result.newStats.tier || 0 %></div>
            </div>
          <% } %>
        </div>
      </div>

      <% if (result.evidenceUrl) { %>
        <div style="font-size: 0.875rem; color: var(--text-secondary);">
          📎 <strong><%= t('adminWarn.attachedProofLabel') %></strong> <a href="<%= result.evidenceUrl %>" target="_blank" rel="noopener"><%= t('adminWarn.openProofNewTab') %></a>
        </div>
      <% } %>
    </div>
  <% } %>

  <!-- Hiyerarşi veya Kural Hata Bildirimi (Sunucu + XHR istemci hataları) -->
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger" id="adminWarnErrorBanner" style="margin-bottom: 2rem;">
      <span style="font-size: 1.5rem;">🛑</span>
      <div>
        <strong><%= t('adminWarn.blockedTitle') %></strong>
        <p style="margin: 4px 0 0;" id="adminWarnErrorText"><%= error %></p>
      </div>
    </div>
  <% } else { %>
    <div class="alert alert-danger" id="adminWarnErrorBanner" style="margin-bottom: 2rem;" hidden>
      <span style="font-size: 1.5rem;">🛑</span>
      <div>
        <strong><%= t('adminWarn.blockedTitle') %></strong>
        <p style="margin: 4px 0 0;" id="adminWarnErrorText"></p>
      </div>
    </div>
  <% } %>

  <!-- Uyarı Verme Formu (Madde 6: Tekil Idempotency Anahtarı & Buton Kilitleme + Kanıt Dosyasında Orbital Loader) -->
  <div class="glass-card">
    <form
      id="adminWarnForm"
      action="/yonetim/uyari?_csrf=<%= encodeURIComponent(csrfToken) %>&_idempotencyKey=<%= encodeURIComponent(typeof idempotencyKey !== 'undefined' ? idempotencyKey : '') %>"
      method="POST"
      enctype="multipart/form-data"
      data-prevent-double-submit="true"
      data-orbital-loader="true"
      data-confirm="<%= t('adminWarn.confirmWarn') %>"
      data-loader-config="<%= typeof nexusConfig !== 'undefined' && nexusConfig ? JSON.stringify(nexusConfig.orbitalLoader) : '{}' %>"
      data-loader-i18n="<%= JSON.stringify({
        uploading: t('adminWarn.loaderUploading'),
        forwarding: t('adminWarn.loaderForwarding'),
        success: t('adminWarn.loaderSuccess'),
        errorTitle: t('adminWarn.loaderErrorTitle'),
        timeoutError: t('adminWarn.loaderTimeoutErr'),
        networkError: t('adminWarn.loaderNetworkErr'),
        fileTooLarge: t('errors.fileTooLarge'),
        closeBtn: t('adminWarn.loaderCloseBtn')
      }) %>"
    >
      <!-- CSRF Güvenlik Anahtarı -->
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <!-- Tekil Idempotency Anahtarı (Çift Gönderimi Engeller) -->
      <input type="hidden" name="_idempotencyKey" value="<%= typeof idempotencyKey !== 'undefined' ? idempotencyKey : '' %>" />

      <!-- 1. Üye Seçimi (Arama Destekli) -->
      <div class="form-group" style="position: relative;">
        <label class="form-label" for="warnMemberSearch"><%= t('adminWarn.labelSelectMember') %></label>
        <input
          type="text"
          id="warnMemberSearch"
          class="form-control"
          placeholder="<%= t('adminWarn.placeholderMemberSearch') %>"
          autocomplete="off"
          data-selected-label="<%= t('adminWarn.selectedPrefix') %>"
          value="<%= preselectedMember ? (preselectedMember.discord?.displayName + ' (' + preselectedMember.discord?.id + ')') : '' %>"
        />
        <input
          type="hidden"
          id="targetUserId"
          name="targetUserId"
          value="<%= targetId || (preselectedMember ? preselectedMember.discord?.id : '') %>"
          required
        />
        <div id="selectedMemberBadge">
          <% if (preselectedMember) { %>
            <div style="display: flex; align-items: center; gap: 8px; margin-top: 8px; padding: 6px 12px; background: rgba(59, 130, 246, 0.15); border-radius: var(--radius-sm); border: 1px solid rgba(59, 130, 246, 0.3);">
              <img src="<%= preselectedMember.discord?.avatarUrl %>" style="width: 24px; height: 24px; border-radius: 50%;" />
              <span><%= t('adminWarn.selectedPrefix') %> <strong><%= preselectedMember.discord?.displayName %></strong> (<code><%= preselectedMember.discord?.id %></code>)</span>
            </div>
          <% } %>
        </div>
        <!-- Canlı Arama Sonuç Listesi -->
        <div id="warnMemberResults" style="display: none; position: absolute; top: 100%; left: 0; right: 0; background: #0d0f17; border: 1px solid var(--border-color); border-radius: var(--radius-sm); max-height: 250px; overflow-y: auto; z-index: 100; box-shadow: var(--shadow-lg);"></div>
        <div class="form-text">
          ⚠️ <%= t('adminWarn.hierarchyNote') %>
        </div>
      </div>

      <!-- 2. Ceza Türü (Sözlü veya Resmi) -->
      <div class="form-group">
        <label class="form-label"><%= t('adminWarn.labelPenaltyType') %></label>
        <div style="display: flex; gap: 1.5rem; margin-top: 0.5rem; flex-wrap: wrap;">
          <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
            <input type="radio" name="type" value="official" checked />
            <strong style="color: var(--color-danger);"><%= t('adminWarn.radioOfficialTitle') %></strong>
            <span style="font-size: 0.85rem; color: var(--text-muted);"><%= t('adminWarn.radioOfficialSub') %></span>
          </label>
          <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
            <input type="radio" name="type" value="verbal" />
            <strong style="color: var(--color-warning);"><%= t('adminWarn.radioVerbalTitle') %></strong>
            <span style="font-size: 0.85rem; color: var(--text-muted);"><%= t('adminWarn.radioVerbalSub') %></span>
          </label>
        </div>
      </div>

      <!-- 3. Resmi Uyarı Kural Seçimi (Madde 11: data-rules güvenli escape edilmiştir) -->
      <div id="officialRuleFields" class="form-group">
        <label class="form-label" for="ruleCodeSelect"><%= t('adminWarn.labelRuleSelect') %></label>
        <select id="ruleCodeSelect" name="ruleCode" class="form-select" data-rules="<%= JSON.stringify(rules || {}) %>">
          <option value=""><%= t('adminWarn.placeholderRuleSelect') %></option>
          
          <optgroup label="<%= t('adminWarn.optgroupParticipant') %>">
            <% Object.values(rules || {}).filter(r => r.category === 'participant').forEach(function(r) { %>
              <option value="<%= r.code %>"><%= r.code %> — <%= r.title %> (<%= r.penaltyLabel %>)</option>
            <% }); %>
          </optgroup>

          <optgroup label="<%= t('adminWarn.optgroupOrder') %>">
            <% Object.values(rules || {}).filter(r => r.category === 'order').forEach(function(r) { %>
              <option value="<%= r.code %>"><%= r.code %> — <%= r.title %> (<%= r.penaltyLabel %>)</option>
            <% }); %>
          </optgroup>

          <optgroup label="<%= t('adminWarn.optgroupStaff') %>">
            <% Object.values(rules || {}).filter(r => r.category === 'staff').forEach(function(r) { %>
              <option value="<%= r.code %>"><%= r.code %> — <%= r.title %> (<%= r.penaltyLabel %>)</option>
            <% }); %>
          </optgroup>
        </select>

        <!-- Kural Seçim Önizleme Kutusu -->
        <div id="rulePreviewBox" style="display: none; margin-top: 0.75rem;"></div>
      </div>

      <!-- 4. Gerekçe / Sebep -->
      <div class="form-group" id="reasonGroup">
        <label class="form-label" for="warnReason"><%= t('adminWarn.labelReason') %></label>
        <textarea
          id="warnReason"
          name="reason"
          class="form-control"
          rows="3"
          placeholder="<%= t('adminWarn.placeholderReason') %>"
        ></textarea>
        <div class="form-text"><%= t('adminWarn.reasonHelp') %></div>
      </div>

      <!-- 5. Kanıt Görseli Yükleme (Bellekten Bot API'ye veya URL — Sadece PNG/JPG/WEBP, Maks 5 MB) -->
      <div class="form-group" style="background: rgba(8, 9, 13, 0.7); padding: 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
        <label class="form-label"><%= t('adminWarn.labelEvidenceSection') %></label>
        <div class="grid grid-2" style="gap: 1rem;">
          <div>
            <label class="form-label" style="font-size: 0.8rem; color: var(--text-muted);" for="evidenceFile"><%= t('adminWarn.labelUploadFile') %></label>
            <input type="file" id="evidenceFile" name="evidenceFile" class="form-control" accept="image/png,image/jpeg,image/webp" />
          </div>
          <div>
            <label class="form-label" style="font-size: 0.8rem; color: var(--text-muted);" for="evidenceUrlInput"><%= t('adminWarn.labelEvidenceUrl') %></label>
            <input
              type="url"
              id="evidenceUrlInput"
              name="evidenceUrlInput"
              class="form-control"
              placeholder="<%= t('adminWarn.placeholderEvidenceUrl') %>"
            />
          </div>
        </div>
        <div class="form-text"><%= t('adminWarn.evidenceHelp') %></div>
      </div>

      <!-- Gönder Butonu -->
      <div style="margin-top: 2rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
        <a href="/yonetim/uyeler" class="btn btn-secondary">
          <span><%= t('adminWarn.btnMemberList') %></span>
        </a>
        <button type="submit" class="btn btn-danger btn-lg" data-submitting-text="<%= t('adminWarn.btnSubmittingWarn') %>">
          <span><%= t('adminWarn.btnSubmitWarn') %></span>
        </button>
      </div>
    </form>
  </div>

  <!-- ========================================================================
       2. PANEL: SİTE (GOOGLE) ÜYELERİNE UYARI VERME VE SİCİL ÖNİZLEME
       (Mevcut Discord uyarı panelinden tamamen bağımsız; Y1–Y5 maddeleri yoktur)
       ======================================================================== -->
  <%
    const safeSiteRules = (typeof siteRules !== 'undefined' && siteRules) ? siteRules : {};
    const safeSiteIdem = typeof siteIdempotencyKey !== 'undefined' ? siteIdempotencyKey : '';
    const safeSiteTargetId = typeof siteTargetId !== 'undefined' ? siteTargetId : '';
    const safeSitePreselected = typeof sitePreselectedMember !== 'undefined' ? sitePreselectedMember : null;
    const safeSiteResult = typeof siteResult !== 'undefined' ? siteResult : null;
    const safeSiteError = typeof siteError !== 'undefined' ? siteError : null;
    const siteWarnClientI18n = {
      selectedPrefix: t('adminWarn.selectedPrefix'),
      clearSelection: t('siteWarn.clearSelection'),
      noMembersFound: t('siteWarn.noMembersFound'),
      siteMemberBadge: t('chat.identityBadgeSite'),
      pointsWord: t('profile.pointsWord'),
      statusActive: t('siteWarn.statusActive'),
      statusSuspended: t('siteWarn.statusSuspended'),
      statusBanned: t('siteWarn.statusBanned'),
      noActiveSanction: t('siteWarn.noActiveSanction'),
      sanctionPermanentBan: t('siteWarn.sanctionPermanentBan'),
      sanctionSuspended: t('siteWarn.sanctionSuspended'),
      sanctionChatMute: t('siteWarn.sanctionChatMute'),
      historyTitle: t('siteWarn.historyTitle'),
      refreshBtn: t('siteWarn.refreshBtn'),
      statTotalPoints: t('siteWarn.statTotalPoints'),
      statTier: t('siteWarn.statTier'),
      statStatus: t('siteWarn.statStatus'),
      statActiveSanction: t('siteWarn.statActiveSanction'),
      recentRecordsTitle: t('siteWarn.recentRecordsTitle'),
      noRecordsYet: t('siteWarn.noRecordsYet'),
      typeVerbal: t('adminWarn.typeVerbalLabel'),
      recordCancelledBadge: t('siteWarn.recordCancelledBadge'),
      recordPardonedBadge: t('siteWarn.recordPardonedBadge'),
      expiresShort: t('siteWarn.expiresShort'),
      cancelReasonPrefix: t('siteWarn.cancelReasonPrefix'),
      viewEvidenceFile: t('siteWarn.viewEvidenceFile'),
      viewEvidenceUrl: t('siteWarn.viewEvidenceUrl'),
      cancelBtn: t('siteWarn.cancelBtn'),
      loadingHistory: t('siteWarn.loadingHistory'),
      errSelectMember: t('siteWarn.errSelectMember'),
      errVerbalReason: t('adminWarn.errVerbalReason'),
      errSelectRule: t('adminWarn.errSelectRule'),
      errCancelReason: t('siteWarn.errCancelReason'),
      errGeneric: t('siteWarn.errGeneric'),
    };
  %>
  <section
    id="site-uyari-paneli"
    class="site-warn-section"
    aria-labelledby="siteWarnPanelHeading"
    data-site-warn-i18n="<%= JSON.stringify(siteWarnClientI18n) %>"
  >
    <div class="site-warn-header">
      <div class="site-warn-badges">
        <span class="badge badge-primary"><%= t('siteWarn.badgeTop') %></span>
        <span class="badge badge-neutral"><%= t('siteWarn.badgeRulesScope') %></span>
      </div>
      <h2 id="siteWarnPanelHeading" class="site-warn-heading"><%= t('siteWarn.panelHeading') %></h2>
      <p class="site-warn-subheading"><%= t('siteWarn.panelSubheading') %></p>
    </div>

    <% if (safeSiteResult && safeSiteResult.success) { %>
      <div class="glass-card site-warn-success-card" role="status">
        <div class="site-warn-success-head">
          <span class="site-warn-success-icon" aria-hidden="true">✅</span>
          <div>
            <span class="badge badge-success"><%= t('siteWarn.successBadge') %></span>
            <h3 class="site-warn-success-title">
              <%= safeSiteResult.action === 'cancelled'
                ? t('siteWarn.successCancelTitle')
                : t('siteWarn.successIssueTitle') %>
              (<code><%= safeSiteResult.warnId %></code>)
            </h3>
          </div>
        </div>
        <div class="site-warn-success-grid">
          <% if (safeSiteResult.memberDisplayName) { %>
            <div>
              <span class="site-warn-stat-label"><%= t('siteWarn.labelTargetMember') %></span>
              <div class="site-warn-stat-val"><%= safeSiteResult.memberDisplayName %> (<code><%= safeSiteResult.memberId %></code>)</div>
            </div>
          <% } %>
          <% if (safeSiteResult.ruleCode) { %>
            <div>
              <span class="site-warn-stat-label"><%= t('adminWarn.labelViolatedRule') %></span>
              <div class="site-warn-stat-val"><%= safeSiteResult.ruleCode %> — <%= safeSiteResult.ruleTitle %></div>
            </div>
          <% } %>
          <% if (safeSiteResult.sanctionLabel) { %>
            <div>
              <span class="site-warn-stat-label"><%= t('adminWarn.labelActionTaken') %></span>
              <div class="site-warn-stat-val"><%= safeSiteResult.sanctionLabel %></div>
            </div>
          <% } %>
          <div>
            <span class="site-warn-stat-label"><%= t('adminWarn.labelNewTotalPoints') %></span>
            <div class="site-warn-stat-val">
              <strong><%= safeSiteResult.totalPoints || 0 %> <%= t('profile.pointsWord') %></strong>
              (<%= safeSiteResult.tierLabel || '' %>)
            </div>
          </div>
        </div>
        <% if (safeSiteResult.evidenceFileUrl || safeSiteResult.evidenceUrl) { %>
          <div class="site-warn-success-proof">
            <% if (safeSiteResult.evidenceFileUrl) { %>
              <a href="<%= safeSiteResult.evidenceFileUrl %>" target="_blank" rel="noopener noreferrer" class="site-warn-evidence-link">
                📎 <%= t('siteWarn.viewEvidenceFile') %>
              </a>
            <% } %>
            <% if (safeSiteResult.evidenceUrl) { %>
              <a href="<%= safeSiteResult.evidenceUrl %>" target="_blank" rel="noopener noreferrer" class="site-warn-evidence-link">
                🔗 <%= t('siteWarn.viewEvidenceUrl') %>
              </a>
            <% } %>
          </div>
        <% } %>
      </div>
    <% } %>

    <div class="alert alert-danger site-warn-error-banner" id="siteWarnErrorBanner" <%= safeSiteError ? '' : 'hidden' %>>
      <span class="site-warn-error-icon" aria-hidden="true">🛑</span>
      <div>
        <strong><%= t('adminWarn.blockedTitle') %></strong>
        <p class="site-warn-error-text" id="siteWarnErrorText"><%= safeSiteError || '' %></p>
      </div>
    </div>

    <div class="glass-card site-warn-card">
      <form
        id="siteAdminWarnForm"
        action="/yonetim/site-uyari?_csrf=<%= encodeURIComponent(csrfToken) %>&_idempotencyKey=<%= encodeURIComponent(safeSiteIdem) %>"
        method="POST"
        enctype="multipart/form-data"
        data-prevent-double-submit="true"
        data-orbital-loader="true"
        data-error-banner-id="siteWarnErrorBanner"
        data-error-text-id="siteWarnErrorText"
        data-default-redirect="/yonetim/uyari#site-uyari-paneli"
        data-confirm="<%= t('siteWarn.confirmWarn') %>"
        data-loader-config="<%= typeof nexusConfig !== 'undefined' && nexusConfig ? JSON.stringify(nexusConfig.orbitalLoader) : '{}' %>"
        data-loader-i18n="<%= JSON.stringify({
          uploading: t('adminWarn.loaderUploading'),
          forwarding: t('siteWarn.loaderSaving'),
          success: t('siteWarn.loaderSuccess'),
          errorTitle: t('adminWarn.loaderErrorTitle'),
          timeoutError: t('adminWarn.loaderTimeoutErr'),
          networkError: t('adminWarn.loaderNetworkErr'),
          fileTooLarge: t('errors.fileTooLarge'),
          closeBtn: t('adminWarn.loaderCloseBtn')
        }) %>"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="_idempotencyKey" value="<%= safeSiteIdem %>" />

        <!-- 1. Google (Site) Üyesi Arama Seçici -->
        <div class="form-group site-warn-search-group">
          <label class="form-label" for="siteWarnMemberSearch"><%= t('siteWarn.labelSelectMember') %></label>
          <input
            type="text"
            id="siteWarnMemberSearch"
            class="form-control"
            placeholder="<%= t('siteWarn.placeholderMemberSearch') %>"
            autocomplete="off"
            value="<%= safeSitePreselected ? (safeSitePreselected.displayName + ' (' + safeSitePreselected.id + ')') : '' %>"
          />
          <input
            type="hidden"
            id="siteTargetMemberId"
            name="siteTargetMemberId"
            value="<%= safeSiteTargetId || (safeSitePreselected ? safeSitePreselected.id : '') %>"
            required
          />
          <div id="siteSelectedMemberBadge"></div>
          <div id="siteWarnMemberResults" class="site-warn-search-results" hidden></div>
          <div class="form-text"><%= t('siteWarn.memberPickerHelp') %></div>
        </div>

        <!-- Seçili Üyenin Altında Sicil Önizlemesi -->
        <div id="siteMemberHistoryBox" class="site-warn-history-slot" hidden></div>

        <!-- 2. Ceza Türü (Resmi / Sözlü) -->
        <div class="form-group">
          <label class="form-label"><%= t('adminWarn.labelPenaltyType') %></label>
          <div class="site-warn-radio-row">
            <label class="site-warn-radio-option">
              <input type="radio" name="siteWarnType" value="official" checked />
              <strong class="site-warn-radio-danger"><%= t('adminWarn.radioOfficialTitle') %></strong>
              <span class="site-warn-radio-sub"><%= t('siteWarn.radioOfficialSub') %></span>
            </label>
            <label class="site-warn-radio-option">
              <input type="radio" name="siteWarnType" value="verbal" />
              <strong class="site-warn-radio-warning"><%= t('adminWarn.radioVerbalTitle') %></strong>
              <span class="site-warn-radio-sub"><%= t('adminWarn.radioVerbalSub') %></span>
            </label>
          </div>
        </div>

        <!-- 3. Kural Maddesi (Yalnızca M1–M13 ve D1–D3; Y1–Y5 YOKTUR) -->
        <div id="siteOfficialRuleFields" class="form-group">
          <label class="form-label" for="siteRuleCodeSelect"><%= t('adminWarn.labelRuleSelect') %></label>
          <select id="siteRuleCodeSelect" name="siteRuleCode" class="form-select" data-rules="<%= JSON.stringify(safeSiteRules) %>">
            <option value=""><%= t('adminWarn.placeholderRuleSelect') %></option>

            <optgroup label="<%= t('adminWarn.optgroupParticipant') %>">
              <% Object.values(safeSiteRules).filter(r => r.category === 'participant').forEach(function(r) { %>
                <option value="<%= r.code %>"><%= r.code %> — <%= r.title %> (<%= r.sitePenaltyLabel %>)</option>
              <% }); %>
            </optgroup>

            <optgroup label="<%= t('adminWarn.optgroupOrder') %>">
              <% Object.values(safeSiteRules).filter(r => r.category === 'order').forEach(function(r) { %>
                <option value="<%= r.code %>"><%= r.code %> — <%= r.title %> (<%= r.sitePenaltyLabel %>)</option>
              <% }); %>
            </optgroup>
          </select>
          <div id="siteRulePreviewBox" hidden></div>
        </div>

        <!-- 4. Gerekçe -->
        <div class="form-group">
          <label class="form-label" for="siteWarnReason">
            <%= t('adminWarn.labelReason') %>
            <span id="siteReasonRequiredMark" class="site-warn-required-mark" hidden>(<%= t('siteWarn.requiredLabel') %>)</span>
          </label>
          <textarea
            id="siteWarnReason"
            name="siteWarnReason"
            class="form-control"
            rows="3"
            maxlength="600"
            placeholder="<%= t('siteWarn.placeholderReason') %>"
          ></textarea>
          <div class="form-text"><%= t('siteWarn.reasonHelp') %></div>
        </div>

        <!-- 5. Kanıt (Yalnızca Yetkililere Özel; Üyeye Gösterilmez) -->
        <div class="form-group site-warn-evidence-box">
          <label class="form-label"><%= t('adminWarn.labelEvidenceSection') %></label>
          <div class="grid grid-2 site-warn-evidence-grid">
            <div>
              <label class="form-label site-warn-evidence-sublabel" for="siteEvidenceFile"><%= t('adminWarn.labelUploadFile') %></label>
              <input type="file" id="siteEvidenceFile" name="evidenceFile" class="form-control" accept="image/png,image/jpeg,image/webp" />
            </div>
            <div>
              <label class="form-label site-warn-evidence-sublabel" for="siteEvidenceUrlInput"><%= t('adminWarn.labelEvidenceUrl') %></label>
              <input
                type="url"
                id="siteEvidenceUrlInput"
                name="siteEvidenceUrlInput"
                class="form-control"
                placeholder="<%= t('adminWarn.placeholderEvidenceUrl') %>"
              />
            </div>
          </div>
          <div class="form-text"><%= t('siteWarn.evidenceHelp') %></div>
        </div>

        <!-- Gönder -->
        <div class="site-warn-submit-row">
          <span class="site-warn-audit-hint">🔒 <%= t('siteWarn.auditHint') %></span>
          <button type="submit" class="btn btn-danger btn-lg" data-submitting-text="<%= t('adminWarn.btnSubmittingWarn') %>">
            <span><%= t('siteWarn.btnSubmitSiteWarn') %></span>
          </button>
        </div>
      </form>
    </div>
  </section>
</div>

<!-- İptal Et Onay ve Gerekçe Modalı (Site Üyesi Uyarısı İçin) -->
<div class="chat-modal-backdrop" id="siteWarnCancelModal" hidden aria-hidden="true">
  <div class="chat-modal-card chat-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="siteWarnCancelTitle">
    <div class="chat-modal-header">
      <h3 id="siteWarnCancelTitle" class="chat-modal-title">
        ↩️ <%= t('siteWarn.cancelModalTitle') %> (<code id="siteWarnCancelIdLabel"></code>)
      </h3>
      <button type="button" class="chat-icon-btn" id="siteWarnCancelCloseBtn" aria-label="<%= t('chat.closeBtn') %>">✕</button>
    </div>
    <form id="siteWarnCancelForm" class="chat-modal-body" novalidate>
      <p class="site-warn-cancel-desc"><%= t('siteWarn.cancelModalDesc') %></p>
      <div class="form-group">
        <label class="form-label" for="siteWarnCancelReasonInput"><%= t('siteWarn.cancelReasonLabel') %></label>
        <textarea
          id="siteWarnCancelReasonInput"
          class="form-control"
          rows="3"
          maxlength="400"
          required
          placeholder="<%= t('siteWarn.cancelReasonPlaceholder') %>"
        ></textarea>
      </div>
      <div id="siteWarnCancelError" class="chat-inline-error" role="alert" hidden></div>
      <div class="chat-modal-footer site-warn-cancel-footer">
        <button type="button" class="btn btn-secondary btn-sm" id="siteWarnCancelDismissBtn"><%= t('chat.cancelBtn') %></button>
        <button type="submit" class="btn btn-danger btn-sm" id="siteWarnCancelSubmitBtn">↩️ <%= t('siteWarn.cancelConfirmBtn') %></button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/orbital-loader') %>

<%- include('../layouts/footer') %>
