<%- include('../layouts/header') %>

<div style="max-width: 860px; margin: 0 auto;">
  <div style="margin-bottom: 2rem;">
    <span class="badge badge-warning">Yönetim & Disiplin</span>
    <h1 style="margin-top: 0.5rem; margin-bottom: 0.5rem;">⚠️ Üyeye Uyarı / Ceza Uygula</h1>
    <p style="color: var(--text-secondary);">
      Sunucu düzeni ve kuralları ihlal eden üyelere Sözlü veya Resmi disiplin işlemi uygular. Bot REST API'si hiyerarşi ve yaptırım kurallarını denetler.
    </p>
  </div>

  <!-- İşlem Sonucu Başarı Kartı -->
  <% if (typeof result !== 'undefined' && result && result.success) { %>
    <div class="card" style="border-left: 4px solid var(--color-success); margin-bottom: 2rem; background: rgba(16, 185, 129, 0.05);">
      <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 0.75rem;">
        <span style="font-size: 2rem;">✅</span>
        <div>
          <span class="badge badge-success">Ceza Başarıyla Uygulandı</span>
          <h2 style="font-size: 1.4rem; margin: 2px 0 0;">Uyarı Kaydı #<%= result.warnId %> Oluşturuldu</h2>
        </div>
      </div>

      <div style="background: var(--bg-surface); padding: 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color); margin-bottom: 1rem;">
        <div class="grid grid-2" style="gap: 1rem;">
          <div>
            <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Hedef Üye Discord ID</span>
            <div style="font-weight: 700; color: var(--text-primary);"><code><%= result.targetUserId %></code></div>
          </div>
          <div>
            <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Ceza Türü</span>
            <div style="font-weight: 700; color: var(--color-primary); text-transform: uppercase;"><%= result.type === 'verbal' ? '🗣️ Sözlü İhtar' : '⚠️ Resmi Uyarı' %></div>
          </div>
          <% if (result.ruleCode) { %>
            <div>
              <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">İhlal Kuralı</span>
              <div style="font-weight: 700; color: var(--color-danger);"><%= result.ruleCode %> — <%= result.ruleDescription %></div>
            </div>
          <% } %>
          <div>
            <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Uygulanan Yaptırım</span>
            <div style="font-weight: 700; color: var(--text-primary);"><%= result.actionTaken %></div>
          </div>
          <% if (result.newStats) { %>
            <div>
              <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Yeni Toplam Puan</span>
              <div style="font-weight: 800; color: var(--color-danger); font-size: 1.2rem;"><%= result.newStats.points || 0 %> Puan</div>
            </div>
            <div>
              <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Uyarı Kademesi</span>
              <div style="font-weight: 700; color: var(--color-warning);">Uyarı <%= result.newStats.tier || 0 %></div>
            </div>
          <% } %>
        </div>
      </div>

      <% if (result.evidenceUrl) { %>
        <div style="font-size: 0.875rem; color: var(--text-secondary);">
          📎 <strong>Eklenen Kanıt Görseli:</strong> <a href="<%= result.evidenceUrl %>" target="_blank" rel="noopener">Görseli Yeni Sekmede Aç</a>
        </div>
      <% } %>
    </div>
  <% } %>

  <!-- Hiyerarşi veya Kural Hata Bildirimi -->
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger" style="margin-bottom: 2rem;">
      <span style="font-size: 1.5rem;">🛑</span>
      <div>
        <strong>İşlem Engellendi:</strong>
        <p style="margin: 4px 0 0;"><%= error %></p>
      </div>
    </div>
  <% } %>

  <!-- Uyarı Verme Formu -->
  <div class="card">
    <form action="/yonetim/uyari" method="POST" enctype="multipart/form-data">
      <!-- CSRF Güvenlik Anahtarı -->
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <!-- 1. Üye Seçimi (Arama Destekli) -->
      <div class="form-group" style="position: relative;">
        <label class="form-label" for="warnMemberSearch">Ceza Verilecek Üye</label>
        <input
          type="text"
          id="warnMemberSearch"
          class="form-control"
          placeholder="İsim, Discord kullanıcı adı, Roblox nicki veya ID yazın..."
          autocomplete="off"
          value="<%= preselectedMember ? (preselectedMember.discord?.displayName + ' (' + preselectedMember.discord?.id + ')') : '' %>"
        />
        <input
          type="hidden"
          id="targetUserId"
          name="targetUserId"
          value="<%= targetId || (preselectedMember ? preselectedMember.discord?.id : '') %>"
          required
        />
        <div id="selectedMemberBadge">
          <% if (preselectedMember) { %>
            <div style="display: flex; align-items: center; gap: 8px; margin-top: 8px; padding: 6px 12px; background: var(--bg-card-hover); border-radius: var(--radius-sm); border: 1px solid var(--border-light);">
              <img src="<%= preselectedMember.discord?.avatarUrl %>" style="width: 24px; height: 24px; border-radius: 50%;" />
              <span>Seçilen: <strong><%= preselectedMember.discord?.displayName %></strong> (<code><%= preselectedMember.discord?.id %></code>)</span>
            </div>
          <% } %>
        </div>
        <!-- Canlı Arama Sonuç Listesi -->
        <div id="warnMemberResults" style="display: none; position: absolute; top: 100%; left: 0; right: 0; background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-sm); max-height: 250px; overflow-y: auto; z-index: 100; box-shadow: var(--shadow-lg);"></div>
        <div class="form-text">
          ⚠️ <strong>Hiyerarşi Koruması:</strong> Kendinize veya sizinle aynı/üst düzeydeki yetkililere ceza uygulayamazsınız.
        </div>
      </div>

      <!-- 2. Ceza Türü (Sözlü veya Resmi) -->
      <div class="form-group">
        <label class="form-label">Ceza Türü</label>
        <div style="display: flex; gap: 1.5rem; margin-top: 0.5rem;">
          <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
            <input type="radio" name="type" value="official" checked />
            <strong style="color: var(--color-danger);">⚠️ Resmi Uyarı</strong>
            <span style="font-size: 0.85rem; color: var(--text-muted);">(Puanlı, M/D/Y Kural Kodlu)</span>
          </label>
          <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
            <input type="radio" name="type" value="verbal" />
            <strong style="color: var(--color-warning);">🗣️ Sözlü Uyarı</strong>
            <span style="font-size: 0.85rem; color: var(--text-muted);">(0 Puan, Sicil Kaydı)</span>
          </label>
        </div>
      </div>

      <!-- 3. Resmi Uyarı Kural Seçimi -->
      <div id="officialRuleFields" class="form-group">
        <label class="form-label" for="ruleCodeSelect">İhlal Edilen Kural Maddesi</label>
        <select id="ruleCodeSelect" name="ruleCode" class="form-select">
          <option value="">Kural maddesi seçiniz...</option>
          
          <optgroup label="🛡️ Katılımcı Kuralları (M1 - M13)">
            <option value="M1">M1 — Küfür / Hakaret (+2 Puan)</option>
            <option value="M2">M2 — Reklam & Ticari Faaliyet (Kalıcı Ban)</option>
            <option value="M3">M3 — Aşırı Övünme (+1 Puan)</option>
            <option value="M4">M4 — Taciz (2 Gün Timeout)</option>
            <option value="M5">M5 — Kanal Amacı Dışında Kullanım (+3 Puan)</option>
            <option value="M6">M6 — Cinsel İçerik (+8 Puan)</option>
            <option value="M7">M7 — Kavga Ortamı Yaratma (+4 Puan)</option>
            <option value="M8">M8 — Zorbalık & Soğutma (+5 Puan)</option>
            <option value="M9">M9 — Başka Sunucuya Davet (Doğrudan Yasaklı)</option>
            <option value="M10">M10 — +18 & Ayrımcılık (1 Gün Timeout)</option>
            <option value="M11">M11 — Irkçılık (1 Gün Timeout)</option>
            <option value="M12">M12 — Küçümseme & Dalga Geçme (+2 Puan)</option>
            <option value="M13">M13 — 3. Taraf Yazılım / Hile (1 Gün Timeout)</option>
          </optgroup>

          <optgroup label="📢 Düzen & Kanal Kuralları (D1 - D3)">
            <option value="D1">D1 — Önemli Kanallara Boş Mesaj (+3 Puan)</option>
            <option value="D2">D2 — Sohbet & Ses Paneli Spamı (+3 Puan)</option>
            <option value="D3">D3 — Ses Kanalında Bildirim Yağmuru (+3 Puan)</option>
          </optgroup>

          <optgroup label="⚖️ Yetkili Kuralları (Y1 - Y5)">
            <option value="Y1">Y1 — Yetkiyi Kendi Lehine Kullanmak (Tüm Yetkiler Alınır)</option>
            <option value="Y2">Y2 — Katılımcıyı Yanlış Yönlendirmek (+1 Yetkili Uyarısı)</option>
            <option value="Y3">Y3 — Yanlış İşlem Yapmak (+1 Yetkili Uyarısı)</option>
            <option value="Y4">Y4 — Kendini Üstün Görmek (+1 Yetkili Uyarısı)</option>
            <option value="Y5">Y5 — Üst Kademe Yönlendirmesini Dinlememek (+1 Yetkili Uyarısı)</option>
          </optgroup>
        </select>

        <!-- Kural Seçim Önizleme Kutusu -->
        <div id="rulePreviewBox" style="display: none;"></div>
      </div>

      <!-- 4. Gerekçe / Sebep -->
      <div class="form-group" id="reasonGroup">
        <label class="form-label" for="warnReason">Ceza Gerekçesi / Açıklama</label>
        <textarea
          id="warnReason"
          name="reason"
          class="form-control"
          rows="3"
          placeholder="İhlal hakkında detaylı açıklama giriniz..."
        ></textarea>
        <div class="form-text">Sözlü uyarılarda gerekçe zorunludur. Resmi uyarılarda girilirse kural açıklamasına eklenir.</div>
      </div>

      <!-- 5. Kanıt Görseli Yükleme (Dosya veya Link) -->
      <div class="form-group" style="background: var(--bg-surface); padding: 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
        <label class="form-label">📎 Kanıt Görseli (Opsiyonel)</label>
        <div class="grid grid-2" style="gap: 1rem;">
          <div>
            <label class="form-label" style="font-size: 0.8rem; color: var(--text-muted);" for="evidenceFile">Bilgisayardan Dosya Yükle</label>
            <input type="file" id="evidenceFile" name="evidenceFile" class="form-control" accept="image/*" />
          </div>
          <div>
            <label class="form-label" style="font-size: 0.8rem; color: var(--text-muted);" for="evidenceUrlInput">Veya Görsel Bağlantısı (URL)</label>
            <input
              type="url"
              id="evidenceUrlInput"
              name="evidenceUrlInput"
              class="form-control"
              placeholder="https://i.imgur.com/... veya Discord cdn linki"
            />
          </div>
        </div>
        <div class="form-text">Yüklenen görsel uyarı log kanalındaki bildirim kartına doğrudan kanıt olarak iliştirilir.</div>
      </div>

      <!-- Gönder Butonu -->
      <div style="margin-top: 2rem; display: flex; align-items: center; justify-content: space-between;">
        <a href="/yonetim/uyeler" class="btn btn-secondary">
          <span>👥 Üye Listesine Git</span>
        </a>
        <button type="submit" class="btn btn-danger btn-lg" onclick="return confirm('Bu üyeye disiplin cezası uygulamak istediğinize emin misiniz? İşlem Discord sunucusunda anında geçerli olacaktır.');">
          <span>⚠️ Cezayı Uygula</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Kural Listesi İstemci Sözlüğü -->
<script>
  window.SERVER_RULES = <%- JSON.stringify(rules) %>;
</script>

<%- include('../layouts/footer') %>
