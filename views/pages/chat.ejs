<%- include('../layouts/header') %>

<%
  const chatBootstrap = {
    needsConsent: Boolean(needsConsent),
    policyVersion: String(policyVersion || '3.0'),
    activeSanction: typeof activeSanction !== 'undefined' ? activeSanction : null,
    unreadNotices: typeof unreadNotices !== 'undefined' && Array.isArray(unreadNotices) ? unreadNotices : [],
    csrfToken: typeof csrfToken !== 'undefined' ? csrfToken : '',
    lang: typeof lang !== 'undefined' ? lang : 'tr',
    selfId: currentUser ? String(currentUser.id) : '',
    selfKind: chatProfile && chatProfile.kind ? chatProfile.kind : (currentUser && currentUser.kind === 'google' ? 'google' : 'discord'),
    selfName: chatProfile ? chatProfile.displayName : (currentUser ? currentUser.displayName : ''),
    selfAvatarUrl: chatProfile ? chatProfile.avatarUrl : (currentUser ? currentUser.avatarUrl : ''),
    isGroupAdmin: Boolean(typeof isGroupAdmin !== 'undefined' && isGroupAdmin),
    isFreshDeveloper: Boolean(typeof isFreshDeveloper !== 'undefined' && isFreshDeveloper),
    groups: typeof chatGroups !== 'undefined' && Array.isArray(chatGroups) ? chatGroups : [],
    defaultGroupId: typeof defaultGroupId !== 'undefined' ? defaultGroupId : 'genel',
    brandIconUrl: typeof brandIconUrl !== 'undefined' ? brandIconUrl : '/img/brand/icon-192.png?v=1',
    profile: chatProfile || {},
    ringCategories: Array.isArray(ringCategories) ? ringCategories : [],
    ringPresets: Array.isArray(ringPresets) ? ringPresets : [],
    retentionInfo: retentionInfo || { retentionDays: 30, nextCleanupAt: Date.now() },
    requestedOtherId: requestedOtherId || '',
    limits: chatLimits || { maxMessageLength: 4000, maxGroupMessagesPerMin: 12, maxAnimatedDirectoryRings: 12, retentionDays: 30 },
    i18n: {
      searchPlaceholder: t('chat.searchPlaceholder'),
      searchResultsTitle: t('chat.searchResultsTitle'),
      groupsSectionTitle: t('chat.groupsSectionTitle'),
      conversationsTitle: t('chat.conversationsTitle'),
      noConversationsTitle: t('chat.noConversationsTitle'),
      noConversationsDesc: t('chat.noConversationsDesc'),
      noDirectoryResults: t('chat.noDirectoryResults'),
      directoryError: t('chat.directoryError'),
      retryBtn: t('chat.retryBtn'),
      emptyThreadTitle: t('chat.emptyThreadTitle'),
      emptyThreadDesc: t('chat.emptyThreadDesc'),
      retentionTooltipTitle: t('chat.retentionTooltipTitle'),
      retentionTooltipDesc: t('chat.retentionTooltipDesc'),
      expiresInDays: t('chat.expiresInDays'),
      expiresToday: t('chat.expiresToday'),
      robloxLabel: t('chat.robloxLabel'),
      typingIndicator: t('chat.typingIndicator'),
      blockUser: t('chat.blockUser'),
      unblockUser: t('chat.unblockUser'),
      blockedBannerMe: t('chat.blockedBannerMe'),
      blockedBannerOther: t('chat.blockedBannerOther'),
      closedDmBanner: t('chat.closedDmBanner'),
      deleteMsgBtn: t('chat.deleteMsgBtn'),
      deleteConfirm: t('chat.deleteConfirm'),
      adminDeleteConfirm: t('chat.adminDeleteConfirm'),
      blockConfirm: t('chat.blockConfirm'),
      msgDeleted: t('chat.msgDeleted'),
      msgModRemoved: t('chat.msgModRemoved'),
      msgAdminRemoved: t('chat.msgAdminRemoved'),
      groupMuteBtn: t('chat.groupMuteBtn'),
      groupUnmuteBtn: t('chat.groupUnmuteBtn'),
      groupMutedBadge: t('chat.groupMutedBadge'),
      groupPinnedHint: t('chat.groupPinnedHint'),
      groupEmptyMsg: t('chat.groupEmptyMsg'),
      groupAdminBadge: t('chat.groupAdminBadge'),
      groupAdminBadgeFull: t('chat.groupAdminBadgeFull'),
      jumpToBottom: t('chat.jumpToBottom'),
      msgMenuBtn: t('chat.msgMenuBtn'),
      outboxSending: t('chat.outboxSending'),
      outboxFailed: t('chat.outboxFailed'),
      outboxRetry: t('chat.outboxRetry'),
      outboxDelete: t('chat.outboxDelete'),
      uploadPaused: t('chat.uploadPaused'),
      uploadRetry: t('chat.uploadRetry'),
      uploadRetryReady: t('chat.uploadRetryReady'),
      offlineReconnecting: t('chat.offlineReconnecting'),
      offlineWaitingTitle: t('chat.offlineWaitingTitle'),
      offlineWaitingDesc: t('chat.offlineWaitingDesc'),
      offlineQueuedCount: t('chat.offlineQueuedCount'),
      offlineConnected: t('chat.offlineConnected'),
      devDiagCodes: {
        MATCH: t('chat.devDiagCodeMatch'),
        ENV_EMPTY: t('chat.devDiagCodeEnvEmpty'),
        ENV_PARSE_EMPTY: t('chat.devDiagCodeEnvParseEmpty'),
        NOT_IN_LIST: t('chat.devDiagCodeNotInList'),
        NOT_DISCORD_SESSION: t('chat.devDiagCodeNotDiscord'),
      },
      identityBadgeSite: t('chat.identityBadgeSite'),
      identityBadgeDiscord: t('chat.identityBadgeDiscord'),
      profileCardLoading: t('chat.profileCardLoading'),
      profileCardGamesTitle: t('chat.profileCardGamesTitle'),
      profileCardGamesHidden: t('chat.profileCardGamesHidden'),
      profileCardNoGames: t('chat.profileCardNoGames'),
      profileCardCopyBtn: t('chat.profileCardCopyBtn'),
      profileCardCopiedToast: t('chat.profileCardCopiedToast'),
      profileCardRobloxLink: t('chat.profileCardRobloxLink'),
      profileCardMessageBtn: t('chat.profileCardMessageBtn'),
      profileCardEditOwnBtn: t('chat.profileCardEditOwnBtn'),
      loadOlderBtn: t('chat.loadOlderBtn'),
      loadingOlder: t('chat.loadingOlder'),
      dateToday: t('chat.dateToday'),
      dateYesterday: t('chat.dateYesterday'),
      unreadDivider: t('chat.unreadDivider'),
      statusSending: t('chat.statusSending'),
      statusSent: t('chat.statusSent'),
      statusDelivered: t('chat.statusDelivered'),
      statusSeen: t('chat.statusSeen'),
      newMsgToastTitle: t('chat.newMsgToastTitle'),
      newMsgBrowserBody: t('chat.newMsgBrowserBody'),
      emojiRecentTitle: t('chat.emojiRecentTitle'),
      emojiEmpty: t('chat.emojiEmpty'),
      ringSavedToast: t('chat.ringSavedToast'),
      ringRemoveColor: t('chat.ringRemoveColor'),
      notifyBrowserBtn: t('chat.notifyBrowserBtn'),
      notifyBrowserEnabled: t('chat.notifyBrowserEnabled'),
      notifyBrowserDenied: t('chat.notifyBrowserDenied'),
      notifyBrowserUnsupported: t('chat.notifyBrowserUnsupported'),
      blockedEmpty: t('chat.blockedEmpty'),
      errConsentCheckbox: t('chat.errConsentCheckbox'),
      errSendFailed: t('chat.errSendFailed'),
      errEmptyMessage: t('chat.errEmptyMessage'),
      errTextTooLong: t('chat.errTextTooLong'),
      confirmBtn: t('chat.confirmBtn'),
      cancelBtn: t('chat.cancelBtn'),
      attachBtn: t('chat.attachBtn'),
      dropOverlayText: t('chat.dropOverlayText'),
      downloadFile: t('chat.downloadFile'),
      cancelUpload: t('chat.cancelUpload'),
      removeAttachment: t('chat.removeAttachment'),
      errMaxFiles: t('chat.errMaxFiles'),
      errUploadFailed: t('chat.errUploadFailed'),
      gifPlayHint: t('chat.gifPlayHint'),
      reportBtn: t('chat.reportBtn'),
      reportReceivedToast: t('chat.reportReceivedToast'),
      reportResolvedAction: t('chat.reportResolvedAction'),
      reportResolvedNoAction: t('chat.reportResolvedNoAction'),
      muteBannerText: t('chat.muteBannerText'),
      reportCatLabels: {
        harassment: t('chat.reportCatHarassment'),
        sexual: t('chat.reportCatSexual'),
        child_safety: t('chat.reportCatChildSafety'),
        threat: t('chat.reportCatThreat'),
        scam_spam: t('chat.reportCatScamSpam'),
        other: t('chat.reportCatOther'),
        profanity: t('chat.reportCatHarassment'),
        discord_invite: t('chat.reportCatScamSpam'),
        suspicious_link: t('chat.reportCatScamSpam'),
        pii_contact: t('chat.reportCatOther'),
      },
    },
  };
  const safeBootstrapJson = JSON.stringify(chatBootstrap).replace(/</g, '\\u003c');
%>

<script id="chatBootstrapData" type="application/json"><%- safeBootstrapJson %></script>

<div class="chat-page-backdrop" id="chatPageRoot">
  <% if (typeof activeSanction !== 'undefined' && activeSanction && activeSanction.type === 'ban') { %>
    <!-- ==================================================================
         SOHBETTEN YASAKLI KULLANICI AÇIKLAMA EKRANI
         ================================================================== -->
    <section class="chat-consent-shell" aria-labelledby="chatBanTitle">
      <div class="chat-consent-card chat-sanction-card">
        <div class="chat-consent-header">
          <div class="chat-consent-icon chat-consent-icon--danger" aria-hidden="true">⛔</div>
          <div>
            <span class="badge badge-danger"><%= t('chat.banScreenReason') %>: <%= activeSanction.reasonCategory %></span>
            <h1 id="chatBanTitle" class="chat-consent-title"><%= t('chat.banScreenTitle') %></h1>
          </div>
        </div>
        <p class="chat-consent-intro"><%= t('chat.banScreenDesc') %></p>
        <p class="chat-sanction-appeal"><%= t('chat.sanctionAppealNote') %></p>
        <div class="chat-privacy-footer">
          <a href="/kurallar" class="btn btn-secondary">📜 <%= t('nav.rules') %></a>
          <a href="/sohbet/gizlilik" class="btn btn-secondary">🔒 <%= t('chat.consentPrivacyLink') %></a>
        </div>
      </div>
    </section>
  <% } else if (needsConsent) { %>
    <!-- ==================================================================
         ZORUNLU İLK KULLANIM BİLGİLENDİRME VE ONAY EKRANI
         ================================================================== -->
    <section class="chat-consent-shell" aria-labelledby="chatConsentTitle">
      <div class="chat-consent-card">
        <div class="chat-consent-header">
          <div class="chat-consent-icon" aria-hidden="true">💬</div>
          <div>
            <span class="badge badge-primary"><%= t('chat.consentBadge') %></span>
            <h1 id="chatConsentTitle" class="chat-consent-title"><%= t('chat.consentTitle') %></h1>
          </div>
        </div>

        <p class="chat-consent-intro"><%= t('chat.consentIntro') %></p>

        <ol class="chat-consent-list">
          <li>
            <span class="chat-consent-bullet" aria-hidden="true">🗑️</span>
            <span><%= t('chat.consentPoint1') %></span>
          </li>
          <li>
            <span class="chat-consent-bullet" aria-hidden="true">🔒</span>
            <span><%= t('chat.consentPoint2') %></span>
          </li>
          <li>
            <span class="chat-consent-bullet" aria-hidden="true">🛡️</span>
            <span><%= t('chat.consentPoint3') %></span>
          </li>
          <li>
            <span class="chat-consent-bullet" aria-hidden="true">🚫</span>
            <span><%= t('chat.consentPoint4') %></span>
          </li>
          <li>
            <span class="chat-consent-bullet" aria-hidden="true">🤝</span>
            <span><%= t('chat.consentPoint5') %></span>
          </li>
        </ol>

        <div class="chat-consent-meta">
          <a href="/sohbet/gizlilik" class="chat-consent-privacy-link" target="_blank" rel="noopener">
            📄 <%= t('chat.consentPrivacyLink') %> ↗
          </a>
          <span class="chat-consent-version"><%= t('chat.consentPolicyVersion') %>: v<%= policyVersion %></span>
        </div>

        <form id="chatConsentForm" class="chat-consent-form" novalidate>
          <label class="chat-consent-checkbox-label">
            <input type="checkbox" id="chatConsentCheckbox" name="accepted" required />
            <span><%= t('chat.consentCheckbox') %></span>
          </label>
          <div id="chatConsentError" class="chat-inline-error" role="alert" hidden></div>
          <div class="chat-consent-actions">
            <button type="submit" class="btn btn-primary btn-lg" id="chatConsentSubmitBtn">
              <span><%= t('chat.consentAcceptBtn') %></span>
            </button>
          </div>
        </form>
      </div>
    </section>
  <% } else { %>
    <!-- ==================================================================
         ANA TAM EKRAN SOHBET ARAYÜZÜ (İKİ PANEL MASAÜSTÜ / TEK PANEL MOBİL)
         ================================================================== -->
    <div class="chat-app" id="chatApp">
      <!-- SOL PANEL: Arama + Sohbet Listesi + 30 Gün Alt Bilgisi -->
      <aside class="chat-list-pane" id="chatListPane" aria-label="<%= t('chat.conversationsTitle') %>">
        <div class="chat-list-topbar">
          <div class="chat-list-title-row">
            <h1 class="chat-list-heading">💬 <%= t('chat.heading') %></h1>
            <div class="chat-list-top-actions">
              <button
                type="button"
                class="chat-icon-btn"
                id="chatOpenSettingsBtn"
                title="<%= t('chat.settingsBtn') %>"
                aria-label="<%= t('chat.settingsBtn') %>"
              >
                <span aria-hidden="true">⚙️</span>
              </button>
            </div>
          </div>

          <div class="chat-search-wrap">
            <span class="chat-search-icon" aria-hidden="true">🔍</span>
            <input
              type="search"
              id="chatDirectorySearch"
              class="chat-search-input"
              placeholder="<%= t('chat.searchPlaceholder') %>"
              aria-label="<%= t('chat.searchPlaceholder') %>"
              autocomplete="off"
              maxlength="64"
            />
            <button type="button" id="chatSearchClearBtn" class="chat-search-clear" aria-label="<%= t('chat.closeBtn') %>" hidden>✕</button>
          </div>
        </div>

        <div class="chat-list-scroll" id="chatListScroll">
          <!-- Zorunlu Grup Sohbeti (En üstte sabit) -->
          <div id="chatGroupsSection" class="chat-list-section chat-list-section--pinned">
            <div class="chat-list-section-title">🌐 <%= t('chat.groupsSectionTitle') %></div>
            <div id="chatGroupsList" class="chat-items-container"></div>
          </div>

          <!-- Rehber Arama Sonuçları (Arama yapılınca görünür) -->
          <div id="chatDirectorySection" class="chat-list-section" hidden>
            <div class="chat-list-section-title"><%= t('chat.searchResultsTitle') %></div>
            <div id="chatDirectoryList" class="chat-items-container"></div>
          </div>

          <!-- Birebir Sohbet Listesi -->
          <div id="chatConversationsSection" class="chat-list-section">
            <div class="chat-list-section-title"><%= t('chat.conversationsTitle') %></div>
            <div id="chatConversationsList" class="chat-items-container"></div>
          </div>
        </div>

        <div class="chat-list-footer">
          <a href="/sohbet/gizlilik" class="chat-retention-footer-link">
            <span><%= t('chat.retentionFooter') %></span>
          </a>
        </div>
      </aside>

      <!-- SAĞ PANEL: Seçili Konuşma -->
      <section class="chat-thread-pane" id="chatThreadPane" aria-label="<%= t('chat.heading') %>">
        <!-- Boş durum (hiç sohbet seçilmemişken) -->
        <div class="chat-thread-empty" id="chatThreadEmpty">
          <div class="chat-thread-empty-icon" aria-hidden="true">💬</div>
          <h2 class="chat-thread-empty-title"><%= t('chat.emptyThreadTitle') %></h2>
          <p class="chat-thread-empty-desc"><%= t('chat.emptyThreadDesc') %></p>
        </div>

        <!-- Aktif Konuşma Kapsayıcısı -->
        <div class="chat-thread-active" id="chatThreadActive" hidden>
          <!-- Sürükle-Bırak Dosya Katmanı -->
          <div class="chat-drop-overlay" id="chatDropOverlay" hidden aria-hidden="true">
            <div class="chat-drop-overlay-card">
              <span class="chat-drop-overlay-icon" aria-hidden="true">📎</span>
              <strong><%= t('chat.dropOverlayText') %></strong>
            </div>
          </div>
          <!-- Konuşma Başlığı -->
          <header class="chat-thread-header">
            <div class="chat-thread-header-left">
              <button
                type="button"
                class="chat-icon-btn chat-back-btn"
                id="chatMobileBackBtn"
                aria-label="<%= t('chat.backToList') %>"
                title="<%= t('chat.backToList') %>"
              >
                ←
              </button>
              <button type="button" class="chat-header-profile-trigger" id="chatHeaderProfileBtn" aria-label="<%= t('chat.profileCardOpenLabel') %>">
                <div id="chatHeaderAvatarSlot" class="chat-header-avatar-slot"></div>
                <div class="chat-header-identity">
                  <div class="chat-header-name" id="chatHeaderName"></div>
                  <div class="chat-header-sub" id="chatHeaderSub"></div>
                </div>
              </button>
            </div>

            <div class="chat-thread-header-right">
              <button
                type="button"
                class="chat-retention-pill"
                id="chatRetentionInfoBtn"
                title="<%= t('chat.retentionTooltipTitle') %>"
                aria-label="<%= t('chat.retentionTooltipTitle') %>"
              >
                <span aria-hidden="true">🗑️</span>
                <span class="chat-retention-pill-text">30g</span>
              </button>

              <div class="chat-menu-wrap">
                <button
                  type="button"
                  class="chat-icon-btn"
                  id="chatHeaderMenuBtn"
                  aria-haspopup="menu"
                  aria-expanded="false"
                  aria-label="<%= t('chat.moreMenuBtn') %>"
                  title="<%= t('chat.moreMenuBtn') %>"
                >
                  ⋮
                </button>
                <div class="chat-dropdown-menu" id="chatHeaderMenu" role="menu" hidden>
                  <button type="button" class="chat-dropdown-item" id="chatMenuMuteGroupBtn" role="menuitem" hidden>
                    <span id="chatMenuMuteGroupIcon" aria-hidden="true">🔕</span>
                    <span id="chatMenuMuteGroupLabel"><%= t('chat.groupMuteBtn') %></span>
                  </button>
                  <button type="button" class="chat-dropdown-item chat-dropdown-item--danger" id="chatMenuReportBtn" role="menuitem">
                    🚩 <span><%= t('chat.reportBtn') %></span>
                  </button>
                  <button type="button" class="chat-dropdown-item chat-dropdown-item--danger" id="chatMenuBlockBtn" role="menuitem">
                    🚫 <span id="chatMenuBlockLabel"><%= t('chat.blockUser') %></span>
                  </button>
                  <a href="/sohbet/gizlilik" class="chat-dropdown-item" role="menuitem" target="_blank" rel="noopener">
                    📄 <%= t('chat.consentPrivacyLink') %>
                  </a>
                </div>
              </div>
            </div>
          </header>

          <!-- 30 Günlük Temizlik Açıklama Kutusu (İpucu tıklandığında açılır) -->
          <div class="chat-retention-popover" id="chatRetentionPopover" hidden>
            <strong id="chatRetentionPopoverTitle"><%= t('chat.retentionTooltipTitle') %></strong>
            <p id="chatRetentionPopoverBody"></p>
          </div>

          <!-- Uzun Kopuş / Çevrimdışı Yükleniyor Yuvası (3sn hap + 12sn tıklamayı engellemeyen katman) -->
          <div id="chatOfflineIndicatorSlot" class="chat-offline-slot"></div>

          <!-- Yeni Mesajlara Git Düğmesi (Yukarı kaydırınca görünür) -->
          <button
            type="button"
            id="chatJumpToBottomBtn"
            class="chat-jump-bottom-btn"
            hidden
            aria-label="<%= t('chat.jumpToBottom') %>"
          >
            <span class="chat-jump-bottom-arrow" aria-hidden="true">↓</span>
            <span><%= t('chat.jumpToBottom') %></span>
            <span id="chatJumpBottomCount" class="chat-jump-bottom-count" hidden></span>
          </button>

          <!-- Mesaj Akışı -->
          <div class="chat-messages-scroll" id="chatMessagesScroll" role="log" aria-live="polite" aria-relevant="additions">
            <div class="chat-load-older-wrap" id="chatLoadOlderWrap" hidden>
              <button type="button" class="btn btn-secondary btn-xs" id="chatLoadOlderBtn">
                <%= t('chat.loadOlderBtn') %>
              </button>
            </div>
            <div class="chat-messages-list" id="chatMessagesList"></div>
            <!-- Karşı taraf yazıyor göstergesi -->
            <div class="chat-typing-row" id="chatTypingRow" hidden>
              <div class="chat-typing-bubble" aria-label="<%= t('chat.typingIndicator') %>">
                <span class="chat-typing-dot"></span>
                <span class="chat-typing-dot"></span>
                <span class="chat-typing-dot"></span>
              </div>
              <span class="chat-typing-label" id="chatTypingLabel"><%= t('chat.typingIndicator') %></span>
            </div>
          </div>

          <!-- Susturma Yaptırımı Uyarı Şeridi -->
          <div class="chat-mute-bar" id="chatMuteBar" hidden>
            <span id="chatMuteBarText"></span>
            <a href="/kurallar" class="chat-mute-appeal-link">📜 <%= t('nav.rules') %></a>
          </div>

          <!-- Engel / Kapalı DM Uyarı Şeridi -->
          <div class="chat-status-bar" id="chatBlockedBar" hidden>
            <span id="chatBlockedBarText"></span>
            <button type="button" class="btn btn-secondary btn-xs" id="chatQuickUnblockBtn" hidden>
              <%= t('chat.unblockUser') %>
            </button>
          </div>

          <!-- Alt Mesaj Yazma Kutusu (Composer) -->
          <div class="chat-composer-shell" id="chatComposerShell">
            <!-- Emoji Paneli (Açılır Popover / Mobilde Bottom Sheet) -->
            <div class="chat-emoji-popover" id="chatEmojiPopover" role="dialog" aria-label="<%= t('chat.emojiBtn') %>" hidden>
              <div class="chat-emoji-top">
                <input
                  type="search"
                  id="chatEmojiSearch"
                  class="chat-emoji-search"
                  placeholder="<%= t('chat.emojiSearchPlaceholder') %>"
                  aria-label="<%= t('chat.emojiSearchPlaceholder') %>"
                  autocomplete="off"
                />
                <button type="button" class="chat-icon-btn chat-emoji-close" id="chatEmojiCloseBtn" aria-label="<%= t('chat.closeBtn') %>">✕</button>
              </div>
              <div class="chat-emoji-tabs" id="chatEmojiTabs" role="tablist"></div>
              <div class="chat-emoji-grid-wrap" id="chatEmojiGridWrap">
                <div class="chat-emoji-grid" id="chatEmojiGrid" role="grid"></div>
              </div>
            </div>

            <!-- Yüklenen / Bekleyen Dosya Önizleme Çipleri -->
            <div class="chat-attachment-chips" id="chatAttachmentChips" hidden></div>

            <form id="chatComposerForm" class="chat-composer-form" novalidate>
              <button
                type="button"
                class="chat-composer-btn"
                id="chatEmojiToggleBtn"
                title="<%= t('chat.emojiBtn') %>"
                aria-label="<%= t('chat.emojiBtn') %>"
                aria-expanded="false"
                aria-controls="chatEmojiPopover"
              >
                😊
              </button>

              <!-- Parça 3: Dosya Ekleme Düğmesi ve Gizli Dosya Seçici -->
              <div id="chatAttachmentControlsSlot" class="chat-attachment-controls-slot">
                <button
                  type="button"
                  class="chat-composer-btn"
                  id="chatAttachBtn"
                  title="<%= t('chat.attachBtn') %>"
                  aria-label="<%= t('chat.attachBtn') %>"
                >
                  📎
                </button>
                <input
                  type="file"
                  id="chatFileInput"
                  multiple
                  accept=".png,.jpg,.jpeg,.gif,.webp,.pdf,.txt,.mp4,.webm,image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain,video/mp4,video/webm"
                  hidden
                />
              </div>

              <div class="chat-textarea-wrap">
                <textarea
                  id="chatMessageInput"
                  class="chat-message-input"
                  rows="1"
                  maxlength="<%= chatLimits ? chatLimits.maxMessageLength : 4000 %>"
                  placeholder="<%= t('chat.composerPlaceholder') %>"
                  aria-label="<%= t('chat.composerPlaceholder') %>"
                ></textarea>
                <span class="chat-char-counter" id="chatCharCounter" hidden></span>
              </div>

              <button
                type="submit"
                class="chat-send-btn"
                id="chatSendBtn"
                title="<%= t('chat.sendBtn') %>"
                aria-label="<%= t('chat.sendBtn') %>"
                disabled
              >
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="22" y1="2" x2="11" y2="13"></line>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
              </button>
            </form>
          </div>
        </div>
      </section>
    </div>
  <% } %>
</div>

<% if (!(typeof activeSanction !== 'undefined' && activeSanction && activeSanction.type === 'ban') && !needsConsent) { %>
    <!-- ==================================================================
         AYARLAR VE PROFİL HALKASI SEÇİCİ MODALI
         ================================================================== -->
    <div class="chat-modal-backdrop" id="chatSettingsModal" hidden aria-hidden="true">
      <div class="chat-modal-card chat-settings-modal" role="dialog" aria-modal="true" aria-labelledby="chatSettingsTitle">
        <div class="chat-modal-header">
          <h2 id="chatSettingsTitle" class="chat-modal-title">⚙️ <%= t('chat.settingsTitle') %></h2>
          <button type="button" class="chat-icon-btn" id="chatSettingsCloseBtn" aria-label="<%= t('chat.closeBtn') %>">✕</button>
        </div>

        <div class="chat-settings-tabs" role="tablist">
          <button type="button" class="chat-settings-tab active" data-settings-tab="ring" role="tab" aria-selected="true">
            🎨 <%= t('chat.settingsTabRing') %>
          </button>
          <button type="button" class="chat-settings-tab" data-settings-tab="privacy" role="tab" aria-selected="false">
            🔒 <%= t('chat.settingsTabPrivacy') %>
          </button>
          <button type="button" class="chat-settings-tab" data-settings-tab="blocked" role="tab" aria-selected="false">
            🚫 <%= t('chat.settingsTabBlocked') %>
          </button>
        </div>

        <div class="chat-modal-body">
          <!-- SEKME 1: PROFİL HALKASI -->
          <div class="chat-settings-panel" id="chatSettingsPanelRing">
            <div class="chat-ring-preview-box">
              <div id="chatRingLivePreviewSlot"></div>
              <div class="chat-ring-preview-info">
                <div class="chat-ring-preview-label"><%= t('chat.ringPreviewLabel') %></div>
                <strong id="chatRingPreviewName"></strong>
                <div class="chat-ring-preview-user"><%= chatProfile.displayName %></div>
              </div>
            </div>

            <div class="chat-ring-cat-tabs" id="chatRingCategoryTabs" role="tablist"></div>
            <div class="chat-ring-grid" id="chatRingPresetGrid"></div>

            <!-- Kendi Halkanı Yap -->
            <div class="chat-custom-ring-box">
              <h3 class="chat-custom-ring-title">✨ <%= t('chat.ringCustomTitle') %></h3>
              <p class="chat-custom-ring-desc"><%= t('chat.ringCustomDesc') %></p>
              <div class="chat-custom-colors-row" id="chatCustomColorsRow"></div>
              <div class="chat-custom-ring-actions">
                <button type="button" class="btn btn-secondary btn-xs" id="chatCustomAddColorBtn">
                  <%= t('chat.ringAddColor') %>
                </button>
                <label class="chat-toggle-inline">
                  <input type="checkbox" id="chatCustomSpinCheck" />
                  <span><%= t('chat.ringSpinToggle') %></span>
                </label>
                <button type="button" class="btn btn-primary btn-xs" id="chatCustomApplyBtn">
                  <%= t('chat.ringApplyCustom') %>
                </button>
              </div>
            </div>
          </div>

          <!-- SEKME 2: GİZLİLİK VE BİLDİRİMLER -->
          <div class="chat-settings-panel" id="chatSettingsPanelPrivacy" hidden>
            <div class="chat-setting-row">
              <label class="chat-setting-toggle-label">
                <input type="checkbox" id="chatSetReadReceipts" />
                <div>
                  <strong><%= t('chat.privacyReadReceipts') %></strong>
                  <p><%= t('chat.privacyReadReceiptsDesc') %></p>
                </div>
              </label>
            </div>

            <div class="chat-setting-row">
              <label class="chat-setting-select-label" for="chatSetWhoCanMessage">
                <strong><%= t('chat.privacyWhoCanMessage') %></strong>
              </label>
              <select id="chatSetWhoCanMessage" class="form-control">
                <option value="everyone"><%= t('chat.privacyWhoEveryone') %></option>
                <option value="nobody"><%= t('chat.privacyWhoNobody') %></option>
              </select>
            </div>

            <div class="chat-setting-row">
              <label class="chat-setting-toggle-label">
                <input type="checkbox" id="chatSetShowGames" />
                <div>
                  <strong><%= t('chat.privacyShowGames') %></strong>
                  <p><%= t('chat.privacyShowGamesDesc') %></p>
                </div>
              </label>
            </div>

            <hr class="chat-setting-divider" />
            <h3 class="chat-setting-subtitle">🔔 <%= t('chat.notifySectionTitle') %></h3>

            <div class="chat-setting-row">
              <button type="button" class="btn btn-secondary btn-sm" id="chatEnableBrowserNotifyBtn">
                <%= t('chat.notifyBrowserBtn') %>
              </button>
              <div class="chat-setting-hint" id="chatBrowserNotifyStatus"></div>
            </div>

            <div class="chat-setting-row">
              <label class="chat-setting-toggle-label">
                <input type="checkbox" id="chatSetNotifyPreview" />
                <div>
                  <strong><%= t('chat.notifyPreviewToggle') %></strong>
                  <p><%= t('chat.notifyPreviewDesc') %></p>
                </div>
              </label>
            </div>

            <div class="chat-setting-row">
              <label class="chat-setting-toggle-label">
                <input type="checkbox" id="chatSetNotifySound" />
                <div>
                  <strong><%= t('chat.notifySoundToggle') %></strong>
                  <p><%= t('chat.notifySoundDesc') %></p>
                </div>
              </label>
            </div>
          </div>

          <!-- SEKME 3: ENGELLENENLER -->
          <div class="chat-settings-panel" id="chatSettingsPanelBlocked" hidden>
            <div id="chatBlockedListContainer" class="chat-blocked-list"></div>
          </div>

          <% if (typeof isFreshDeveloper !== 'undefined' && isFreshDeveloper && typeof devDiagnostics !== 'undefined' && devDiagnostics) {
            const devDiagCodeMap = {
              MATCH: t('chat.devDiagCodeMatch'),
              ENV_EMPTY: t('chat.devDiagCodeEnvEmpty'),
              ENV_PARSE_EMPTY: t('chat.devDiagCodeEnvParseEmpty'),
              NOT_IN_LIST: t('chat.devDiagCodeNotInList'),
              NOT_DISCORD_SESSION: t('chat.devDiagCodeNotDiscord'),
            };
            const rtStats = devDiagnostics.realtime || { activeConnections: 0, reconnectsLastHour: 0, reasonBreakdown: { timeout: 0, other_tab: 0, error: 0 } };
            const rb = rtStats.reasonBreakdown || { timeout: 0, other_tab: 0, error: 0 };
          %>
            <!-- YALNIZCA TAZE DOĞRULANMIŞ DISCORD DEVELOPER TEŞHİS KUTUSU -->
            <section class="chat-dev-diag-box" id="chatDevDiagBox" aria-labelledby="chatDevDiagHeading">
              <div class="chat-dev-diag-head">
                <h3 id="chatDevDiagHeading" class="chat-dev-diag-title">🛠️ <%= t('chat.devDiagTitle') %></h3>
                <span
                  class="chat-dev-diag-badge <%= devDiagnostics.isMatch ? 'chat-dev-diag-badge--ok' : 'chat-dev-diag-badge--warn' %>"
                  id="chatDevDiagCode"
                ><%= devDiagnostics.code %></span>
              </div>
              <p class="chat-dev-diag-summary" id="chatDevDiagSummary"><%= devDiagCodeMap[devDiagnostics.code] || devDiagnostics.code %></p>
              <dl class="chat-dev-diag-grid">
                <div>
                  <dt><%= t('chat.devDiagCountLabel') %></dt>
                  <dd id="chatDevDiagCount"><%= devDiagnostics.configuredCount %></dd>
                </div>
                <div>
                  <dt><%= t('chat.devDiagSessionLast4') %></dt>
                  <dd><code id="chatDevDiagSessionLast4"><%= devDiagnostics.sessionLast4 ? ('…' + devDiagnostics.sessionLast4) : '—' %></code></dd>
                </div>
                <div class="chat-dev-diag-span">
                  <dt><%= t('chat.devDiagConfiguredLast4') %></dt>
                  <dd><code id="chatDevDiagConfiguredLast4"><%= (Array.isArray(devDiagnostics.configuredLast4List) && devDiagnostics.configuredLast4List.length > 0) ? devDiagnostics.configuredLast4List.map(function (x) { return '…' + x; }).join(', ') : '—' %></code></dd>
                </div>
              </dl>
              <div class="chat-dev-diag-rt">
                <div class="chat-dev-diag-rt-title">📡 <%= t('chat.devDiagRealtimeTitle') %></div>
                <div class="chat-dev-diag-rt-metrics">
                  <span><%= t('chat.devDiagActiveConn') %>: <strong id="chatDevDiagActive"><%= rtStats.activeConnections %></strong></span>
                  <span><%= t('chat.devDiagReconnectsHour') %>: <strong id="chatDevDiagReconnects"><%= rtStats.reconnectsLastHour %></strong></span>
                </div>
                <div class="chat-dev-diag-rt-reasons">
                  <span><%= t('chat.devDiagReasonTimeout') %>: <strong id="chatDevDiagTimeout"><%= rb.timeout || 0 %></strong></span>
                  <span>•</span>
                  <span><%= t('chat.devDiagReasonOtherTab') %>: <strong id="chatDevDiagOtherTab"><%= rb.other_tab || 0 %></strong></span>
                  <span>•</span>
                  <span><%= t('chat.devDiagReasonError') %>: <strong id="chatDevDiagError"><%= rb.error || 0 %></strong></span>
                </div>
              </div>
            </section>
          <% } %>
        </div>

        <div class="chat-modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" id="chatSettingsCancelBtn"><%= t('chat.closeBtn') %></button>
          <button type="button" class="btn btn-primary btn-sm" id="chatSettingsSaveBtn"><%= t('chat.ringSaveBtn') %></button>
        </div>
      </div>
    </div>

    <!-- ==================================================================
         ONAY DİYALOĞU (Mesaj Sil / Engelle)
         ================================================================== -->
    <div class="chat-modal-backdrop" id="chatConfirmModal" hidden aria-hidden="true">
      <div class="chat-modal-card chat-confirm-modal" role="alertdialog" aria-modal="true" aria-labelledby="chatConfirmTitle">
        <div class="chat-modal-header">
          <h3 id="chatConfirmTitle" class="chat-modal-title"></h3>
        </div>
        <div class="chat-modal-body">
          <p id="chatConfirmText" class="chat-confirm-text"></p>
        </div>
        <div class="chat-modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" id="chatConfirmCancelBtn"><%= t('chat.cancelBtn') %></button>
          <button type="button" class="btn btn-danger btn-sm" id="chatConfirmOkBtn"><%= t('chat.confirmBtn') %></button>
        </div>
      </div>
    </div>

    <!-- ==================================================================
         RAPORLAMA MODALI (Mesaj veya Sohbet)
         ================================================================== -->
    <div class="chat-modal-backdrop" id="chatReportModal" hidden aria-hidden="true">
      <div class="chat-modal-card chat-report-modal" role="dialog" aria-modal="true" aria-labelledby="chatReportTitle">
        <div class="chat-modal-header">
          <h3 id="chatReportTitle" class="chat-modal-title">🚩 <%= t('chat.reportModalTitle') %></h3>
          <button type="button" class="chat-icon-btn" id="chatReportCloseBtn" aria-label="<%= t('chat.closeBtn') %>">✕</button>
        </div>
        <form id="chatReportForm" class="chat-modal-body" novalidate>
          <p class="chat-report-desc"><%= t('chat.reportModalDesc') %></p>
          <div class="chat-setting-row">
            <label class="chat-setting-select-label" for="chatReportCategory">
              <strong><%= t('chat.reportCategoryLabel') %></strong>
            </label>
            <select id="chatReportCategory" class="form-control" required>
              <option value="harassment"><%= t('chat.reportCatHarassment') %></option>
              <option value="sexual"><%= t('chat.reportCatSexual') %></option>
              <option value="child_safety"><%= t('chat.reportCatChildSafety') %></option>
              <option value="threat"><%= t('chat.reportCatThreat') %></option>
              <option value="scam_spam"><%= t('chat.reportCatScamSpam') %></option>
              <option value="other"><%= t('chat.reportCatOther') %></option>
            </select>
          </div>
          <div class="chat-setting-row">
            <label class="chat-setting-select-label" for="chatReportNote">
              <strong><%= t('chat.reportNoteLabel') %></strong>
            </label>
            <textarea
              id="chatReportNote"
              class="form-control"
              rows="3"
              maxlength="500"
              placeholder="<%= t('chat.reportNotePlaceholder') %>"
            ></textarea>
          </div>
          <div id="chatReportError" class="chat-inline-error" role="alert" hidden></div>
          <div class="chat-modal-footer chat-report-footer">
            <button type="button" class="btn btn-secondary btn-sm" id="chatReportCancelBtn"><%= t('chat.cancelBtn') %></button>
            <button type="submit" class="btn btn-danger btn-sm" id="chatReportSubmitBtn">🚩 <%= t('chat.reportSubmitBtn') %></button>
          </div>
        </form>
      </div>
    </div>

    <!-- ==================================================================
         PROFİL BİLGİ KARTI (Nebula Glass Card / Mobilde Bottom Sheet)
         ================================================================== -->
    <div class="nebula-card-overlay" id="chatProfileCardOverlay" hidden aria-hidden="true">
      <div class="nebula-card-stage" id="chatProfileCardStage">
        <div
          class="nebula-card"
          id="chatProfileCard"
          role="dialog"
          aria-modal="true"
          aria-labelledby="chatProfileCardTitle"
        >
          <div class="nebula-sheet-handle" aria-hidden="true"></div>
          <div class="nebula-bg" aria-hidden="true">
            <span class="nebula-orb nebula-orb--1"></span>
            <span class="nebula-orb nebula-orb--2"></span>
            <span class="nebula-orb nebula-orb--3"></span>
          </div>
          <div class="nebula-rim" aria-hidden="true"></div>
          <div class="nebula-glass-surface">
            <button
              type="button"
              class="chat-icon-btn nebula-close-btn"
              id="chatProfileCardCloseBtn"
              aria-label="<%= t('chat.closeBtn') %>"
            >
              ✕
            </button>
            <div id="chatProfileCardContent" class="nebula-card-content"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tam Ekran Görsel Görüntüleyici (Lightbox) -->
    <div class="chat-lightbox" id="chatLightboxModal" role="dialog" aria-modal="true" aria-label="<%= t('chat.lightboxClose') %>" hidden aria-hidden="true">
      <div class="chat-lightbox-topbar">
        <span class="chat-lightbox-filename" id="chatLightboxFilename"></span>
        <div class="chat-lightbox-actions">
          <a href="#" id="chatLightboxDownload" class="btn btn-secondary btn-xs" download>
            ⬇️ <%= t('chat.downloadFile') %>
          </a>
          <button type="button" class="chat-icon-btn" id="chatLightboxCloseBtn" aria-label="<%= t('chat.lightboxClose') %>">✕</button>
        </div>
      </div>
      <div class="chat-lightbox-stage">
        <button type="button" class="chat-lightbox-nav chat-lightbox-nav--prev" id="chatLightboxPrevBtn" aria-label="<%= t('chat.lightboxPrev') %>">‹</button>
        <img id="chatLightboxImg" class="chat-lightbox-img" alt="" />
        <button type="button" class="chat-lightbox-nav chat-lightbox-nav--next" id="chatLightboxNextBtn" aria-label="<%= t('chat.lightboxNext') %>">›</button>
      </div>
    </div>

    <!-- Bildirim Toast Kutusu -->
    <div class="chat-toast-stack" id="chatToastStack" aria-live="polite" aria-atomic="true"></div>
<% } %>

<%- include('../layouts/footer') %>
