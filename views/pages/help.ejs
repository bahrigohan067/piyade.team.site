<%- include('../layouts/header') %>

<div style="max-width: 840px; margin: 0 auto; padding-top: 1rem;">
  
  <div style="text-align: center; margin-bottom: 2.5rem;">
    <span class="badge badge-danger" style="margin-bottom: 0.5rem;">Klan İçi Hızlı Müdahale</span>
    <h1 style="font-size: 2.2rem; margin-bottom: 0.5rem;">🚨 Acil Takviye / Yardım Çağrısı</h1>
    <p style="color: var(--text-secondary); max-width: 620px; margin: 0 auto; font-size: 0.95rem; line-height: 1.6;">
      Roblox The Strongest Battlegrounds oyununda sunucun baskın yediğinde veya acil desteğe ihtiyaç duyduğunda tek tıkla klandan takviye iste.
    </p>
  </div>

  <!-- Flash Mesajları -->
  <% if (typeof flashSuccess !== 'undefined' && flashSuccess) { %>
    <div class="alert alert-success">
      <span style="font-size: 1.25rem;">✅</span>
      <div><%= flashSuccess %></div>
    </div>
  <% } %>

  <% if (typeof flashError !== 'undefined' && flashError) { %>
    <div class="alert alert-danger">
      <span style="font-size: 1.25rem;">🛑</span>
      <div><%= flashError %></div>
    </div>
  <% } %>

  <!-- Canlı Sayaç ve Durum Kartı -->
  <div class="grid grid-2" style="margin-bottom: 2rem;">
    
    <div class="stat-card" style="border-top: 4px solid var(--color-success);">
      <div class="stat-header">
        <span class="stat-label">Aktif Kayıtlı Üyeler</span>
        <span class="status-dot-success"></span>
      </div>
      <div class="stat-value" style="color: var(--color-success);">
        <%= helpStatus.activeRegisteredCount || 0 %> Kişi
      </div>
      <div class="stat-desc">
        Sunucuda anlık çevrim içi (Online, Idle, DND) klan üyesi
      </div>
    </div>

    <div class="stat-card" style="border-top: 4px solid var(--color-warning);">
      <div class="stat-header">
        <span class="stat-label">Bekleme Süresi (Cooldown)</span>
        <span style="font-size: 1.1rem;">⏱️</span>
      </div>
      <div class="stat-value" style="font-size: 1.4rem;">
        <% if (helpStatus.cooldown && helpStatus.remainingSeconds > 0) { %>
          <span
            id="cooldownTimer"
            class="badge badge-warning"
            style="font-size: 1rem; padding: 5px 12px;"
            data-seconds="<%= helpStatus.remainingSeconds %>"
          >
            <%= Math.floor(helpStatus.remainingSeconds / 60) %> dk <%= helpStatus.remainingSeconds % 60 %> sn
          </span>
        <% } else { %>
          <span id="cooldownTimer" class="badge badge-success" style="font-size: 1rem; padding: 5px 12px;" data-seconds="0">
            Kullanıma Hazır
          </span>
        <% } %>
      </div>
      <div class="stat-desc">
        Her üye 5 dakikada bir acil takviye çağrısı gönderebilir
      </div>
    </div>

  </div>

  <!-- Çağrı Butonu Kartı -->
  <div class="glass-card" style="padding: 3rem 2rem; text-align: center; margin-bottom: 2rem; border-color: rgba(239, 68, 68, 0.25);">
    <div style="width: 68px; height: 68px; border-radius: 20px; background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.3); display: flex; align-items: center; justify-content: center; font-size: 2.2rem; margin: 0 auto 1.25rem;">
      📢
    </div>
    <h2 style="font-size: 1.75rem; margin-bottom: 0.75rem; color: #ffffff;">Yardım Çağrısını Ateşle</h2>
    <p style="max-width: 540px; margin: 0 auto 1.75rem; color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6;">
      Butona bastığınız anda Discord botumuz acil yardım kanalına <strong>Roblox Profilinize tek tıkla giden bir katılım kartı</strong> gönderir ve o an aktif olan tüm klan üyelerine doğrudan bildirim iletir.
    </p>

    <form action="/takviye" method="POST">
      <!-- CSRF Güvenlik Anahtarı -->
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <% if (helpStatus.cooldown && helpStatus.remainingSeconds > 0) { %>
        <button type="submit" id="btnTakviyeCall" class="btn btn-danger btn-lg" disabled style="opacity: 0.6; cursor: not-allowed;">
          <span>⏳ Bekleme Süresi Aktif</span>
        </button>
      <% } else { %>
        <button type="submit" id="btnTakviyeCall" class="btn btn-danger btn-lg" onclick="return confirm('Acil takviye çağrısı göndermek istediğinize emin misiniz? Sunucudaki aktif üyelere bildirim iletilecektir.');">
          <span>🚨 Acil Takviye Çağrısı Başlat</span>
        </button>
      <% } %>
    </form>
  </div>

  <!-- Bilgilendirme Kartı -->
  <div class="glass-card">
    <h3 class="card-title" style="margin-bottom: 1rem;"><span>ℹ️</span> Sistem Nasıl Çalışır?</h3>
    <ul style="padding-left: 1.25rem; color: var(--text-secondary); font-size: 0.925rem; display: flex; flex-direction: column; gap: 0.65rem; line-height: 1.5;">
      <li>Takviye çağrısı doğrudan <code>&lt;#1559928245598560336&gt;</code> bildirim kanalına iletilir.</li>
      <li>Bildirim kartına sizin <strong>Roblox Profil Linkiniz</strong> eklenir; klan üyeleri tek tıkla profilinize tıklayıp oyun sunucunuza katılabilirler.</li>
      <li>Gereksiz çağrı ve spam yapılmasını önlemek adına 5 dakikalık bekleme süresi ve kural yaptırımları uygulanır.</li>
    </ul>
  </div>

</div>

<!-- Sayaç Scripti -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const timerElem = document.getElementById('cooldownTimer');
    const callButton = document.getElementById('btnTakviyeCall');
    if (!timerElem) return;

    let seconds = parseInt(timerElem.getAttribute('data-seconds') || '0', 10);
    if (seconds <= 0) return;

    const interval = setInterval(function() {
      seconds--;
      if (seconds <= 0) {
        clearInterval(interval);
        timerElem.className = 'badge badge-success';
        timerElem.textContent = 'Kullanıma Hazır';
        if (callButton) {
          callButton.removeAttribute('disabled');
          callButton.style.opacity = '1';
          callButton.style.cursor = 'pointer';
          callButton.innerHTML = '<span>🚨 Acil Takviye Çağrısı Başlat</span>';
        }
      } else {
        const mins = Math.floor(seconds / 60);
        const remSecs = seconds % 60;
        timerElem.textContent = mins + ' dk ' + remSecs + ' sn';
      }
    }, 1000);
  });
</script>

<%- include('../layouts/footer') %>
