<%- include('../layouts/header') %>

<div style="max-width: 820px; margin: 0 auto;">
  <div style="text-align: center; margin-bottom: 2rem;">
    <span class="badge badge-danger">Klan İçi Hızlı Müdahale</span>
    <h1 style="margin-top: 0.5rem; margin-bottom: 0.5rem;">🚨 Acil Takviye / Yardım Çağrısı</h1>
    <p style="color: var(--text-secondary); max-width: 620px; margin: 0 auto;">
      Roblox The Strongest Battlegrounds oyununda sunucun baskın yediğinde veya acil desteğe ihtiyaç duyduğunda tek tıkla klandan takviye iste.
    </p>
  </div>

  <!-- Flash Mesajları -->
  <% if (typeof flashSuccess !== 'undefined' && flashSuccess) { %>
    <div class="alert alert-success">
      <span>✅</span>
      <div><%= flashSuccess %></div>
    </div>
  <% } %>

  <% if (typeof flashError !== 'undefined' && flashError) { %>
    <div class="alert alert-danger">
      <span>❌</span>
      <div><%= flashError %></div>
    </div>
  <% } %>

  <!-- Canlı Sayaç ve Durum Kartı -->
  <div class="grid grid-2" style="margin-bottom: 2rem;">
    <div class="stat-card" style="border-top: 4px solid var(--color-success);">
      <div class="stat-header">
        <span class="stat-label">Aktif Kayıtlı Üyeler</span>
        <span style="font-size: 1.25rem;">🟢</span>
      </div>
      <div class="stat-value" style="color: var(--color-success);">
        <%= helpStatus.activeRegisteredCount || 0 %> Kişi
      </div>
      <div class="stat-desc">
        Sunucuda anlık çevrim içi (Online, Idle, DND) kayıtlı üye sayısı
      </div>
    </div>

    <div class="stat-card" style="border-top: 4px solid var(--color-warning);">
      <div class="stat-header">
        <span class="stat-label">Bekleme Süresi (Cooldown)</span>
        <span style="font-size: 1.25rem;">⏱️</span>
      </div>
      <div class="stat-value" style="font-size: 1.5rem;">
        <% if (helpStatus.cooldown && helpStatus.remainingSeconds > 0) { %>
          <span
            id="cooldownTimer"
            class="badge badge-warning"
            style="font-size: 1.1rem; padding: 6px 14px;"
            data-seconds="<%= helpStatus.remainingSeconds %>"
          >
            <%= Math.floor(helpStatus.remainingSeconds / 60) %> dk <%= helpStatus.remainingSeconds % 60 %> sn
          </span>
        <% } else { %>
          <span id="cooldownTimer" class="badge badge-success" style="font-size: 1.1rem; padding: 6px 14px;" data-seconds="0">
            Kullanıma Hazır
          </span>
        <% } %>
      </div>
      <div class="stat-desc">
        Her kullanıcı 5 dakikada bir acil takviye çağrısı gönderebilir
      </div>
    </div>
  </div>

  <!-- Çağrı Butonu Kartı -->
  <div class="card" style="padding: 2.5rem 2rem; text-align: center; margin-bottom: 2rem; background: linear-gradient(135deg, rgba(21, 30, 50, 0.95), rgba(25, 14, 20, 0.95)); border: 1px solid var(--border-color);">
    <div style="font-size: 3rem; margin-bottom: 1rem;">📢</div>
    <h2 style="margin-bottom: 0.75rem;">Yardım Çağrısını Ateşle</h2>
    <p style="max-width: 540px; margin: 0 auto 1.75rem; color: var(--text-secondary); font-size: 0.95rem;">
      Butona bastığınız anda Discord botumuz acil yardım kanalına <strong>Roblox Profilinize tek tıkla giden bir buton kartı</strong> gönderir ve o an aktif olan tüm üyelere doğrudan DM bildirimi iletir.
    </p>

    <form action="/takviye" method="POST">
      <!-- CSRF Güvenlik Anahtarı -->
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <% if (helpStatus.cooldown && helpStatus.remainingSeconds > 0) { %>
        <button type="submit" id="btnTakviyeCall" class="btn btn-danger btn-lg" disabled>
          <span>⏳ Bekleme Süresi Aktif</span>
        </button>
      <% } else { %>
        <button type="submit" id="btnTakviyeCall" class="btn btn-danger btn-lg" onclick="return confirm('Acil takviye çağrısı göndermek istediğinize emin misiniz? Sunucudaki aktif üyelere bildirim iletilecektir.');">
          <span>🚨 Acil Takviye Çağrısı Başlat</span>
        </button>
      <% } %>
    </form>
  </div>

  <!-- Bilgilendirme Kartı -->
  <div class="card" style="background: var(--bg-surface);">
    <h3 class="card-title"><span>ℹ️</span> Sistem Nasıl Çalışır?</h3>
    <ul style="padding-left: 1.25rem; color: var(--text-secondary); font-size: 0.925rem; display: flex; flex-direction: column; gap: 0.5rem;">
      <li>Takviye çağrısı doğrudan <code>&lt;#1559928245598560336&gt;</code> bildirim kanalına düşer.</li>
      <li>Bildirim kartına sizin <strong>Roblox Profil Linkiniz</strong> eklenir; klan üyeleri tek tıkla profiline tıklayıp oyun sunucunuza (Join) katılabilirler.</li>
      <li>Gereksiz çağrı ve spam yapılmasını önlemek adına 5 dakikalık bekleme süresi ve kural yaptırımları uygulanır.</li>
    </ul>
  </div>
</div>

<%- include('../layouts/footer') %>
