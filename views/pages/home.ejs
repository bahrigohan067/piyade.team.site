<%- include('../layouts/header') %>

<%
  const heroBrandAssets = (typeof brandConfig !== 'undefined' && brandConfig && brandConfig.ASSETS)
    ? brandConfig.ASSETS
    : {
        logo512: '/img/brand/logo-512.webp?v=1',
        logo768: '/img/brand/logo-768.webp?v=1',
        logo1024: '/img/brand/logo-1024.webp?v=1',
      };
  const heroSiteName = (typeof brandConfig !== 'undefined' && brandConfig && typeof brandConfig.getSiteName === 'function')
    ? brandConfig.getSiteName()
    : ((typeof brandConfig !== 'undefined' && brandConfig && brandConfig.SITE_NAME) ? brandConfig.SITE_NAME : t('brand.name'));
  const discordInviteUrl = (typeof brandConfig !== 'undefined' && brandConfig && typeof brandConfig.getDiscordInviteUrl === 'function')
    ? brandConfig.getDiscordInviteUrl()
    : ((typeof brandConfig !== 'undefined' && brandConfig && brandConfig.DISCORD_INVITE_URL) ? brandConfig.DISCORD_INVITE_URL : '');
%>

<!-- ==============================================================================
 * TODO(yeni-tasarım): GEÇİCİ SADE ANASAYFA HERO ALANI
 * ============================================================================== -->
<section class="hero-section">
  <div class="hero-split">
    <!-- Sol Sütun (Mobilde Altta): Marka Adı, Geçici Slogan ve Aksiyon Butonları -->
    <div class="hero-copy-col">
      <!-- TODO(yeni-tasarım): Geçici başlık ve slogan -->
      <div style="margin-bottom: 1.75rem;">
        <h1 style="font-size: clamp(2.4rem, 5.4vw, 4rem); font-weight: 900; line-height: 1.1; letter-spacing: -0.03em; margin-bottom: 1.15rem;">
          <span class="gradient-text text-glow-blue"><%= heroSiteName %></span>
        </h1>
        <p style="font-size: clamp(1.05rem, 1.8vw, 1.2rem); color: var(--text-secondary); max-width: 640px; margin-bottom: 2rem; line-height: 1.7;">
          <%= t('home.heroSubtitle') %>
        </p>
      </div>

      <!-- Ana Aksiyon Butonları -->
      <div class="hero-actions">
        <% if (currentUser && typeof isRegistered !== 'undefined' && isRegistered) { %>
          <a href="/profil" class="btn btn-primary btn-lg">
            <span><%= t('home.btnMyProfile') %></span>
          </a>
        <% } else { %>
          <a href="/kayit" class="btn btn-primary btn-lg">
            <span><%= t('home.btnRegisterNow') %></span>
          </a>
        <% } %>

        <a href="/kurallar" class="btn btn-secondary btn-lg">
          <span><%= t('home.btnRules') %></span>
        </a>

        <% if (discordInviteUrl) { %>
          <a href="<%= discordInviteUrl %>" target="_blank" rel="noopener" class="btn btn-discord btn-lg">
            <span><%= t('home.btnDiscordServer') %></span>
          </a>
        <% } %>
      </div>
    </div>

    <!-- Sağ Sütun (Mobilde Üstte Ortada): Büyük Şeffaf Logo + Mor Parıltı -->
    <div class="hero-logo-col">
      <div class="hero-logo-stage">
        <div class="hero-logo-glow" aria-hidden="true"></div>
        <div class="hero-logo-enter">
          <div class="hero-logo-float">
            <picture>
              <source
                type="image/webp"
                srcset="<%= heroBrandAssets.logo512 %> 512w, <%= heroBrandAssets.logo768 %> 768w, <%= heroBrandAssets.logo1024 %> 1024w"
                sizes="(max-width: 640px) 82vw, 520px"
              />
              <img
                src="<%= heroBrandAssets.logo1024 %>"
                alt="<%= t('brand.heroLogoAlt') %>"
                width="1024"
                height="1024"
                fetchpriority="high"
                decoding="async"
                class="hero-logo-img"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../layouts/footer') %>
