<%- include('../layouts/header') %>

<%
  const heroBrandAssets = (typeof brandConfig !== 'undefined' && brandConfig && brandConfig.ASSETS)
    ? brandConfig.ASSETS
    : {
        logo512: '/img/brand/logo-512.webp?v=1',
        logo768: '/img/brand/logo-768.webp?v=1',
        logo1024: '/img/brand/logo-1024.webp?v=1',
      };
  const discordInviteUrl = (typeof brandConfig !== 'undefined' && brandConfig && typeof brandConfig.getDiscordInviteUrl === 'function')
    ? brandConfig.getDiscordInviteUrl()
    : ((typeof brandConfig !== 'undefined' && brandConfig && brandConfig.DISCORD_INVITE_URL) ? brandConfig.DISCORD_INVITE_URL : '');
  const safeHeroStats = (typeof activeStats !== 'undefined' && activeStats && typeof activeStats === 'object') ? activeStats : {};
  const heroActiveCount = (typeof safeHeroStats.activeThisMonth === 'number' && Number.isFinite(safeHeroStats.activeThisMonth))
    ? safeHeroStats.activeThisMonth
    : ((typeof safeHeroStats.activeRegisteredCount === 'number' && Number.isFinite(safeHeroStats.activeRegisteredCount))
      ? safeHeroStats.activeRegisteredCount
      : null);
  const heroPlayingNow = (typeof safeHeroStats.playingNow === 'number' && Number.isFinite(safeHeroStats.playingNow))
    ? safeHeroStats.playingNow
    : null;
  const heroLegacyMode = Boolean(safeHeroStats.legacyMode);
  const heroStale = Boolean(safeHeroStats.stale || safeHeroStats.refreshFailed);
  const hasLiveMemberCount = heroActiveCount !== null;
  const homeGames = [
    { emoji: '🧱', titleKey: 'home.gameRobloxTitle', descKey: 'home.gameRobloxDesc' },
    { emoji: '🔫', titleKey: 'home.gameCs2Title', descKey: 'home.gameCs2Desc' },
    { emoji: '🪖', titleKey: 'home.gameZulaTitle', descKey: 'home.gameZulaDesc' },
    { emoji: '⛏️', titleKey: 'home.gameMinecraftTitle', descKey: 'home.gameMinecraftDesc' },
  ];
  const homeFeatures = [
    { titleKey: 'home.why1Title', descKey: 'home.why1Desc' },
    { titleKey: 'home.why2Title', descKey: 'home.why2Desc' },
    { titleKey: 'home.why3Title', descKey: 'home.why3Desc' },
    { titleKey: 'home.why4Title', descKey: 'home.why4Desc' },
  ];
  const homeFaqs = [
    { qKey: 'home.faq1Q', aKey: 'home.faq1A', open: true },
    { qKey: 'home.faq2Q', aKey: 'home.faq2A', open: false },
    { qKey: 'home.faq3Q', aKey: 'home.faq3A', open: false },
    { qKey: 'home.faq4Q', aKey: 'home.faq4A', open: false },
  ];
  const initialTopGames = (typeof topGames !== 'undefined' && topGames && typeof topGames === 'object')
    ? topGames
    : { scope: 'month', families: [], games: [], totalSeconds: 0, since: null, computedAt: null, stale: false, preparing: false, offline: false };
  const initialGamesList = Array.isArray(initialTopGames.games) ? initialTopGames.games : [];
  const leaderSeconds = initialGamesList.length > 0 ? Math.max(1, Number(initialGamesList[0].seconds) || 1) : 1;
  const currentLang = (typeof lang !== 'undefined' && lang === 'en') ? 'en' : 'tr';
  const rankMedals = ['🥇', '🥈', '🥉'];
  function formatHomeDuration(sec, lng) {
    if (typeof formatDuration === 'function') {
      return formatDuration(sec, lng);
    }
    const isEn = lng === 'en';
    const raw = Number(sec);
    if (!Number.isFinite(raw) || raw <= 0) return isEn ? '0 min' : '0 dk';
    if (raw < 60) return isEn ? '<1 min' : "1 dk'dan az";
    const totalMin = Math.floor(Math.floor(raw) / 60);
    const hrs = Math.floor(totalMin / 60);
    const mins = totalMin % 60;
    if (hrs === 0) return isEn ? (mins + ' min') : (mins + ' dk');
    if (mins === 0) return isEn ? (hrs + ' hr') : (hrs + ' sa');
    return isEn ? (hrs + ' hr ' + mins + ' min') : (hrs + ' sa ' + mins + ' dk');
  }
  const heroUpdatedRelative = (typeof formatRelativeUpdated === 'function' && safeHeroStats.computedAt)
    ? formatRelativeUpdated(safeHeroStats.computedAt, currentLang)
    : '';
  const topGamesUpdatedRelative = (typeof formatRelativeUpdated === 'function' && initialTopGames.computedAt)
    ? formatRelativeUpdated(initialTopGames.computedAt, currentLang)
    : '';
%>

<!-- ==============================================================================
 * ANASAYFA HERO ALANI (Piyade World | Piyade Dünyası)
 * ============================================================================== -->
<section class="hero-section">
  <div class="hero-split">
    <!-- Sol Sütun (Mobilde Altta): Marka Adı, Slogan ve Aksiyon Butonları -->
    <div class="hero-copy-col">
      <div class="hero-pill-wrap">
        <span class="badge badge-primary"><%= t('home.heroBadge') %></span>
      </div>

      <div class="home-hero-copy-block">
        <h1 class="home-hero-h1">
          <span class="gradient-text text-glow-blue"><%= t('home.heroTitleMain') %></span>
          <span class="home-hero-h1-sub"><%= t('home.heroTitleSub') %></span>
        </h1>
        <p class="home-hero-lead">
          <%= t('home.heroSubtitle') %>
        </p>

        <% if (hasLiveMemberCount) { %>
          <div class="home-active-stats-group">
            <div class="home-active-stat-pill">
              <span class="status-dot-success"></span>
              <strong data-stat="hero-active-month" data-stat-value="<%= heroActiveCount %>"><%= heroActiveCount %></strong>
              <span><%= heroLegacyMode ? t('home.activeMembersLabel') : t('home.activeThisMonthLabel') %></span>
              <% if (!heroLegacyMode && heroPlayingNow !== null) { %>
                <span class="home-playing-now-badge">
                  <span class="status-dot-live" aria-hidden="true"></span>
                  <strong data-stat="hero-playing-now" data-stat-value="<%= heroPlayingNow %>"><%= heroPlayingNow %></strong>
                  <span><%= t('home.playingNowLabel') %></span>
                </span>
              <% } %>
            </div>
            <% if (heroUpdatedRelative || heroStale) { %>
              <div class="home-stats-meta">
                <% if (heroUpdatedRelative) { %>
                  <span class="home-stats-updated"><%= t('home.lastUpdatedPrefix') %> <%= heroUpdatedRelative %></span>
                <% } %>
                <% if (heroStale) { %>
                  <span class="stats-stale-tag">• <%= t('home.staleNotice') %></span>
                <% } %>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>

      <!-- Ana Aksiyon Butonları -->
      <div class="hero-actions">
        <% if (currentUser && typeof isRegistered !== 'undefined' && isRegistered) { %>
          <a href="/profil" class="btn btn-primary btn-lg">
            <span><%= t('home.btnMyProfile') %></span>
          </a>
        <% } else { %>
          <a href="/kayit" class="btn btn-primary btn-lg">
            <span><%= t('home.btnRegisterNow') %></span>
          </a>
        <% } %>

        <a href="/kurallar" class="btn btn-secondary btn-lg">
          <span><%= t('home.btnRules') %></span>
        </a>

        <% if (discordInviteUrl) { %>
          <a href="<%= discordInviteUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-discord btn-lg">
            <span><%= t('home.btnDiscordServer') %></span>
          </a>
        <% } %>
      </div>
    </div>

    <!-- Sağ Sütun (Mobilde Üstte Ortada): Büyük Şeffaf Logo + Mor Parıltı -->
    <div class="hero-logo-col">
      <div class="hero-logo-stage">
        <div class="hero-logo-glow" aria-hidden="true"></div>
        <div class="hero-logo-enter">
          <div class="hero-logo-float">
            <picture>
              <source
                type="image/webp"
                srcset="<%= heroBrandAssets.logo512 %> 512w, <%= heroBrandAssets.logo768 %> 768w, <%= heroBrandAssets.logo1024 %> 1024w"
                sizes="(max-width: 640px) 82vw, 520px"
              />
              <img
                src="<%= heroBrandAssets.logo1024 %>"
                alt="<%= t('brand.heroLogoAlt') %>"
                width="1024"
                height="1024"
                fetchpriority="high"
                decoding="async"
                class="hero-logo-img"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ==============================================================================
 * BÖLÜM 0: SUNUCUDA EN ÇOK OYNANAN OYUNLAR (Canlı Anonim Sıralama Tablosu)
 * ============================================================================== -->
<section
  class="home-seo-section home-topgames-section"
  id="homeTopGamesSection"
  aria-labelledby="homeTopGamesHeading"
  data-lang="<%= currentLang %>"
  data-t-since="<%= t('home.topGamesSinceNote') %>"
  data-t-players="<%= t('home.topGamesPlayers') %>"
  data-t-player-singular="<%= t('home.topGamesPlayerSingular') %>"
  data-t-share="<%= t('home.topGamesShare') %>"
  data-t-tooltip="<%= t('home.topGamesTooltip') %>"
  data-t-empty="<%= t('home.topGamesEmpty') %>"
  data-t-preparing="<%= t('home.topGamesPreparing') %>"
  data-t-error="<%= t('home.topGamesError') %>"
  data-t-stale="<%= t('home.topGamesStaleNote') %>"
  data-t-updated="<%= t('home.lastUpdatedPrefix') %>"
>
  <script type="application/json" id="initialTopGamesJson"><%- JSON.stringify(initialTopGames).replace(/</g, '\\u003c') %></script>

  <div class="glass-card topgames-card">
    <div class="topgames-header">
      <div class="topgames-heading-col">
        <span class="badge badge-purple home-section-badge"><%= t('home.topGamesBadge') %></span>
        <h2 id="homeTopGamesHeading" class="topgames-title"><%= t('home.topGamesTitle') %></h2>
        <p class="topgames-subtitle"><%= t('home.topGamesSubtitle') %></p>
      </div>

      <!-- Sekme Seçici: Bu Ay | Tüm Zamanlar -->
      <div class="topgames-tabs-col">
        <div class="topgames-tablist" role="tablist" aria-label="<%= t('home.topGamesTitle') %>">
          <button
            type="button"
            role="tab"
            id="topGamesTabMonth"
            class="topgames-tab is-active"
            aria-selected="true"
            aria-controls="topGamesListPanel"
            data-scope="month"
          >
            <span><%= t('home.topGamesTabMonth') %></span>
          </button>
          <button
            type="button"
            role="tab"
            id="topGamesTabAll"
            class="topgames-tab"
            aria-selected="false"
            aria-controls="topGamesListPanel"
            data-scope="all"
            tabindex="-1"
          >
            <span><%= t('home.topGamesTabAll') %></span>
          </button>
        </div>
        <div class="topgames-since-note" id="topGamesSinceNote" hidden></div>
      </div>
    </div>

    <% if (initialTopGames.stale && initialGamesList.length > 0) { %>
      <div class="topgames-stale-banner" id="topGamesStaleBanner"><%= t('home.topGamesStaleNote') %></div>
    <% } else { %>
      <div class="topgames-stale-banner" id="topGamesStaleBanner" hidden><%= t('home.topGamesStaleNote') %></div>
    <% } %>

    <div
      class="topgames-panel"
      id="topGamesListPanel"
      role="tabpanel"
      aria-labelledby="topGamesTabMonth"
    >
      <% if (initialGamesList.length > 0) { %>
        <div class="topgames-list" id="topGamesRowsContainer">
          <% initialGamesList.forEach(function (g, index) {
            const rankNum = index + 1;
            const gradIndex = (index % 8) + 1;
            const relativeWidth = Math.max(6, Math.min(100, Math.round((Number(g.seconds) / leaderSeconds) * 100)));
            const durText = g.formattedDuration || formatHomeDuration(g.seconds, currentLang);
            const playersNum = Number(g.players) || 0;
            const playersText = playersNum === 1
              ? t('home.topGamesPlayerSingular')
              : t('home.topGamesPlayers').replace('{count}', String(playersNum));
            const shareText = t('home.topGamesShare').replace('{percent}', String(g.percent || 0));
            const tooltipText = t('home.topGamesTooltip')
              .replace('{duration}', durText)
              .replace('{percent}', String(g.percent || 0))
              .replace('{players}', String(g.players || 0));
          %>
            <div
              class="topgames-row"
              style="--row-index: <%= index %>;"
              data-seconds="<%= g.seconds %>"
              data-hours="<%= g.hours %>"
              data-percent="<%= g.percent %>"
              data-bar-width="<%= relativeWidth %>"
              data-tooltip="<%= tooltipText %>"
              tabindex="0"
            >
              <div class="topgames-row-top">
                <div class="topgames-game-ident">
                  <span class="topgames-rank-badge <%= rankNum <= 3 ? ('topgames-rank-badge--top' + rankNum) : '' %>">
                    <%= rankNum <= 3 ? rankMedals[index] : ('#' + rankNum) %>
                  </span>
                  <span class="topgames-game-emoji" aria-hidden="true"><%= g.emoji %></span>
                  <span class="topgames-game-name"><%= g.name %></span>
                </div>

                <div class="topgames-game-stats">
                  <strong class="topgames-stat-duration" data-target-seconds="<%= g.seconds %>"><%= durText %></strong>
                  <span class="topgames-stat-pill topgames-stat-pill--share"><%= shareText %></span>
                  <% if (Number(g.players) > 0) { %>
                    <span class="topgames-stat-pill topgames-stat-pill--players">👥 <%= playersText %></span>
                  <% } %>
                </div>
              </div>

              <div class="topgames-bar-track" role="progressbar" aria-valuenow="<%= g.percent %>" aria-valuemin="0" aria-valuemax="100">
                <div
                  class="topgames-bar-fill rank-grad-<%= gradIndex %>"
                  style="width: <%= relativeWidth %>%;"
                  data-target-width="<%= relativeWidth %>"
                ></div>
              </div>
              <% if (g.breakdown && g.breakdown.formattedLine) { %>
                <div class="topgames-breakdown"><%= g.breakdown.formattedLine %></div>
              <% } %>
            </div>
          <% }); %>
        </div>
      <% } else if (initialTopGames.preparing) { %>
        <div class="topgames-empty-state" id="topGamesRowsContainer">
          <div class="topgames-empty-icon" aria-hidden="true">⏳</div>
          <p class="topgames-empty-text"><%= t('home.topGamesPreparing') %></p>
        </div>
      <% } else if (initialTopGames.offline) { %>
        <div class="topgames-empty-state" id="topGamesRowsContainer">
          <div class="topgames-empty-icon" aria-hidden="true">📡</div>
          <p class="topgames-empty-text"><%= t('home.topGamesError') %></p>
        </div>
      <% } else { %>
        <div class="topgames-empty-state" id="topGamesRowsContainer">
          <div class="topgames-empty-icon" aria-hidden="true">🎮</div>
          <p class="topgames-empty-text"><%= t('home.topGamesEmpty') %></p>
        </div>
      <% } %>
    </div>

    <div class="topgames-footer">
      <span class="topgames-anon-note">🔒 <%= t('home.topGamesAnonNote') %></span>
      <span class="topgames-updated-note" id="topGamesUpdatedNote"<% if (!topGamesUpdatedRelative) { %> hidden<% } %>>
        <% if (topGamesUpdatedRelative) { %><%= t('home.lastUpdatedPrefix') %> <%= topGamesUpdatedRelative %><% } %>
      </span>
    </div>
  </div>
</section>

<!-- ==============================================================================
 * BÖLÜM 1: PİYADE DÜNYASI'NDAKİ OYUNLARIMIZ (Roblox, CS2, Zula, Minecraft)
 * ============================================================================== -->
<section class="home-seo-section" aria-labelledby="homeGamesHeading">
  <div class="home-section-header">
    <span class="badge badge-purple home-section-badge"><%= t('home.gamesBadge') %></span>
    <h2 id="homeGamesHeading" class="home-section-title"><%= t('home.gamesHeading') %></h2>
    <p class="home-section-desc"><%= t('home.gamesSubheading') %></p>
  </div>

  <div class="home-games-grid">
    <% homeGames.forEach(function (g) { %>
      <article class="glass-card glass-card-hover home-game-card">
        <div class="home-game-card-top">
          <span class="home-game-icon" aria-hidden="true"><%= g.emoji %></span>
          <h3 class="home-game-title"><%= t(g.titleKey) %></h3>
        </div>
        <p class="home-game-desc"><%= t(g.descKey) %></p>
        <a href="/kayit" class="home-game-link">
          <span><%= t('home.gameCardCta') %></span>
        </a>
      </article>
    <% }); %>
  </div>
</section>

<!-- ==============================================================================
 * BÖLÜM 2: NEDEN PİYADE WORLD (PİYADE DÜNYASI)?
 * ============================================================================== -->
<section class="home-seo-section" aria-labelledby="homeWhyHeading">
  <div class="home-section-header">
    <span class="badge badge-primary home-section-badge"><%= t('home.whyBadge') %></span>
    <h2 id="homeWhyHeading" class="home-section-title"><%= t('home.whyHeading') %></h2>
    <p class="home-section-desc"><%= t('home.whySubheading') %></p>
  </div>

  <div class="home-why-grid">
    <% homeFeatures.forEach(function (f) { %>
      <article class="glass-card home-why-card">
        <h3 class="home-why-title"><%= t(f.titleKey) %></h3>
        <p class="home-why-desc"><%= t(f.descKey) %></p>
      </article>
    <% }); %>
  </div>
</section>

<!-- ==============================================================================
 * BÖLÜM 3: PİYADE WORLD / PİYADE DÜNYASI SIKÇA SORULAN SORULAR (SSS / FAQ)
 * ============================================================================== -->
<section class="home-seo-section home-faq-section" aria-labelledby="homeFaqHeading">
  <div class="home-section-header">
    <span class="badge badge-purple home-section-badge"><%= t('home.faqBadge') %></span>
    <h2 id="homeFaqHeading" class="home-section-title"><%= t('home.faqHeading') %></h2>
    <p class="home-section-desc"><%= t('home.faqSubheading') %></p>
  </div>

  <div class="home-faq-list">
    <% homeFaqs.forEach(function (faq) { %>
      <details class="glass-card home-faq-item" <%= faq.open ? 'open' : '' %>>
        <summary class="home-faq-question">
          <h3 class="home-faq-q-title"><%= t(faq.qKey) %></h3>
        </summary>
        <div class="home-faq-answer">
          <p><%= t(faq.aKey) %></p>
        </div>
      </details>
    <% }); %>
  </div>
</section>

<%- include('../layouts/footer', { isHomePage: true }) %>
