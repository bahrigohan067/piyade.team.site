<%- include('../layouts/header') %>

<!-- ==============================================================================
 * 1. HERO TANITIM ALANI (OBSIDIAN DARK & GLOWING TYPOGRAPHY)
 * ============================================================================== -->
<section style="padding: 3.5rem 0 2.5rem; text-align: center; position: relative;">
  
  <!-- Üst Duyuru Rozeti (Announcement Pill) -->
  <div style="display: flex; justify-content: center; margin-bottom: 1.5rem;">
    <div class="glass-card" style="display: inline-flex; align-items: center; gap: 8px; padding: 6px 16px; border-radius: 9999px; border-color: rgba(59, 130, 246, 0.3); font-size: 0.85rem; box-shadow: 0 4px 20px rgba(59, 130, 246, 0.15);">
      <span class="status-dot-ping"></span>
      <span style="font-weight: 700; color: #ffffff;">Piyade Team Web Portalı</span>
      <span style="color: var(--text-dim);">|</span>
      <span style="color: #60a5fa; font-weight: 600;">The Strongest Battlegrounds</span>
    </div>
  </div>

  <!-- Hero Başlık -->
  <div style="max-width: 900px; margin: 0 auto 1.5rem;">
    <h1 style="font-size: clamp(2.4rem, 6vw, 4.25rem); font-weight: 900; line-height: 1.1; letter-spacing: -0.03em; margin-bottom: 1.25rem;">
      <span class="gradient-text text-glow-blue">Piyade Team</span> <br />
      The Strongest Battlegrounds'ın <br />
      En Prestijli Savaş Klanı
    </h1>
    <p style="font-size: clamp(1rem, 2vw, 1.2rem); color: var(--text-secondary); max-width: 720px; margin: 0 auto 2.25rem; line-height: 1.7;">
      Roblox TSB evreninde birlik, rekabet ve sarsılmaz disiplini buluşturan elit savaş klanı. Seviyeni kanıtla, VS kapışmalarında yüksel ve klanınla zaferin tadını çıkar.
    </p>
  </div>

  <!-- Ana Aksiyon Butonları -->
  <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-bottom: 3.5rem;">
    <% if (!currentUser) { %>
      <a href="/auth/discord" class="btn btn-discord btn-lg">
        <span>🎮 Discord ile Giriş Yap</span>
      </a>
      <a href="/kayit" class="btn btn-primary btn-lg">
        <span>📝 Klan Başvurusu Yap</span>
      </a>
    <% } else if (typeof isRegistered !== 'undefined' && isRegistered) { %>
      <a href="/profil" class="btn btn-primary btn-lg">
        <span>👤 Profilime Git</span>
      </a>
      <a href="/takviye" class="btn btn-danger btn-lg">
        <span>🚨 Acil Takviye Çağır</span>
      </a>
    <% } else { %>
      <a href="/kayit" class="btn btn-primary btn-lg">
        <span>📝 Kayıt Başvurusu Yap</span>
      </a>
    <% } %>
    <a href="/kurallar" class="btn btn-secondary btn-lg">
      <span>📜 Genel Kurallar</span>
    </a>
    <a href="/etkilesim" class="btn btn-blur btn-lg">
      <span>🎯 Atış & Gökyüzü</span>
    </a>
  </div>

  <!-- Canlı Metrik Kartları (Live Metrics Grid) -->
  <div class="grid grid-4" style="margin-bottom: 4rem;">
    <div class="stat-card">
      <div class="stat-header">
        <span class="stat-label">Klan Durumu</span>
        <span class="status-dot-success"></span>
      </div>
      <div class="stat-value" style="color: var(--color-success); font-size: 1.6rem;">
        ÇEVRİMİÇİ
      </div>
      <div class="stat-desc">
        TSB Sunucuları Aktif
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-header">
        <span class="stat-label">Aktif Kayıtlı</span>
        <span style="font-size: 1.2rem;">👥</span>
      </div>
      <div class="stat-value" style="color: #60a5fa; font-size: 1.6rem;">
        <%= (typeof activeStats !== 'undefined' && activeStats.activeRegisteredCount) ? activeStats.activeRegisteredCount : 0 %>
      </div>
      <div class="stat-desc">
        Doğrulanmış Klan Savaşçısı
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-header">
        <span class="stat-label">Tryout Sistemi</span>
        <span style="font-size: 1.2rem;">🏆</span>
      </div>
      <div class="stat-value" style="color: #c084fc; font-size: 1.6rem;">
        37 KADEME
      </div>
      <div class="stat-desc">
        Sezon 1 Dereceli Sıralama
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-header">
        <span class="stat-label">Acil Takviye</span>
        <span style="font-size: 1.2rem;">🚨</span>
      </div>
      <div class="stat-value" style="color: var(--color-warning); font-size: 1.6rem;">
        7/24 HAZIR
      </div>
      <div class="stat-desc">
        Bot Entegre Hızlı Çağrı
      </div>
    </div>
  </div>

</section>

<!-- ==============================================================================
 * 2. KLAN SÜTUNLARI VE ÖZELLİK KARTLARI
 * ============================================================================== -->
<section style="margin-bottom: 4rem;">
  <div style="text-align: center; margin-bottom: 2.5rem;">
    <span class="badge badge-primary" style="margin-bottom: 0.5rem;">Klan Özellikleri</span>
    <h2 style="font-size: 2rem;">Piyade Team'i Güçlü Kılan Ayrıcalıklar</h2>
    <p style="color: var(--text-muted); max-width: 600px; margin: 0 auto;">
      Roblox ve Discord altyapımız, botumuzun güçlü REST API'si ile kesintisiz olarak senkronize çalışır.
    </p>
  </div>

  <div class="grid grid-4">
    
    <div class="glass-card glass-card-hover" style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <div style="font-size: 2rem; margin-bottom: 1rem;">🏆</div>
        <h3 class="card-title" style="margin-bottom: 0.5rem;">37 Kademeli Tryout</h3>
        <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6;">
          Low weak 4 seviyesinden High strong 0 zirvesine uzanan profesyonel yetenek değerlendirme hiyerarşisi.
        </p>
      </div>
      <div style="margin-top: 1.25rem;">
        <a href="/tryout" style="font-size: 0.85rem; font-weight: 700; color: #60a5fa;">Sıralamayı Gör &rarr;</a>
      </div>
    </div>

    <div class="glass-card glass-card-hover" style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <div style="font-size: 2rem; margin-bottom: 1rem;">⚔️</div>
        <h3 class="card-title" style="margin-bottom: 0.5rem;">Resmi VS & Top 10</h3>
        <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6;">
          Yetkili gözetiminde 48 saatlik özel odalarda gerçekleşen resmi klan karşılaşmaları ve puan tablosu.
        </p>
      </div>
      <div style="margin-top: 1.25rem;">
        <a href="/profil" style="font-size: 0.85rem; font-weight: 700; color: #c084fc;">İstatistikler &rarr;</a>
      </div>
    </div>

    <div class="glass-card glass-card-hover" style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <div style="font-size: 2rem; margin-bottom: 1rem;">🚨</div>
        <h3 class="card-title" style="margin-bottom: 0.5rem;">Acil Takviye Sistemi</h3>
        <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6;">
          Oyunda baskın anında tek tıkla klandan yardım çağır. Botumuz aktif üyelere anında Roblox linkini iletir.
        </p>
      </div>
      <div style="margin-top: 1.25rem;">
        <a href="/takviye" style="font-size: 0.85rem; font-weight: 700; color: var(--color-danger);">Takviye Paneli &rarr;</a>
      </div>
    </div>

    <div class="glass-card glass-card-hover" style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <div style="font-size: 2rem; margin-bottom: 1rem;">🛡️</div>
        <h3 class="card-title" style="margin-bottom: 0.5rem;">Şeffaf Sicil & Ceza</h3>
        <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6;">
          Otomatik 30 gün puan silinme kuralı, adil hiyerarşi ve şeffaf ceza puanı yönetimi.
        </p>
      </div>
      <div style="margin-top: 1.25rem;">
        <a href="/kurallar" style="font-size: 0.85rem; font-weight: 700; color: var(--color-success);">Kuralları Oku &rarr;</a>
      </div>
    </div>

  </div>
</section>

<!-- ==============================================================================
 * 3. SCROLL REVEAL METNİ (KLAN MANİFESTOSU)
 * ============================================================================== -->
<section class="scroll-reveal-section" style="padding: 4rem 1rem 5rem;">
  <div style="margin-bottom: 1.5rem;">
    <span class="badge badge-primary">Piyade Manifestosu</span>
  </div>
  <div class="scroll-reveal-line">Hız için inşa edildi.</div>
  <div class="scroll-reveal-line">Disiplinle yoğruldu.</div>
  <div class="scroll-reveal-line gradient-text text-glow-blue">Piyade Team | TSB Zirvesi.</div>
</section>

<!-- ==============================================================================
 * 4. METEORS COMPONENT (DİLEK GÖKYÜZÜ)
 * ============================================================================== -->
<section style="margin-bottom: 4rem;">
  <div class="meteors-container" id="meteorsContainer">
    <div style="pointer-events: none; text-align: center; z-index: 10;">
      <h2 style="font-size: clamp(2rem, 5vw, 3.25rem); font-weight: 900; letter-spacing: -0.045em; color: #fff; text-shadow: 0 0 35px rgba(96, 165, 250, 0.9);">
        Make a wish.
      </h2>
      <p style="margin-top: 0.75rem; font-size: 0.95rem; color: rgba(255, 255, 255, 0.75);">
        Click the sky to call one down. (Gökyüzüne tıkla, yıldızını kaydır.)
      </p>
    </div>
  </div>
</section>

<!-- ==============================================================================
 * 5. ALT BİLGİ & DISCORD ÇAĞRI KARTI
 * ============================================================================== -->
<div class="glass-card" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem; border-left: 4px solid #3b82f6; background: rgba(14, 17, 26, 0.85);">
  <div>
    <h3 style="margin-bottom: 0.35rem; color: #ffffff;">Discord Sunucumuza Katılın</h3>
    <p style="margin: 0; font-size: 0.925rem; color: var(--text-secondary);">
      Turnuva duyuruları, canlı ses odaları ve anlık takviye pencereleri için resmi topluluğumuzdasınız.
    </p>
  </div>
  <div style="display: flex; gap: 1rem; align-items: center;">
    <a href="https://discord.gg" target="_blank" rel="noopener" class="btn btn-discord">
      <span>Discord Sunucusuna Git &rarr;</span>
    </a>
  </div>
</div>

<%- include('../layouts/footer') %>
