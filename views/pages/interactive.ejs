<%- include('../layouts/header') %>

<%
  const dartI18nPayload = {
    unratedScore: t('interactive.dartUnratedScore'),
    unratedWord: t('interactive.dartUnratedWord'),
    initialFeedback: t('interactive.dartInitialFeedback'),
    words: {
      1: t('interactive.dartWords.1'),
      2: t('interactive.dartWords.2'),
      3: t('interactive.dartWords.3'),
      4: t('interactive.dartWords.4'),
      5: t('interactive.dartWords.5'),
      6: t('interactive.dartWords.6'),
      7: t('interactive.dartWords.7'),
      8: t('interactive.dartWords.8'),
      9: t('interactive.dartWords.9'),
      10: t('interactive.dartWords.10'),
    },
    feedbacks: {
      1: t('interactive.dartFeedbacks.1'),
      2: t('interactive.dartFeedbacks.2'),
      3: t('interactive.dartFeedbacks.3'),
      4: t('interactive.dartFeedbacks.4'),
      5: t('interactive.dartFeedbacks.5'),
      6: t('interactive.dartFeedbacks.6'),
      7: t('interactive.dartFeedbacks.7'),
      8: t('interactive.dartFeedbacks.8'),
      9: t('interactive.dartFeedbacks.9'),
      10: t('interactive.dartFeedbacks.10'),
    },
  };
%>

<div class="interactive-hero-header">
  <span class="badge badge-purple" style="margin-bottom: 0.75rem;"><%= t('interactive.badgeTop') %></span>
  <h1 class="interactive-hero-title">
    <%= t('interactive.headingPart1') %> <span class="gradient-text"><%= t('interactive.headingPart2') %></span>
  </h1>
  <p class="interactive-hero-desc">
    <%= t('interactive.subheading') %>
  </p>
</div>

<!-- ==============================================================================
 * BÖLÜM 1: DART RATING (NEXUS UI DART-RATING — MOR TEMA & ERİŞİLEBİLİR SLIDER)
 * ============================================================================== -->
<section class="dart-section">
  <div class="dart-header">
    <h2 class="dart-title"><%= t('interactive.dartTitle') %></h2>
    <p class="dart-subtitle">
      <%= t('interactive.dartDesc') %> <br />
      <span class="dart-tip-label"><%= t('interactive.dartTipLabel') %></span> <%= t('interactive.dartTipText') %>
    </p>
  </div>

  <div
    class="glass-card dart-card"
    id="dartRatingCard"
    data-dart-i18n="<%= JSON.stringify(dartI18nPayload) %>"
  >
    <!-- İnteraktif Dart Hedef Tahtası (Gerçek ARIA Slider) -->
    <div
      class="dartboard-wrapper"
      id="dartboardWrapper"
      role="slider"
      tabindex="0"
      aria-label="<%= t('interactive.dartAriaLabel') %>"
      aria-valuemin="1"
      aria-valuemax="10"
      aria-valuetext="<%= t('interactive.dartUnratedWord') %>"
    >
      <svg class="dartboard-svg" viewBox="0 0 280 280" aria-hidden="true">
        <defs>
          <radialGradient id="bullseyeGrad" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="var(--dart-bullseye-start)" />
            <stop offset="100%" stop-color="var(--dart-bullseye-end)" />
          </radialGradient>
        </defs>

        <!-- Dış Mor Çerçeve -->
        <circle class="dart-ring-outer" cx="140" cy="140" r="135" />
        <circle class="dart-ring-inner-bg" cx="140" cy="140" r="131" />

        <!-- 10 Eşit Aralıklı Mor Halka (13px adım = 130..13) -->
        <circle class="dart-ring-odd" cx="140" cy="140" r="130" />
        <circle class="dart-ring-even" cx="140" cy="140" r="117" />
        <circle class="dart-ring-odd" cx="140" cy="140" r="104" />
        <circle class="dart-ring-even" cx="140" cy="140" r="91" />
        <circle class="dart-ring-odd" cx="140" cy="140" r="78" />
        <circle class="dart-ring-even" cx="140" cy="140" r="65" />
        <circle class="dart-ring-odd-hi" cx="140" cy="140" r="52" />
        <circle class="dart-ring-even-hi" cx="140" cy="140" r="39" />
        <circle class="dart-ring-odd-hi" cx="140" cy="140" r="26" />

        <!-- Bullseye (10 Puan) -->
        <circle class="dart-ring-bullseye" cx="140" cy="140" r="13" fill="url(#bullseyeGrad)" />
      </svg>

      <!-- Titreyen Hedef Nişangahı (Reticle) -->
      <div id="dartAimReticle" class="dartboard-aim-reticle" aria-hidden="true"></div>
    </div>

    <!-- Basılı Tuttukça Dolan Güç Çubuğu -->
    <div class="dart-power-section">
      <div class="dart-power-header">
        <span><%= t('interactive.dartPowerLabel') %></span>
        <span id="dartPowerValue" class="dart-power-value">%0</span>
      </div>
      <div class="dart-power-track" aria-hidden="true">
        <div id="dartPowerFill" class="dart-power-fill"></div>
      </div>
    </div>

    <!-- Tahtanın Altında Puan, Yıldızlar ve Tek Kelime Derece -->
    <div class="dart-readout">
      <div id="dartScoreDisplay" class="dart-score-display">
        <span class="dart-score-value"><%= t('interactive.dartUnratedScore') %></span> / 10
      </div>

      <div id="dartStarsContainer" class="dart-stars-container" aria-hidden="true">
        <% for (let s = 1; s <= 10; s++) { %>
          <span class="dart-star">★</span>
        <% } %>
      </div>

      <div id="dartRatingWord" class="dart-rating-word">
        <%= t('interactive.dartUnratedWord') %>
      </div>

      <div id="dartFeedbackDisplay" class="dart-feedback-display">
        <%= t('interactive.dartInitialFeedback') %>
      </div>
    </div>

    <!-- Sıfırlama Butonu -->
    <div class="dart-actions">
      <button type="button" id="btnClearDarts" class="btn btn-secondary btn-sm dart-reset-btn">
        <span><%= t('interactive.btnClearBoard') %></span>
      </button>
    </div>
  </div>
</section>

<!-- ==============================================================================
 * BÖLÜM 2: METEORS (NEXUS UI METEORS — TEK CANVAS KATMANLI GÖKYÜZÜ)
 * ============================================================================== -->
<section style="margin-bottom: 5rem;">
  <div class="meteors-section-header">
    <h2 class="meteors-section-title"><%= t('interactive.meteorsSectionTitle') %></h2>
    <p class="meteors-section-desc">
      <%= t('interactive.meteorsSectionDesc') %>
    </p>
  </div>

  <div
    class="meteors-container"
    id="meteorsContainer"
    data-meteors-config="<%= JSON.stringify(typeof meteorsConfig !== 'undefined' ? meteorsConfig : {}) %>"
  >
    <div class="meteors-overlay">
      <h2 class="meteors-title">
        <%= t('home.meteorsTitle') %>
      </h2>
      <p class="meteors-subtitle">
        <%= t('home.meteorsSubtitle') %>
      </p>
    </div>
  </div>
</section>

<!-- ==============================================================================
 * BÖLÜM 3: SCROLL REVEAL TEXT (AŞAĞI KAYDIRINCA AÇILAN METİN)
 * ============================================================================== -->
<section class="scroll-reveal-section">
  <div class="manifesto-badge-wrap">
    <span class="badge badge-purple"><%= t('interactive.manifestoBadge') %></span>
  </div>

  <div class="scroll-reveal-line"><%= t('home.manifestoLine1') %></div>
  <div class="scroll-reveal-line"><%= t('home.manifestoLine2') %></div>
  <div class="scroll-reveal-line gradient-text text-glow-purple"><%= t('home.manifestoLine3') %></div>

  <div class="manifesto-hint">
    <%= t('interactive.manifestoHint') %>
  </div>
</section>

<%- include('../layouts/footer') %>
