<%- include('../layouts/header') %>

<div class="interactive-hero">
  <span class="badge badge-purple" style="margin-bottom: 0.75rem;"><%= t('interactive.badgeTop') %></span>
  <h1 style="font-size: 2.5rem; margin-bottom: 0.5rem;">
    <%= t('interactive.headingPart1') %> <span class="gradient-text"><%= t('interactive.headingPart2') %></span>
  </h1>
  <p class="interactive-subtitle">
    <%= t('interactive.subheading') %>
  </p>
</div>

<!-- ==============================================================================
 * BÖLÜM 1: DART RATING (NEXUS UI DART-RATING — BAĞIMSIZ VANİLLA JS + MOR TEMA)
 * ============================================================================== -->
<section class="interactive-section">
  <div class="interactive-section-header">
    <h2><%= t('interactive.dartTitle') %></h2>
    <p class="interactive-section-desc">
      <%= t('interactive.dartDesc') %> <br />
      <span class="dart-tip-accent"><%= t('interactive.dartTipLabel') %></span> <%= t('interactive.dartTipText') %>
    </p>
  </div>

  <div
    class="glass-card dart-rating-widget"
    id="dartRatingWidget"
    data-dart-config="<%= typeof nexusConfig !== 'undefined' && nexusConfig ? JSON.stringify(nexusConfig.dartRating) : '{}' %>"
    data-dart-i18n="<%= JSON.stringify({
      notRated: t('interactive.dartNotRated'),
      dash: t('interactive.dartNoScoreDash'),
      holdPrompt: t('interactive.dartHoldPrompt'),
      words: {
        1: t('interactive.dartWords.1'),
        2: t('interactive.dartWords.2'),
        3: t('interactive.dartWords.3'),
        4: t('interactive.dartWords.4'),
        5: t('interactive.dartWords.5'),
        6: t('interactive.dartWords.6'),
        7: t('interactive.dartWords.7'),
        8: t('interactive.dartWords.8'),
        9: t('interactive.dartWords.9'),
        10: t('interactive.dartWords.10')
      }
    }) %>"
  >
    <!-- İnteraktif Nişan Tahtası (Gerçek ARIA Slider: role="slider") -->
    <div
      class="dartboard-wrapper"
      id="dartboardWrapper"
      role="slider"
      tabindex="0"
      aria-label="<%= t('interactive.dartAriaLabel') %>"
      aria-valuemin="1"
      aria-valuemax="10"
      aria-valuenow="0"
      aria-valuetext="<%= t('interactive.dartNotRated') %>"
    >
      <svg class="dartboard-svg" id="dartboardSvg" viewBox="0 0 280 280" aria-hidden="true">
        <defs>
          <radialGradient id="bullseyeGrad" cx="50%" cy="50%" r="50%">
            <stop offset="0%" class="dart-bullseye-stop-start" />
            <stop offset="100%" class="dart-bullseye-stop-end" />
          </radialGradient>
        </defs>

        <!-- Dış Metalik Çerçeve -->
        <circle cx="140" cy="140" r="136" class="dart-svg-outer" />
        <circle cx="140" cy="140" r="131" class="dart-svg-bezel" />

        <!-- 10 Kademeli Mor Tema Halkaları (Dış 1 -> Merkez 10 Bullseye) -->
        <circle cx="140" cy="140" r="130" class="dart-ring dart-ring--odd" />
        <circle cx="140" cy="140" r="117" class="dart-ring dart-ring--even" />
        <circle cx="140" cy="140" r="104" class="dart-ring dart-ring--odd" />
        <circle cx="140" cy="140" r="91" class="dart-ring dart-ring--even" />
        <circle cx="140" cy="140" r="78" class="dart-ring dart-ring--odd" />
        <circle cx="140" cy="140" r="65" class="dart-ring dart-ring--even" />
        <circle cx="140" cy="140" r="52" class="dart-ring dart-ring--inner-odd" />
        <circle cx="140" cy="140" r="39" class="dart-ring dart-ring--inner-even" />
        <circle cx="140" cy="140" r="26" class="dart-ring dart-ring--inner-odd" />
        <circle cx="140" cy="140" r="13" class="dart-ring dart-ring--bullseye" />
      </svg>

      <!-- Nişangah (Reticle: Basılı tutunca görünür ve titremesi artar) -->
      <div id="dartAimReticle" class="dartboard-aim-reticle" aria-hidden="true"></div>
    </div>

    <!-- Atış Gücü Çubuğu -->
    <div class="dart-power-meter" aria-hidden="true">
      <div class="dart-power-header">
        <span class="dart-power-label"><%= t('interactive.dartPowerLabel') %></span>
        <span class="dart-power-percent" id="dartPowerPercent">0%</span>
      </div>
      <div class="dart-power-track">
        <div class="dart-power-fill" id="dartPowerFill"></div>
      </div>
    </div>

    <!-- Puan, Yıldızlar ve Kelime Göstergesi (Tahtanın Altında) -->
    <div class="dart-results-area">
      <div id="dartScoreDisplay" class="dart-score-display">
        <span class="dart-score-num"><%= t('interactive.dartNoScoreDash') %></span> / 10
      </div>

      <div id="dartStarsContainer" class="dart-stars-container" aria-hidden="true">
        <% for (let i = 1; i <= 10; i++) { %>
          <span class="dart-star">★</span>
        <% } %>
      </div>

      <div id="dartFeedbackDisplay" class="dart-feedback-display" aria-live="polite">
        <%= t('interactive.dartNotRated') %>
      </div>
    </div>

    <!-- Sıfırlama Butonu -->
    <div class="dart-controls">
      <button type="button" id="btnClearDarts" class="btn btn-secondary btn-sm">
        <span><%= t('interactive.btnClearBoard') %></span>
      </button>
    </div>
  </div>
</section>

<!-- ==============================================================================
 * BÖLÜM 2: METEORS (NEXUS UI METEORS — TEK CANVAS KATMANI & İMLEÇ ÇEKİMİ)
 * ============================================================================== -->
<section class="interactive-section">
  <div class="interactive-section-header">
    <h2><%= t('interactive.meteorsSectionTitle') %></h2>
    <p class="interactive-section-desc">
      <%= t('interactive.meteorsSectionDesc') %>
    </p>
  </div>

  <div
    class="meteors-container"
    id="meteorsContainer"
    data-meteors-config="<%= typeof nexusConfig !== 'undefined' && nexusConfig ? JSON.stringify(nexusConfig.meteors) : '{}' %>"
  >
    <div class="meteors-overlay">
      <h2 class="meteors-title"><%= t('home.meteorsTitle') %></h2>
      <p class="meteors-subtitle"><%= t('home.meteorsSubtitle') %></p>
    </div>
  </div>
</section>

<!-- ==============================================================================
 * BÖLÜM 3: SCROLL REVEAL TEXT (AŞAĞI KAYDIRINCA NETLEŞEN METİN)
 * ============================================================================== -->
<section class="scroll-reveal-section">
  <div style="margin-bottom: 1.5rem;">
    <span class="badge badge-purple"><%= t('interactive.manifestoBadge') %></span>
  </div>

  <div class="scroll-reveal-line"><%= t('home.manifestoLine1') %></div>
  <div class="scroll-reveal-line"><%= t('home.manifestoLine2') %></div>
  <div class="scroll-reveal-line gradient-text text-glow-purple"><%= t('home.manifestoLine3') %></div>

  <div class="interactive-manifesto-hint">
    <%= t('interactive.manifestoHint') %>
  </div>
</section>

<%- include('../layouts/footer') %>
