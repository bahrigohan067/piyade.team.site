<%- include('../layouts/header') %>

<div style="max-width: 640px; margin: 3.5rem auto; text-align: center;">
  <div class="glass-card" style="padding: 3rem 2rem; border-top: 4px solid var(--color-warning);">
    <div style="width: 72px; height: 72px; border-radius: 20px; background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.3); display: flex; align-items: center; justify-content: center; font-size: 2.2rem; margin: 0 auto 1.25rem;">
      🛡️
    </div>
    <span class="badge badge-warning" style="margin-bottom: 0.75rem;"><%= t('notRegistered.badgeTop') %></span>
    <h1 style="font-size: 1.85rem; margin-bottom: 0.75rem; color: #ffffff;"><%= t('notRegistered.heading') %></h1>

    <% if (inGuild) { %>
      <p style="color: var(--text-secondary); margin-bottom: 1.75rem; font-size: 0.95rem; line-height: 1.6;">
        <%= t('notRegistered.inGuildDesc') %>
      </p>
    <% } else { %>
      <p style="color: var(--text-secondary); margin-bottom: 1.75rem; font-size: 0.95rem; line-height: 1.6;">
        <%= t('notRegistered.notInGuildDesc') %>
      </p>
      <div style="margin-bottom: 1.5rem;">
        <a href="https://discord.gg" target="_blank" rel="noopener" class="btn btn-discord">
          <span><%= t('notRegistered.btnJoinDiscord') %></span>
        </a>
      </div>
    <% } %>

    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="/kayit" class="btn btn-primary btn-lg">
        <span><%= t('notRegistered.btnRegisterNow') %></span>
      </a>
      <a href="/kurallar" class="btn btn-secondary btn-lg">
        <span><%= t('notRegistered.btnReadRules') %></span>
      </a>
    </div>

    <div style="margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--border-color); font-size: 0.85rem; color: var(--text-muted);">
      <%= t('notRegistered.footerNote') %>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
