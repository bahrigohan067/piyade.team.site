<%- include('../layouts/header') %>

<%
  const safeDiscord = (typeof profile !== 'undefined' && profile && profile.discord && typeof profile.discord === 'object')
    ? profile.discord
    : {
        id: (currentUser && currentUser.id) || '-',
        username: (currentUser && currentUser.username) || '-',
        displayName: (currentUser && currentUser.displayName) || '-',
        avatarUrl: (currentUser && currentUser.avatarUrl) || 'https://cdn.discordapp.com/embed/avatars/0.png',
        level: (currentUser && currentUser.level) || 'registered',
      };
  const displayTitle = (typeof profile !== 'undefined' && profile && profile.displayName) || safeDiscord.displayName;
  const safeReg = (typeof profile !== 'undefined' && profile && profile.registration && typeof profile.registration === 'object')
    ? profile.registration
    : null;
  const regGames = safeReg && Array.isArray(safeReg.games) ? safeReg.games : [];
  const isRegActive = Boolean(
    safeReg &&
    safeReg.registered &&
    (regGames.length > 0 || safeReg.name || safeReg.realName || safeReg.robloxUsername || safeReg.robloxId)
  );
  const safeWarn = (typeof profile !== 'undefined' && profile && profile.warnings && typeof profile.warnings === 'object')
    ? profile.warnings
    : { points: 0, tier: 0, staffWarnings: 0 };
  const activeLang = lang === 'en' ? 'en' : 'tr';

  function pickProfileGameName(item) {
    if (!item) return '';
    if (typeof item.name === 'string') return item.name;
    if (item.name && typeof item.name === 'object') {
      return activeLang === 'en' ? (item.name.en || item.name.tr || item.id) : (item.name.tr || item.name.en || item.id);
    }
    return item.id || '';
  }
%>

<!-- Üst Profil Özeti (Obsidian Glass Banner) -->
<div class="glass-card profile-banner-card">
  <div class="profile-banner-inner">
    <div class="profile-banner-identity">
      <div class="profile-avatar-wrap">
        <img
          src="<%= safeDiscord.avatarUrl || 'https://cdn.discordapp.com/embed/avatars/0.png' %>"
          alt="<%= displayTitle %>"
          width="86"
          height="86"
          loading="lazy"
          decoding="async"
          class="profile-avatar-img"
        />
        <span class="status-dot-success profile-avatar-dot"></span>
      </div>
      <div>
        <div class="profile-title-row">
          <h1 class="profile-display-name"><%= displayTitle %></h1>
          <% if (safeDiscord.level === 'developer') { %>
            <span class="badge badge-danger"><%= t('profile.roleDeveloper') %></span>
          <% } else if (safeDiscord.level === 'yonetmenlik') { %>
            <span class="badge badge-warning"><%= t('profile.roleManagement') %></span>
          <% } else { %>
            <span class="badge badge-success"><%= t('profile.roleMember') %></span>
          <% } %>
        </div>
        <p class="profile-discord-meta">
          @<%= safeDiscord.username %> • Discord ID: <code><%= safeDiscord.id %></code>
        </p>
      </div>
    </div>

    <div>
      <% if (safeReg && safeReg.robloxProfileUrl) { %>
        <a href="<%= safeReg.robloxProfileUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          <span><%= t('profile.btnOpenRoblox') %></span>
        </a>
      <% } %>
    </div>
  </div>
</div>

<!-- /profilim Discord İpucu Bandı -->
<div class="glass-card profile-discord-tip" role="note">
  <span class="profile-tip-icon" aria-hidden="true">💬</span>
  <span><%= t('profile.discordTip') %></span>
</div>

<!-- Detay Kartları Izgarası -->
<div class="grid grid-2">

  <!-- 1. Kayıt & Oyun Hesapları Kartı (Cinsiyet gösterilmez) -->
  <div class="glass-card">
    <div class="card-header">
      <h3 class="card-title"><span>📋</span> <%= t('profile.cardGamesTitle') %></h3>
      <% if (isRegActive) { %>
        <span class="badge badge-success"><%= t('profile.badgeApproved') %></span>
      <% } else { %>
        <span class="badge badge-neutral"><%= t('profile.badgeUnregistered') %></span>
      <% } %>
    </div>

    <div>
      <% if (isRegActive) { %>
        <div class="profile-reg-stack">
          <% if (safeReg.name || safeReg.realName || safeReg.registeredAt) { %>
            <div class="profile-meta-strip">
              <% if (safeReg.name || safeReg.realName) { %>
                <div>
                  <span class="profile-meta-label"><%= t('profile.labelRealName') %></span>
                  <div class="profile-meta-value"><%= safeReg.name || safeReg.realName %></div>
                </div>
              <% } %>
              <% if (safeReg.registeredAt) { %>
                <div>
                  <span class="profile-meta-label"><%= t('profile.labelRegDate') %></span>
                  <div class="profile-meta-date"><%= new Date(safeReg.registeredAt).toLocaleDateString(activeLang === 'en' ? 'en-US' : 'tr-TR') %></div>
                </div>
              <% } %>
            </div>
          <% } %>

          <% if (regGames.length > 0) { %>
            <div class="profile-games-list">
              <% regGames.forEach((gameItem, idx) => {
                   const gameTitle = pickProfileGameName(gameItem);
                   const gameLink = gameItem.profileUrl || (gameItem.id === 'roblox' ? safeReg.robloxProfileUrl : null);
                   const codeId = 'profile-game-user-' + idx;
              %>
                <div class="profile-game-card">
                  <div class="profile-game-main">
                    <div class="profile-game-head">
                      <span class="profile-game-emoji" aria-hidden="true"><%= gameItem.emoji || '🎮' %></span>
                      <span class="profile-game-name"><%= gameTitle %></span>
                    </div>
                    <div class="profile-game-user-row">
                      <code class="profile-game-code" id="<%= codeId %>"><%= gameItem.username %></code>
                    </div>
                  </div>

                  <div class="profile-game-actions">
                    <button
                      type="button"
                      class="btn btn-secondary btn-sm profile-copy-btn"
                      data-copy-text="<%= gameItem.username %>"
                      data-copy-target="<%= codeId %>"
                      data-copy-label="<%= t('profile.btnCopyUsername') %>"
                      data-copied-label="<%= t('profile.btnCopiedUsername') %>"
                      data-fallback-hint="<%= t('profile.copyFallbackHint') %>"
                    >
                      <span><%= t('profile.btnCopyUsername') %></span>
                    </button>
                    <% if (gameLink) { %>
                      <a
                        href="<%= gameLink %>"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-secondary btn-sm"
                      >
                        <span><%= t('register.robloxProfileOpen') %></span>
                      </a>
                    <% } %>
                  </div>
                  <div class="profile-copy-hint" role="status" aria-live="polite" hidden></div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <% if (safeReg.robloxUsername) { %>
              <div class="profile-legacy-row">
                <span class="profile-meta-label"><%= t('profile.labelRobloxUser') %></span>
                <div class="profile-legacy-roblox">
                  <code class="profile-game-code" id="profile-legacy-roblox-user">@<%= safeReg.robloxUsername %></code>
                  <button
                    type="button"
                    class="btn btn-secondary btn-sm profile-copy-btn"
                    data-copy-text="<%= safeReg.robloxUsername %>"
                    data-copy-target="profile-legacy-roblox-user"
                    data-copy-label="<%= t('profile.btnCopyUsername') %>"
                    data-copied-label="<%= t('profile.btnCopiedUsername') %>"
                    data-fallback-hint="<%= t('profile.copyFallbackHint') %>"
                  >
                    <span><%= t('profile.btnCopyUsername') %></span>
                  </button>
                </div>
              </div>
            <% } %>
            <div class="profile-legacy-empty" role="note">
              <span>ℹ️</span>
              <span><%= t('profile.legacyGamesEmpty') %></span>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <p class="profile-unreg-desc"><%= t('profile.unregisteredDesc') %></p>
        <a href="/kayit" class="btn btn-primary btn-sm"><%= t('profile.btnRegister') %></a>
      <% } %>
    </div>
  </div>

  <!-- 2. Disiplin & Sicil Durumu Kartı -->
  <div class="glass-card">
    <div class="card-header">
      <h3 class="card-title"><span>⚖️</span> <%= t('profile.cardDisciplineTitle') %></h3>
      <% if (safeWarn.suspendedUntil && safeWarn.suspendedUntil > Date.now()) { %>
        <span class="badge badge-danger"><%= t('profile.badgeSuspended') %></span>
      <% } else if ((safeWarn.points || 0) === 0) { %>
        <span class="badge badge-success"><%= t('profile.cleanRecord') %></span>
      <% } else { %>
        <span class="badge badge-warning"><%= safeWarn.points || 0 %> <%= t('profile.penaltyPointsSuffix') %></span>
      <% } %>
    </div>
    <div>
      <div class="profile-reg-stack">
        <div>
          <span class="profile-meta-label"><%= t('profile.labelTotalPenalty') %></span>
          <div style="font-weight: 800; font-size: 1.35rem; color: <%= (safeWarn.points || 0) > 0 ? 'var(--color-danger)' : 'var(--color-success)' %>;">
            <%= safeWarn.points || 0 %> / 15 <%= t('profile.pointsWord') %>
          </div>
          <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 2px;"><%= t('profile.jailThresholdNote') %></div>
          <% const riskPct = Math.min(100, Math.round(((safeWarn.points || 0) / 15) * 100)); %>
          <div class="progress-bar-track">
            <div class="progress-bar-fill" style="width: <%= riskPct %>%; background: <%= riskPct > 60 ? 'var(--color-danger)' : (riskPct > 0 ? 'var(--color-warning)' : 'var(--color-success)') %>;"></div>
          </div>
        </div>

        <div>
          <span class="profile-meta-label"><%= t('profile.labelCurrentWarnTier') %></span>
          <div style="font-weight: 600; color: var(--text-primary);">
            <%= safeWarn.tier ? t('profile.warningTierPrefix') + safeWarn.tier + t('profile.warnRoleDefinedSuffix') : t('profile.noActiveWarnRole') %>
          </div>
        </div>

        <% if (safeDiscord.level === 'yonetmenlik' || safeDiscord.level === 'developer') { %>
          <div>
            <span class="profile-meta-label"><%= t('profile.labelStaffWarnings') %></span>
            <div style="font-weight: 600; color: <%= (safeWarn.staffWarnings || 0) > 0 ? 'var(--color-danger)' : 'var(--text-primary)' %>;">
              <%= safeWarn.staffWarnings || 0 %> / 4 <%= t('profile.staffWarnSuffix') %>
            </div>
            <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 2px;"><%= t('profile.staffWarnNote') %></div>
          </div>
        <% } %>

        <div class="glass-card profile-amnesty-note">
          ℹ️ <%= t('profile.amnestyBoxText') %>
        </div>
      </div>
    </div>
  </div>

</div>

<%- include('../layouts/footer') %>
