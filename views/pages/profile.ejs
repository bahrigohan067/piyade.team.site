<%- include('../layouts/header') %>

<%
  const safeDiscord = (typeof profile !== 'undefined' && profile && profile.discord && typeof profile.discord === 'object')
    ? profile.discord
    : {
        id: (currentUser && currentUser.id) || '-',
        username: (currentUser && currentUser.username) || '-',
        displayName: (currentUser && currentUser.displayName) || '-',
        avatarUrl: (currentUser && currentUser.avatarUrl) || 'https://cdn.discordapp.com/embed/avatars/0.png',
        level: (currentUser && currentUser.level) || 'registered',
      };
  const safeReg = (typeof profile !== 'undefined' && profile && profile.registration && typeof profile.registration === 'object')
    ? profile.registration
    : null;
  const isRegActive = Boolean(safeReg && safeReg.registered && (safeReg.realName || safeReg.robloxUsername || safeReg.robloxId));
  const safeWarn = (typeof profile !== 'undefined' && profile && profile.warnings && typeof profile.warnings === 'object')
    ? profile.warnings
    : { points: 0, tier: 0, staffWarnings: 0 };
%>

<!-- Üst Profil Özeti (Obsidian Glass Banner) -->
<div class="glass-card" style="margin-bottom: 2rem; padding: 2rem; border-color: var(--border-color);">
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem;">
    <div style="display: flex; align-items: center; gap: 1.25rem;">
      <div style="position: relative;">
        <img
          src="<%= safeDiscord.avatarUrl || 'https://cdn.discordapp.com/embed/avatars/0.png' %>"
          alt="<%= safeDiscord.displayName %>"
          width="86"
          height="86"
          loading="lazy"
          decoding="async"
          style="width: 86px; height: 86px; border-radius: 50%; border: 3px solid var(--color-primary); box-shadow: var(--shadow-primary); object-fit: cover;"
        />
        <span class="status-dot-success" style="position: absolute; bottom: 4px; right: 4px; width: 14px; height: 14px; border: 2px solid var(--bg-body);"></span>
      </div>
      <div>
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 4px; flex-wrap: wrap;">
          <h1 style="font-size: 1.85rem; margin: 0; color: var(--text-primary);"><%= safeDiscord.displayName %></h1>
          <% if (safeDiscord.level === 'developer') { %>
            <span class="badge badge-danger"><%= t('profile.roleDeveloper') %></span>
          <% } else if (safeDiscord.level === 'yonetmenlik') { %>
            <span class="badge badge-warning"><%= t('profile.roleManagement') %></span>
          <% } else { %>
            <span class="badge badge-success"><%= t('profile.roleMember') %></span>
          <% } %>
        </div>
        <p style="margin: 0; font-size: 0.875rem; color: var(--text-muted);">
          @<%= safeDiscord.username %> • Discord ID: <code><%= safeDiscord.id %></code>
        </p>
      </div>
    </div>

    <div>
      <% if (safeReg && safeReg.robloxProfileUrl) { %>
        <a href="<%= safeReg.robloxProfileUrl %>" target="_blank" rel="noopener" class="btn btn-secondary">
          <span><%= t('profile.btnOpenRoblox') %></span>
        </a>
      <% } %>
    </div>
  </div>
</div>

<!-- Detay Kartları Izgarası -->
<div class="grid grid-2">
  
  <!-- 1. Kayıt Bilgileri Kartı -->
  <div class="glass-card">
    <div class="card-header">
      <h3 class="card-title"><span>📋</span> <%= t('profile.cardRegistrationTitle') %></h3>
      <% if (isRegActive) { %>
        <span class="badge badge-success"><%= t('profile.badgeApproved') %></span>
      <% } else { %>
        <span class="badge badge-neutral"><%= t('profile.badgeUnregistered') %></span>
      <% } %>
    </div>
    <div>
      <% if (isRegActive) { %>
        <div style="display: flex; flex-direction: column; gap: 1rem;">
          <div>
            <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;"><%= t('profile.labelRealName') %></span>
            <div style="font-weight: 700; color: var(--text-primary); font-size: 1.05rem;"><%= safeReg.realName || t('register.notSpecified') %></div>
          </div>
          <div>
            <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;"><%= t('profile.labelGender') %></span>
            <div style="font-weight: 600; color: var(--text-primary);"><%= safeReg.gender || t('register.notSpecified') %></div>
          </div>
          <% if (safeReg.robloxUsername) { %>
            <div>
              <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;"><%= t('profile.labelRobloxUser') %></span>
              <div style="font-weight: 700; color: var(--color-info); font-size: 1.05rem;">
                @<%= safeReg.robloxUsername %>
                <% if (safeReg.robloxDisplayName) { %>
                  <span style="font-size: 0.85rem; color: var(--text-muted); font-weight: normal;">(<%= safeReg.robloxDisplayName %>)</span>
                <% } %>
              </div>
            </div>
          <% } %>
          <% if (safeReg.robloxId) { %>
            <div>
              <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;"><%= t('profile.labelRobloxId') %></span>
              <div><code><%= safeReg.robloxId %></code></div>
            </div>
          <% } %>
          <% if (safeReg.registeredAt) { %>
            <div>
              <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;"><%= t('profile.labelRegDate') %></span>
              <div style="font-size: 0.875rem; color: var(--text-secondary);"><%= new Date(safeReg.registeredAt).toLocaleDateString(lang === 'en' ? 'en-US' : 'tr-TR') %></div>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <p style="color: var(--text-secondary); margin-bottom: 1rem;"><%= t('profile.noRegistrationInfo') %></p>
        <a href="/kayit" class="btn btn-primary btn-sm"><%= t('profile.btnRegister') %></a>
      <% } %>
    </div>
  </div>

  <!-- 2. Disiplin & Sicil Durumu Kartı -->
  <div class="glass-card">
    <div class="card-header">
      <h3 class="card-title"><span>⚖️</span> <%= t('profile.cardDisciplineTitle') %></h3>
      <% if (safeWarn.suspendedUntil && safeWarn.suspendedUntil > Date.now()) { %>
        <span class="badge badge-danger"><%= t('profile.badgeSuspended') %></span>
      <% } else if ((safeWarn.points || 0) === 0) { %>
        <span class="badge badge-success"><%= t('profile.cleanRecord') %></span>
      <% } else { %>
        <span class="badge badge-warning"><%= safeWarn.points || 0 %> <%= t('profile.penaltyPointsSuffix') %></span>
      <% } %>
    </div>
    <div>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div>
          <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;"><%= t('profile.labelTotalPenalty') %></span>
          <div style="font-weight: 800; font-size: 1.35rem; color: <%= (safeWarn.points || 0) > 0 ? 'var(--color-danger)' : 'var(--color-success)' %>;">
            <%= safeWarn.points || 0 %> / 15 <%= t('profile.pointsWord') %>
          </div>
          <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 2px;"><%= t('profile.jailThresholdNote') %></div>
          <% const riskPct = Math.min(100, Math.round(((safeWarn.points || 0) / 15) * 100)); %>
          <div class="progress-bar-track">
            <div class="progress-bar-fill" style="width: <%= riskPct %>%; background: <%= riskPct > 60 ? 'var(--color-danger)' : (riskPct > 0 ? 'var(--color-warning)' : 'var(--color-success)') %>;"></div>
          </div>
        </div>

        <div>
          <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;"><%= t('profile.labelCurrentWarnTier') %></span>
          <div style="font-weight: 600; color: var(--text-primary);">
            <%= safeWarn.tier ? t('profile.warningTierPrefix') + safeWarn.tier + t('profile.warnRoleDefinedSuffix') : t('profile.noActiveWarnRole') %>
          </div>
        </div>

        <% if (safeDiscord.level === 'yonetmenlik' || safeDiscord.level === 'developer') { %>
          <div>
            <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;"><%= t('profile.labelStaffWarnings') %></span>
            <div style="font-weight: 600; color: <%= (safeWarn.staffWarnings || 0) > 0 ? 'var(--color-danger)' : 'var(--text-primary)' %>;">
              <%= safeWarn.staffWarnings || 0 %> / 4 <%= t('profile.staffWarnSuffix') %>
            </div>
            <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 2px;"><%= t('profile.staffWarnNote') %></div>
          </div>
        <% } %>

        <div class="glass-card" style="padding: 0.85rem 1rem; background: var(--bg-input); font-size: 0.85rem; color: var(--text-secondary); line-height: 1.5;">
          ℹ️ <%= t('profile.amnestyBoxText') %>
        </div>
      </div>
    </div>
  </div>

</div>

<%- include('../layouts/footer') %>
