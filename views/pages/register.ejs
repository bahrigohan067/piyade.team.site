<%- include('../layouts/header') %>

<%
  const activeStep = typeof step !== 'undefined' && step ? step : (typeof tur !== 'undefined' && (tur === 'piyade' || tur === 'baska') ? 'form' : 'select');
  const activeTur = typeof tur !== 'undefined' && (tur === 'piyade' || tur === 'baska') ? tur : null;
  const safeForm = typeof formData !== 'undefined' && formData ? formData : { realName: '', gender: '', robloxInput: '', clanName: '' };
%>

<div class="register-page-container">
  
  <!-- Üst Başlık & İlerleme Adımları -->
  <div class="register-header-block">
    <span class="badge badge-primary register-top-badge"><%= t('register.badgeTop') %></span>
    <h1 class="register-main-heading"><%= t('register.heading') %></h1>
    <p class="register-main-subheading">
      <%= t('register.subheading') %>
    </p>

    <!-- 3 Aşamalı İlerleme Çubuğu -->
    <div class="register-steps-bar">
      <div class="register-step-item <%= currentUser ? 'is-done' : 'is-active' %>">
        <span class="register-step-circle">
          <%= currentUser ? '✓' : '1' %>
        </span>
        <span><%= t('register.step1') %></span>
      </div>
      <div class="register-step-divider"></div>
      <div class="register-step-item <%= state === 'pending' || state === 'approved' ? 'is-done' : (currentUser ? 'is-active' : 'is-idle') %>">
        <span class="register-step-circle">
          <%= state === 'pending' || state === 'approved' ? '✓' : '2' %>
        </span>
        <span><%= t('register.step2') %></span>
      </div>
      <div class="register-step-divider"></div>
      <div class="register-step-item <%= state === 'approved' ? 'is-done' : (state === 'pending' ? 'is-warning' : 'is-idle') %>">
        <span class="register-step-circle">
          <%= state === 'approved' ? '✓' : '3' %>
        </span>
        <span><%= t('register.step3') %></span>
      </div>
    </div>
  </div>

  <!-- Hata ve Başarı Bildirimleri -->
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger" role="alert">
      <span class="register-alert-icon">🛑</span>
      <div class="register-alert-body">
        <div><%= error %></div>
        <% if (typeof clanOwnError !== 'undefined' && clanOwnError) { %>
          <div class="register-alert-action">
            <a href="/kayit?tur=piyade" class="btn btn-primary btn-sm register-switch-own-link">
              <span>🛡️ <%= t('register.btnSwitchToPiyade') %> →</span>
            </a>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success" role="status">
      <span class="register-alert-icon">✅</span>
      <div><%= success %></div>
    </div>
  <% } %>

  <!-- DURUM 1: DİSCORD İLE GİRİŞ GEREKLİ -->
  <% if (state === 'login_required') { %>
    <div class="glass-card register-login-card">
      <div class="register-login-icon">
        🔐
      </div>
      <h2 class="register-login-title"><%= t('register.loginReqTitle') %></h2>
      <p class="register-login-desc">
        <%= t('register.loginReqDesc') %>
      </p>
      <a href="/auth/discord" class="btn btn-discord btn-lg">
        <span><%= t('register.loginReqBtn') %></span>
      </a>
    </div>

  <!-- DURUM 2: ZATEN ONAYLANDI / KAYITLI ÜYE -->
  <% } else if (state === 'approved') { %>
    <div class="glass-card register-status-card register-status-card--approved">
      <div class="register-status-head">
        <div class="register-status-icon register-status-icon--approved">
          🎉
        </div>
        <div>
          <div class="register-badge-row">
            <span class="badge badge-success"><%= t('register.approvedBadge') %></span>
            <% if (statusData && statusData.registration && statusData.registration.type === 'other') { %>
              <span class="badge badge-purple"><%= t('register.badgeOtherClan') %></span>
              <% if (statusData.registration.clan) { %>
                <span class="badge badge-neutral"><%= t('register.clanPrefix') %> <%= statusData.registration.clan %></span>
              <% } %>
            <% } else if (statusData && statusData.registration && statusData.registration.type === 'own') { %>
              <span class="badge badge-primary"><%= t('register.badgePiyadeClan') %></span>
            <% } %>
          </div>
          <h2 class="register-status-title"><%= t('register.approvedTitle') %></h2>
        </div>
      </div>
      <p class="register-status-desc">
        <%= t('register.approvedDesc') %>
      </p>

      <% if (statusData && statusData.registration) { %>
        <div class="glass-card register-summary-box">
          <div class="grid grid-2">
            <div>
              <span class="register-meta-label"><%= t('register.registeredNameLabel') %></span>
              <div class="register-meta-value"><%= statusData.registration.realName || t('register.notSpecified') %></div>
            </div>
            <div>
              <span class="register-meta-label"><%= t('register.robloxUsernameLabel') %></span>
              <div class="register-meta-value register-meta-value--accent">
                <% if (statusData.registration.robloxUsername) { %>
                  @<%= statusData.registration.robloxUsername %>
                <% } else { %>
                  <%= t('register.registeredStatus') %>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% } %>

      <div class="register-status-actions">
        <a href="/profil" class="btn btn-primary">
          <span><%= t('register.btnViewProfile') %></span>
        </a>
        <a href="/tryout" class="btn btn-secondary">
          <span><%= t('register.btnTryoutTable') %></span>
        </a>
      </div>
    </div>

  <!-- DURUM 3: BAŞVURU BEKLEMEDE -->
  <% } else if (state === 'pending') { %>
    <%
      const isPendingOther = Boolean(
        (statusData && statusData.application && statusData.application.type === 'other') ||
        activeTur === 'baska'
      );
      const pendingClanName =
        (statusData && statusData.application && statusData.application.clan) ||
        safeForm.clanName ||
        null;
    %>
    <div class="glass-card register-status-card register-status-card--pending">
      <div class="register-status-head">
        <div class="register-status-icon register-status-icon--pending">
          ⏳
        </div>
        <div>
          <div class="register-badge-row">
            <span class="badge badge-warning"><%= t('register.pendingBadge') %></span>
            <% if (isPendingOther) { %>
              <span class="badge badge-purple">🏳️ <%= t('register.badgeTypeOther') %></span>
            <% } else { %>
              <span class="badge badge-primary">🛡️ <%= t('register.badgeTypePiyade') %></span>
            <% } %>
          </div>
          <h2 class="register-status-title"><%= t('register.pendingTitle') %></h2>
        </div>
      </div>
      <p class="register-status-desc">
        <%= isPendingOther ? t('register.pendingDescOther') : t('register.pendingDesc') %>
      </p>

      <% if (statusData && statusData.application) { %>
        <div class="glass-card register-summary-box">
          <div class="grid grid-2">
            <div>
              <span class="register-meta-label"><%= t('register.applicantLabel') %></span>
              <div class="register-meta-value"><%= statusData.application.realName || currentUser.displayName %></div>
            </div>
            <div>
              <span class="register-meta-label"><%= t('register.robloxAccountLabel') %></span>
              <div class="register-meta-value register-meta-value--accent">@<%= statusData.application.robloxUsername || t('register.reviewing') %></div>
            </div>
            <% if (isPendingOther && pendingClanName) { %>
              <div>
                <span class="register-meta-label"><%= t('profile.labelClan') %></span>
                <div class="register-meta-value"><%= pendingClanName %></div>
              </div>
            <% } %>
          </div>
        </div>
      <% } %>

      <div class="register-status-actions">
        <button type="button" onclick="window.location.reload();" class="btn btn-secondary btn-sm">
          <span><%= t('register.btnRefresh') %></span>
        </button>
        <span class="register-pending-note"><%= t('register.pendingNote') %></span>
      </div>
    </div>

  <!-- DURUM 4 VE 5: REDDEDİLDİ VEYA YENİ BAŞVURU (ADIM 1 SEÇİM / ADIM 2 FORM) -->
  <% } else { %>
    <% if (state === 'rejected' && statusData && statusData.rejected) { %>
      <div class="glass-card register-rejected-card">
        <div class="register-rejected-head">
          <span class="register-alert-icon">🛑</span>
          <h3 class="register-rejected-title"><%= t('register.rejectedTitle') %></h3>
        </div>
        <p class="register-rejected-reason">
          <strong><%= t('register.rejectedReasonLabel') %></strong> <%= statusData.rejected.reason %>
        </p>
        <div class="register-rejected-hint">
          <%= t('register.rejectedHint') %>
        </div>
      </div>
    <% } %>

    <% if (activeStep === 'select' || !activeTur) { %>
      <!-- ADIM 1: KAYIT TÜRÜ SEÇİM EKRANI -->
      <div class="glass-card register-select-wrapper">
        <div class="register-select-header">
          <h2 class="register-select-title"><%= t('register.selectTypeHeading') %></h2>
          <p class="register-select-subtitle"><%= t('register.selectTypeSubheading') %></p>
        </div>

        <div class="register-type-cards" role="list">
          <!-- Seçenek 1: Piyade Klanına Katılmak İstiyorum -->
          <a
            href="/kayit?tur=piyade"
            class="register-type-card register-type-card--piyade"
            data-tur="piyade"
            role="listitem"
          >
            <div class="register-type-card-top">
              <span class="register-type-card-icon" aria-hidden="true">🛡️</span>
              <span class="badge badge-primary"><%= t('register.badgePiyadeClan') %></span>
            </div>
            <h3 class="register-type-card-title"><%= t('register.typePiyadeTitle') %></h3>
            <p class="register-type-card-desc"><%= t('register.typePiyadeDesc') %></p>
            <div class="register-type-card-cta">
              <span><%= t('register.typeSelectBtn') %></span>
              <span aria-hidden="true">→</span>
            </div>
          </a>

          <!-- Seçenek 2: Bir Klanım Bulunmakta -->
          <a
            href="/kayit?tur=baska"
            class="register-type-card register-type-card--other"
            data-tur="baska"
            role="listitem"
          >
            <div class="register-type-card-top">
              <span class="register-type-card-icon" aria-hidden="true">🏳️</span>
              <span class="badge badge-purple"><%= t('register.badgeOtherClan') %></span>
            </div>
            <h3 class="register-type-card-title"><%= t('register.typeOtherTitle') %></h3>
            <p class="register-type-card-desc"><%= t('register.typeOtherDesc') %></p>
            <div class="register-type-card-cta">
              <span><%= t('register.typeSelectBtn') %></span>
              <span aria-hidden="true">→</span>
            </div>
          </a>
        </div>
      </div>

    <% } else { %>
      <!-- ADIM 2: KAYIT BAŞVURU FORMU (?tur=piyade veya ?tur=baska) -->
      <div class="glass-card">
        <!-- Seçilen Tür Rozeti ve Seçimi Değiştir Bağlantısı -->
        <div class="register-form-topbar">
          <div class="register-selected-type">
            <% if (activeTur === 'baska') { %>
              <span class="badge badge-purple register-type-badge">🏳️ <%= t('register.badgeTypeOther') %></span>
            <% } else { %>
              <span class="badge badge-primary register-type-badge">🛡️ <%= t('register.badgeTypePiyade') %></span>
            <% } %>
          </div>
          <a href="/kayit" class="btn btn-secondary btn-sm register-change-type-link">
            <span>← <%= t('register.btnChangeSelection') %></span>
          </a>
        </div>

        <form action="/kayit" method="POST" data-prevent-double-submit="true">
          <!-- CSRF Güvenlik Anahtarı -->
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <!-- Tekil Idempotency Anahtarı (Çift Gönderimi Engeller) -->
          <input type="hidden" name="_idempotencyKey" value="<%= typeof idempotencyKey !== 'undefined' ? idempotencyKey : '' %>" />
          <!-- Seçilen Kayıt Türü ('piyade' | 'baska') -->
          <input type="hidden" name="tur" value="<%= activeTur %>" />

          <% if (activeTur === 'baska') { %>
            <div class="form-group clan-name-group">
              <div class="clan-label-row">
                <label class="form-label" for="clanName">
                  <%= t('register.labelClanName') %>
                </label>
                <span id="clanNameCounter" class="char-counter" aria-live="polite">
                  <%= (safeForm.clanName || '').length %> <%= t('register.charCounterSuffix') %>
                </span>
              </div>
              <input
                type="text"
                id="clanName"
                name="clanName"
                class="form-control"
                placeholder="<%= t('register.placeholderClanName') %>"
                value="<%= safeForm.clanName || '' %>"
                minlength="2"
                maxlength="32"
                required
              />
              <div class="form-text"><%= t('register.helpClanName') %></div>
            </div>
          <% } %>

          <div class="form-group">
            <label class="form-label" for="realName"><%= t('register.labelRealName') %></label>
            <input
              type="text"
              id="realName"
              name="realName"
              class="form-control"
              placeholder="<%= t('register.placeholderRealName') %>"
              value="<%= safeForm.realName || '' %>"
              minlength="2"
              maxlength="32"
              required
            />
            <div class="form-text"><%= t('register.helpRealName') %></div>
          </div>

          <div class="form-group">
            <label class="form-label" for="gender"><%= t('register.labelGender') %></label>
            <select id="gender" name="gender" class="form-select" required>
              <option value=""><%= t('register.selectGender') %></option>
              <option value="Erkek" <%= safeForm.gender === 'Erkek' ? 'selected' : '' %>><%= t('register.genderMale') %></option>
              <option value="Kız" <%= safeForm.gender === 'Kız' ? 'selected' : '' %>><%= t('register.genderFemale') %></option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="robloxInput"><%= t('register.labelRoblox') %></label>
            <input
              type="text"
              id="robloxInput"
              name="robloxInput"
              class="form-control"
              placeholder="<%= t('register.placeholderRoblox') %>"
              value="<%= safeForm.robloxInput || '' %>"
              required
            />
            <div class="form-text">
              ⚠️ <%= t('register.helpRoblox') %>
            </div>
          </div>

          <div class="register-form-footer">
            <div class="register-session-info">
              <%= t('register.sessionLabel') %> <strong class="register-session-user"><%= currentUser.displayName %></strong> (<code><%= currentUser.id %></code>)
            </div>
            <button type="submit" class="btn btn-primary btn-lg" data-submitting-text="<%= t('register.btnSubmitting') %>">
              <span><%= t('register.btnSubmit') %></span>
            </button>
          </div>
        </form>
      </div>
    <% } %>
  <% } %>

</div>

<%- include('../layouts/footer') %>
