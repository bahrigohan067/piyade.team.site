<%- include('../layouts/header') %>

<div style="margin-bottom: 2rem;">
  <span class="badge badge-primary">Topluluk Standartları</span>
  <h1 style="margin-top: 0.5rem; margin-bottom: 0.5rem;">📜 Piyade Team Genel Kuralları</h1>
  <p style="font-size: 1.05rem; color: var(--text-secondary); max-width: 800px;">
    Sunucumuzun huzurunu, saygılı rekabet ortamını ve adil yönetim düzenini korumak amacıyla belirlenen maddeler aşağıda listelenmiştir. Kurallar tek bir merkezi dosyadan (<code>rules.js</code>) yönetilmektedir.
  </p>
</div>

<!-- Kural Grupları -->
<% if (typeof groupedRules !== 'undefined') { %>
  <% Object.keys(groupedRules).forEach(function(groupKey) { %>
    <% const group = groupedRules[groupKey]; %>
    <div style="margin-bottom: 2.5rem;">
      <div style="margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--border-color);">
        <h2 style="font-size: 1.5rem; margin-bottom: 0.25rem;"><%= group.title %></h2>
        <p style="font-size: 0.9rem; color: var(--text-muted); margin: 0;"><%= group.subtitle %></p>
      </div>

      <div class="grid grid-2">
        <% group.rules.forEach(function(rule) { %>
          <div class="card card-interactive" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">
                <div style="display: flex; align-items: center; gap: 8px;">
                  <span class="badge <%= rule.badgeClass || 'badge-primary' %>" style="font-size: 0.85rem;"><%= rule.code %></span>
                  <strong style="color: var(--text-primary); font-size: 1.05rem;"><%= rule.title %></strong>
                </div>
              </div>
              <p style="font-size: 0.925rem; color: var(--text-secondary); margin-bottom: 1rem;">
                <%= rule.description %>
              </p>
            </div>

            <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 0.75rem; border-top: 1px solid var(--border-color); font-size: 0.85rem;">
              <span style="color: var(--text-muted);">Yaptırım / Ceza:</span>
              <span class="badge <%= rule.badgeClass || 'badge-danger' %>"><%= rule.penaltyLabel %></span>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  <% }); %>
<% } %>

<!-- 30 Günlük Otomatik Af ve Disiplin Bilgilendirme Kutusu -->
<div class="card" style="background: var(--bg-surface); border-left: 4px solid var(--color-warning); margin-top: 2rem;">
  <h3 style="color: var(--color-warning); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 8px;">
    <span>⚖️</span> Otomatik Af ve Puan Silinme Kuralı
  </h3>
  <p style="margin: 0; font-size: 0.925rem; color: var(--text-secondary);">
    Son cezasının üzerinden kesintisiz <strong>30 gün</strong> geçen ve yeni bir ceza puanı almayan oyuncuların ceza puanları ve uyarı rolleri sistem tarafından otomatik olarak temizlenir. 15 puana ulaşarak <strong>Askıda (Jail)</strong> durumuna düşen üyelerin karantina süresi 1 haftadır.
  </p>
</div>

<%- include('../layouts/footer') %>
