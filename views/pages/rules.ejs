<%- include('../layouts/header') %>

<div style="margin-bottom: 2.5rem;">
  <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 0.5rem;">
    <span class="badge badge-primary"><%= t('rules.badgeTop') %></span>
    <span class="badge badge-neutral">M1–M13 • D1–D3 • Y1–Y5</span>
  </div>
  <h1 style="font-size: 2.4rem; margin-bottom: 0.5rem;"><%= t('rules.heading') %></h1>
  <p style="font-size: 1.05rem; color: var(--text-secondary); max-width: 820px; line-height: 1.6;">
    <%= t('rules.subheading') %>
  </p>
</div>

<!-- Canlı Arama ve Kategori Filtresi -->
<div class="glass-card" style="padding: 1rem 1.25rem; margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
  <div style="flex: 1; min-width: 260px;">
    <input
      type="text"
      id="ruleSearchInput"
      class="form-control"
      placeholder="<%= t('rules.searchPlaceholder') %>"
      style="padding: 0.65rem 1rem; font-size: 0.9rem;"
    />
  </div>

  <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;" id="categoryFilterButtons">
    <button type="button" class="btn btn-secondary btn-sm active" data-category="all" style="background: rgba(59, 130, 246, 0.15); border-color: rgba(59, 130, 246, 0.35); color: #fff;">
      <%= t('rules.filterAll') %>
    </button>
    <button type="button" class="btn btn-secondary btn-sm" data-category="participant">
      <%= t('rules.filterParticipant') %>
    </button>
    <button type="button" class="btn btn-secondary btn-sm" data-category="order">
      <%= t('rules.filterOrder') %>
    </button>
    <button type="button" class="btn btn-secondary btn-sm" data-category="staff">
      <%= t('rules.filterStaff') %>
    </button>
  </div>
</div>

<!-- Kural Grupları -->
<% if (typeof groupedRules !== 'undefined') { %>
  <% Object.keys(groupedRules).forEach(function(groupKey) { %>
    <% const group = groupedRules[groupKey]; %>
    <div class="rule-group-section" data-group="<%= groupKey %>" style="margin-bottom: 3rem;">
      <div style="margin-bottom: 1.25rem; padding-bottom: 0.65rem; border-bottom: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between;">
        <div>
          <h2 style="font-size: 1.5rem; margin-bottom: 0.25rem; color: #ffffff;"><%= group.title %></h2>
          <p style="font-size: 0.875rem; color: var(--text-muted); margin: 0;"><%= group.subtitle %></p>
        </div>
        <span class="badge badge-neutral"><%= group.rules.length %> <%= t('rules.ruleCountSuffix') %></span>
      </div>

      <div class="grid grid-2">
        <% group.rules.forEach(function(rule) { %>
          <div class="glass-card glass-card-hover rule-card" data-code="<%= rule.code.toLowerCase() %>" data-title="<%= rule.title.toLowerCase() %>" data-desc="<%= rule.description.toLowerCase() %>" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.85rem;">
                <div style="display: flex; align-items: center; gap: 8px;">
                  <span class="badge <%= rule.badgeClass || 'badge-primary' %>" style="font-size: 0.85rem; font-family: var(--font-mono); font-weight: 800;">
                    <%= rule.code %>
                  </span>
                  <strong style="color: #ffffff; font-size: 1.05rem;"><%= rule.title %></strong>
                </div>
              </div>
              <p style="font-size: 0.925rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.25rem;">
                <%= rule.description %>
              </p>
            </div>

            <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 0.85rem; border-top: 1px solid rgba(255, 255, 255, 0.06); font-size: 0.85rem;">
              <span style="color: var(--text-muted);"><%= t('rules.penaltyLabel') %></span>
              <span class="badge <%= rule.badgeClass || 'badge-danger' %>" style="font-weight: 700;">
                <%= rule.penaltyLabel %>
              </span>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  <% }); %>
<% } %>

<!-- 30 Günlük Otomatik Af ve Disiplin Bilgilendirme Kutusu -->
<div class="glass-card" style="border-left: 4px solid var(--color-warning); margin-top: 2rem; background: rgba(245, 158, 11, 0.05);">
  <h3 style="color: var(--color-warning); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 8px; font-size: 1.2rem;">
    <span>⚖️</span> <%= t('rules.amnestyTitle') %>
  </h3>
  <p style="margin: 0; font-size: 0.925rem; color: var(--text-secondary); line-height: 1.6;">
    <%= t('rules.amnestyDesc') %>
  </p>
</div>

<!-- Canlı Arama ve Filtreleme Scripti -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('ruleSearchInput');
    const filterButtons = document.querySelectorAll('#categoryFilterButtons button');
    const groupSections = document.querySelectorAll('.rule-group-section');

    let activeCategory = 'all';

    function filterRules() {
      const query = (searchInput.value || '').trim().toLowerCase();

      groupSections.forEach(section => {
        const groupKey = section.getAttribute('data-group');
        let hasVisibleCards = false;

        const cards = section.querySelectorAll('.rule-card');
        cards.forEach(card => {
          const code = card.getAttribute('data-code') || '';
          const title = card.getAttribute('data-title') || '';
          const desc = card.getAttribute('data-desc') || '';

          const matchesQuery = !query || code.includes(query) || title.includes(query) || desc.includes(query);
          const matchesCategory = activeCategory === 'all' || groupKey === activeCategory;

          if (matchesQuery && matchesCategory) {
            card.style.display = 'flex';
            hasVisibleCards = true;
          } else {
            card.style.display = 'none';
          }
        });

        section.style.display = hasVisibleCards ? 'block' : 'none';
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', filterRules);
    }

    filterButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        filterButtons.forEach(b => {
          b.style.background = 'rgba(255, 255, 255, 0.05)';
          b.style.borderColor = 'var(--border-color)';
        });
        this.style.background = 'rgba(59, 130, 246, 0.2)';
        this.style.borderColor = 'rgba(59, 130, 246, 0.4)';
        activeCategory = this.getAttribute('data-category');
        filterRules();
      });
    });
  });
</script>

<%- include('../layouts/footer') %>
