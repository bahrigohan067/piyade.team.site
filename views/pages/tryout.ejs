<%- include('../layouts/header') %>

<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 2.5rem;">
  <div>
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 0.5rem;">
      <span class="badge badge-primary"><%= t('tryout.badgeTop') %></span>
      <span class="badge badge-neutral"><%= t('tryout.badgeHierarchy') %></span>
    </div>
    <h1 style="font-size: 2.2rem; margin-bottom: 0.5rem;"><%= t('tryout.heading') %></h1>
    <p style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">
      <%= t('tryout.subheading') %>
    </p>
  </div>
  <div>
    <span class="badge badge-primary" style="font-size: 0.85rem; padding: 6px 14px; font-weight: 700;">
      <%= t('tryout.totalRegisteredPrefix') %> <%= total %> <%= t('tryout.totalRegisteredSuffix') %>
    </span>
  </div>
</div>

<% if (!leaderboard || leaderboard.length === 0) { %>
  <div class="glass-card" style="text-align: center; padding: 4rem 1.5rem;">
    <div style="width: 64px; height: 64px; border-radius: 20px; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.25); display: flex; align-items: center; justify-content: center; font-size: 2rem; margin: 0 auto 1.25rem;">
      📊
    </div>
    <h3 style="color: #ffffff; font-size: 1.4rem; margin-bottom: 0.5rem;"><%= t('tryout.emptyTitle') %></h3>
    <p style="max-width: 480px; margin: 0 auto; color: var(--text-muted); font-size: 0.925rem;">
      <%= t('tryout.emptyDesc') %>
    </p>
  </div>
<% } else { %>
  <!-- Tryout Tablosu -->
  <div class="glass-card" style="padding: 0; overflow: hidden;">
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th style="width: 70px; text-align: center;"><%= t('tryout.colRank') %></th>
            <th><%= t('tryout.colMember') %></th>
            <th><%= t('tryout.colLevel') %></th>
            <th style="text-align: center;"><%= t('tryout.colTier') %></th>
            <th style="text-align: center;"><%= t('tryout.colForms') %></th>
            <th style="text-align: right;"><%= t('tryout.colUpdated') %></th>
          </tr>
        </thead>
        <tbody>
          <% leaderboard.forEach(function(entry) { %>
            <tr>
              <td style="text-align: center; font-weight: 800; font-size: 1.1rem;">
                <% if (entry.rank === 1) { %>
                  <span style="color: #ffd700;" title="#1">🥇</span>
                <% } else if (entry.rank === 2) { %>
                  <span style="color: #c0c0c0;" title="#2">🥈</span>
                <% } else if (entry.rank === 3) { %>
                  <span style="color: #cd7f32;" title="#3">🥉</span>
                <% } else { %>
                  <span style="color: var(--text-muted); font-family: var(--font-mono);">#<%= entry.rank %></span>
                <% } %>
              </td>
              <td>
                <div style="display: flex; align-items: center; gap: 10px;">
                  <img
                    src="<%= entry.avatarUrl || 'https://cdn.discordapp.com/embed/avatars/0.png' %>"
                    alt="<%= entry.displayName %>"
                    width="38"
                    height="38"
                    loading="lazy"
                    decoding="async"
                    style="width: 38px; height: 38px; border-radius: 50%; border: 1.5px solid var(--border-color); object-fit: cover;"
                  />
                  <div>
                    <strong style="color: #ffffff; font-size: 0.95rem;"><%= entry.displayName %></strong>
                    <div style="font-size: 0.8rem; color: var(--text-muted);">@<%= entry.userTag %></div>
                  </div>
                </div>
              </td>
              <td>
                <span class="badge badge-primary" style="font-size: 0.825rem; font-weight: 700;">
                  <%= entry.roleName %>
                </span>
                <% if (entry.canonical) { %>
                  <div style="font-size: 0.775rem; color: var(--text-muted); margin-top: 2px;"><%= entry.canonical %></div>
                <% } %>
              </td>
              <td style="text-align: center; font-weight: 800; color: #c084fc; font-family: var(--font-mono);">
                <%= entry.level %> / 37
              </td>
              <td style="text-align: center; font-weight: 700; color: #ffffff;">
                <%= entry.formCount %>
              </td>
              <td style="text-align: right; color: var(--text-muted); font-size: 0.85rem; font-family: var(--font-mono);">
                <%= entry.lastUpdated ? new Date(entry.lastUpdated).toLocaleDateString(lang === 'en' ? 'en-US' : 'tr-TR') : '-' %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<!-- Eğlenceli Tryout Öncesi Yetenek Testi Kartı -->
<div class="glass-card" style="margin-top: 2.5rem; text-align: center; padding: 2.25rem;">
  <span class="badge badge-primary"><%= t('tryout.dartCardBadge') %></span>
  <h2 style="margin-top: 0.5rem; margin-bottom: 0.5rem; font-size: 1.5rem;"><%= t('tryout.dartCardTitle') %></h2>
  <p style="color: var(--text-secondary); max-width: 540px; margin: 0 auto 1.5rem; font-size: 0.925rem;">
    <%= t('tryout.dartCardDesc') %>
  </p>
  <a href="/etkilesim" class="btn btn-primary">
    <span><%= t('tryout.dartCardBtn') %></span>
  </a>
</div>

<%- include('../layouts/footer') %>
