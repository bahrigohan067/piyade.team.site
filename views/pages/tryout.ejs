<%- include('../layouts/header') %>

<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
  <div>
    <span class="badge badge-primary">TSB Klan Sıralaması</span>
    <h1 style="margin-top: 0.5rem; margin-bottom: 0.5rem;">🏆 Tryout Değerlendirme Tablosu</h1>
    <p style="color: var(--text-secondary); margin: 0;">
      37 aşamalı kademe sisteminde değerlendirilen klan üyelerinin güncel sıralama listesi.
    </p>
  </div>
  <div>
    <span class="badge badge-info" style="font-size: 0.9rem; padding: 6px 12px;">
      Toplam <%= total %> Kayıtlı Değerlendirme
    </span>
  </div>
</div>

<% if (!leaderboard || leaderboard.length === 0) { %>
  <div class="card" style="text-align: center; padding: 3rem 1.5rem;">
    <div style="font-size: 3rem; margin-bottom: 1rem;">📊</div>
    <h3>Henüz Tryout Değerlendirmesi Yapılmamış</h3>
    <p style="max-width: 480px; margin: 0 auto; color: var(--text-muted);">
      Sunucumuzda yetkililer tarafından tamamlanan değerlendirmeler otomatik olarak bu tabloda sıralanacaktır.
    </p>
  </div>
<% } else { %>
  <!-- Tryout Tablosu -->
  <div class="card" style="padding: 0;">
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th style="width: 70px; text-align: center;">Sıra</th>
            <th>Üye</th>
            <th>Tryout Seviyesi</th>
            <th style="text-align: center;">Kademe</th>
            <th style="text-align: center;">Form Sayısı</th>
            <th style="text-align: right;">Son Güncelleme</th>
          </tr>
        </thead>
        <tbody>
          <% leaderboard.forEach(function(entry) { %>
            <tr>
              <td style="text-align: center; font-weight: 800; font-size: 1.1rem;">
                <% if (entry.rank === 1) { %>
                  <span style="color: #ffd700;" title="1. Sıra">🥇</span>
                <% } else if (entry.rank === 2) { %>
                  <span style="color: #c0c0c0;" title="2. Sıra">🥈</span>
                <% } else if (entry.rank === 3) { %>
                  <span style="color: #cd7f32;" title="3. Sıra">🥉</span>
                <% } else { %>
                  <span style="color: var(--text-muted);">#<%= entry.rank %></span>
                <% } %>
              </td>
              <td>
                <div style="display: flex; align-items: center; gap: 10px;">
                  <img
                    src="<%= entry.avatarUrl || 'https://cdn.discordapp.com/embed/avatars/0.png' %>"
                    alt="<%= entry.displayName %>"
                    style="width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--border-color);"
                  />
                  <div>
                    <strong style="color: var(--text-primary); font-size: 0.95rem;"><%= entry.displayName %></strong>
                    <div style="font-size: 0.8rem; color: var(--text-muted);">@<%= entry.userTag %></div>
                  </div>
                </div>
              </td>
              <td>
                <span class="badge badge-primary" style="font-size: 0.825rem; font-weight: 700;">
                  <%= entry.roleName %>
                </span>
                <% if (entry.canonical) { %>
                  <div style="font-size: 0.775rem; color: var(--text-muted); margin-top: 2px;"><%= entry.canonical %></div>
                <% } %>
              </td>
              <td style="text-align: center; font-weight: 700; color: var(--color-accent);">
                <%= entry.level %> / 37
              </td>
              <td style="text-align: center; font-weight: 600;">
                <%= entry.formCount %>
              </td>
              <td style="text-align: right; color: var(--text-muted); font-size: 0.85rem;">
                <%= entry.lastUpdated ? new Date(entry.lastUpdated).toLocaleDateString('tr-TR') : '-' %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<!-- Eğlenceli Tryout Öncesi Yetenek Testi Kartı -->
<div class="card" style="margin-top: 2.5rem; text-align: center; border: 1px solid var(--border-light); background: rgba(22, 13, 44, 0.65); padding: 2rem;">
  <span class="badge badge-primary">Eğlenceli Klan Yetenek Testi</span>
  <h2 style="margin-top: 0.5rem; margin-bottom: 0.5rem;">🎯 Nişancılık ve Refleks Testi (Dart Rating)</h2>
  <p style="color: var(--text-secondary); max-width: 540px; margin: 0 auto 1.5rem;">
    Tryout seviye değerlendirmesi öncesi elini ısıt! Basılı tutarak nişan al, bırak ve dartı tam 12'den (Bullseye) sapla.
  </p>
  <a href="/etkilesim" class="btn btn-primary">
    <span>🎯 Dart Poligonu ve Yıldız Gökyüzünü Aç</span>
  </a>
</div>

<%- include('../layouts/footer') %>
