<%
  const warriorsList = (typeof topWarriors !== 'undefined' && Array.isArray(topWarriors)) ? topWarriors : [];
  const wConfig = (typeof warriorsConfig !== 'undefined' && warriorsConfig && warriorsConfig.CAROUSEL_DEFAULTS)
    ? warriorsConfig.CAROUSEL_DEFAULTS
    : {
        itemWidth: 180,
        itemHeight: 236,
        mobileBreakpoint: 640,
        mobileItemWidth: 148,
        mobileItemHeight: 196,
        perspective: 1100,
        radius: null,
        autoRotate: false,
        autoSpeed: 1,
        scrollSpeed: 1,
        direction: 'cw',
        autoplay: false,
        enableSound: true,
        showOrderNote: true,
      };
  const numberLocale = (typeof lang !== 'undefined' && lang === 'en') ? 'en-US' : 'tr-TR';
  const formatKills = (val) => {
    const n = Number(val);
    return Number.isFinite(n) ? n.toLocaleString(numberLocale) : '0';
  };
  const count = warriorsList.length || 6;
  const firstWarrior = warriorsList.length > 0 ? warriorsList[0] : null;
  const stepDegStr = `${(360 / count).toFixed(4)}deg`;
  const carouselI18n = {
    lang: (typeof lang !== 'undefined' && lang === 'en') ? 'en' : 'tr',
    numberLocale,
    dotSelectLabel: t('warriors.dotSelectLabel'),
    activeAnnouncement: t('warriors.activeAnnouncement'),
  };
%>

<% if (warriorsList.length > 0) { %>
<section
  id="savascilar"
  class="zirve"
  aria-labelledby="warriorsSectionHeading"
  style="--item-w: <%= wConfig.itemWidth || 180 %>px; --item-h: <%= wConfig.itemHeight || 236 %>px; --gap: 28px; --step: <%= stepDegStr %>;"
>
  <header class="zirve-head">
    <div class="zirve-kicker">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true">
        <path d="M2 18h20v2H2v-2zm1-2 2-9 5 4 2-6 2 6 5-4 2 9H3z"/>
      </svg>
      <span><%= t('warriors.kicker') %></span>
    </div>
    <h2 id="warriorsSectionHeading" class="zirve-title"><%= t('warriors.sectionTitle') %></h2>
    <p class="zirve-subtitle">
      <%= t('warriors.sectionSubtitle').replace('{count}', String(warriorsList.length)) %>
    </p>
    <% if (wConfig.showOrderNote !== false) { %>
      <p class="zirve-note"><%= t('warriors.orderNote') %></p>
    <% } %>
  </header>

  <div
    id="warriorsCarouselRoot"
    class="zirve-carousel"
    data-carousel-config="<%= JSON.stringify(wConfig) %>"
    data-carousel-i18n="<%= JSON.stringify(carouselI18n) %>"
  >
    <div
      id="warriorsViewport"
      class="zirve-stage"
      tabindex="0"
      role="group"
      aria-roledescription="carousel"
      aria-label="<%= t('warriors.carouselAriaLabel') %>"
    >
      <div id="warriorsTrack" class="zirve-ring">
        <% warriorsList.forEach(function (warrior, idx) {
          const killsFormatted = formatKills(warrior.kills);
          const cardAria = t('warriors.cardAriaFormat')
            .replace('{index}', String(idx + 1))
            .replace('{count}', String(count))
            .replace('{username}', warrior.robloxUsername)
            .replace('{kills}', killsFormatted);
        %>
          <article
            class="zirve-card <%= idx === 0 ? 'is-front' : '' %>"
            style="--i:<%= idx %>"
            role="group"
            aria-label="<%= cardAria %>"
            tabindex="-1"
            data-warrior-index="<%= idx %>"
            data-rank="<%= idx + 1 %>"
            data-username="<%= warrior.robloxUsername %>"
            data-kills="<%= warrior.kills %>"
            data-profile-url="<%= warrior.robloxProfileUrl || '' %>"
          >
            <span class="zirve-badge">
              <% if (idx === 0) { %>
                <span class="zirve-badge-crown" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true">
                    <path d="M2 18h20v2H2v-2zm1-2 2-9 5 4 2-6 2 6 5-4 2 9H3z"/>
                  </svg>
                </span>
              <% } %>
              <span>#<%= idx + 1 %></span>
            </span>

            <div class="zirve-photo <%= warrior.avatarUrl ? 'is-loading' : '' %>">
              <% if (warrior.avatarUrl) { %>
                <img
                  src="<%= warrior.avatarUrl %>"
                  alt="<%= warrior.robloxUsername %>"
                  draggable="false"
                  class="zirve-avatar"
                  width="148"
                  height="148"
                  <% if (idx > 0) { %>loading="lazy"<% } %>
                  decoding="async"
                />
                <span class="warriors-silhouette" aria-hidden="true" hidden>
                  <svg viewBox="0 0 64 64" width="54" height="54" fill="currentColor" aria-hidden="true">
                    <circle cx="32" cy="22" r="12" />
                    <path d="M12 54c0-11 9-18 20-18s20 7 20 18H12z" />
                  </svg>
                </span>
              <% } else { %>
                <span class="warriors-silhouette" aria-hidden="true">
                  <svg viewBox="0 0 64 64" width="54" height="54" fill="currentColor" aria-hidden="true">
                    <circle cx="32" cy="22" r="12" />
                    <path d="M12 54c0-11 9-18 20-18s20 7 20 18H12z" />
                  </svg>
                </span>
              <% } %>
            </div>

            <div class="zirve-meta">
              <strong class="zirve-name"><%= warrior.robloxUsername %></strong>
              <span class="zirve-kills"><%= killsFormatted %> <%= t('warriors.killUnit') %></span>
            </div>

            <span class="zirve-dim" aria-hidden="true"></span>
          </article>
        <% }); %>
      </div>
    </div>

    <div id="warriorsCaption" class="zirve-caption" aria-live="polite">
      <strong id="warriorsActiveUsername" class="zirve-caption-name"><%= firstWarrior ? firstWarrior.robloxUsername : '' %></strong>
      <div class="zirve-caption-kills">
        <span id="warriorsActiveKills" class="zirve-caption-kills-num"><%= firstWarrior ? formatKills(firstWarrior.kills) : '0' %></span>
        <span class="zirve-caption-kills-unit"><%= t('warriors.killUnit') %></span>
      </div>
      <a
        id="warriorsProfileLink"
        class="zirve-profile-btn"
        href="<%= (firstWarrior && firstWarrior.robloxProfileUrl) ? firstWarrior.robloxProfileUrl : '#' %>"
        target="_blank"
        rel="noopener noreferrer"
        <% if (!firstWarrior || !firstWarrior.robloxProfileUrl) { %>hidden<% } %>
      >
        <span><%= t('warriors.robloxProfileBtn') %></span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div id="warriorsDotsContainer" class="zirve-dots" role="tablist" aria-label="<%= t('warriors.carouselAriaLabel') %>">
      <% warriorsList.forEach(function (warrior, idx) { %>
        <button
          type="button"
          class="zirve-dot <%= idx === 0 ? 'is-active' : '' %>"
          data-dot-index="<%= idx %>"
          aria-label="<%= `${idx + 1}. ${t('warriors.dotSelectLabel')}: ${warrior.robloxUsername}` %>"
          <% if (idx === 0) { %>aria-current="true"<% } %>
        ></button>
      <% }); %>
    </div>

    <p class="zirve-hint"><%= t('warriors.interactionHint') %></p>
  </div>
</section>
<% } %>
